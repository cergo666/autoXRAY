ips_count() { jq -r --arg n "$1" --argjson now "$(now)" '((.[$n] // {}) | [to_entries[] | select(.value.last >= ($now - 600))] | length)' "$IPS" 2>/dev/null || echo 0; }

# Логи Xray не должны расти и храниться: при отсутствии лимитов IP они очищаются, иначе ограничиваются по размеру.
trim_logs() {
  local f max=${AX_LOG_MAX:-20971520} limited=0
  jq -e --argjson now "$(now)" '(.debug.until // 0) > $now or (.torrent.alert == true) or any(.users[]; .enabled and (((.ip_limit // 0) > 0) or (.report == true)))' "$STATE" >/dev/null 2>&1 && limited=1
  for f in "$ACCESS_LOG" "$(dirname "$ACCESS_LOG")/error.log"; do
    [[ -f $f ]] || continue
    if [[ $limited == 0 ]] || [[ $(stat -c %s "$f") -gt $max ]]; then : >"$f"; fi
  done
}

# Из access.log вытаскивает пары «email ip» (без заблокированных соединений и без источников без email)
ipwatch_parse() {
  awk '/ accepted / && / email: / && !/ -> block/ {
    src = ""; for (i = 1; i <= NF; i++) if ($i == "from") { src = $(i + 1); break }
    email = $NF; if (src == "" || email == "") next
    sub(/^(tcp|udp):/, "", src); sub(/:[0-9]+$/, "", src); gsub(/[\[\]]/, "", src)
    print email, src }' | sort -u
}

# Доверенные адреса пользователя (ip_trust: список IP и сетей IPv4 вида 10.0.0.0/24) не считаются «лишними»:
# домашний IP или сеть мобильного оператора, которые не нужно ни занимать слотом, ни блокировать.
ip2int() { local a b c d; IFS=. read -r a b c d <<<"$1"; echo $(( (a << 24) + (b << 16) + (c << 8) + d )); }
valid_trust() { # IP или сеть: 1.2.3.4, 1.2.3.0/24, 2001:db8::1
  local v=$1 ip=${1%%/*} len=""
  [[ $v == */* ]] && len=${v#*/}
  if [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
    [[ ${BASH_REMATCH[1]} -le 255 && ${BASH_REMATCH[2]} -le 255 && ${BASH_REMATCH[3]} -le 255 && ${BASH_REMATCH[4]} -le 255 ]] || return 1
    [[ -z $len || ( $len =~ ^[0-9]+$ && $len -ge 8 && $len -le 32 ) ]]
  else [[ $ip =~ ^[0-9a-fA-F:]+$ && $ip == *:* && -z $len ]]; fi
}
ip_in() { # адрес список-доверенных(через пробел)
  local ip=$1 t net len m
  for t in $2; do
    if [[ $t == "$ip" ]]; then return 0; fi
    if [[ $t == */* && $ip != *:* ]]; then
      net=${t%/*}; len=${t#*/}; m=$(( (0xFFFFFFFF << (32 - len)) & 0xFFFFFFFF ))
      (( ($(ip2int "$ip") & m) == ($(ip2int "$net") & m) )) && return 0
    fi
  done
  return 1
}
ip_trusted_list() { jq -r --arg n "$1" '.users[] | select(.name == $n) | (.ip_trust // []) | join(" ")' "$STATE"; }

# Попытки торрента: сервер блокирует такие соединения отдельным выходом block-bt. Уведомление не чаще раза в час на пользователя.
# Видны только клиенты, чьё приложение шлёт торрент на сервер: наши подписки направляют его напрямую с устройства, мимо сервера.
torrent_check() { # файл журнала
  local f="$AX_ETC/.torrent-alerted" u n last t; t=$(now); touch "$f"
  while read -r n u; do
    [[ -n $u ]] || continue
    last=$(awk -v u="$u" '$1 == u {print $2}' "$f"); last=${last:-0}
    [[ $(( t - last )) -gt 3600 ]] || continue
    { grep -v "^$u " "$f"; echo "$u $t"; } >"$f.tmp"; mv "$f.tmp" "$f"
    bot_notify "🧲 <b>$u</b>: попытки торрента ($n соединений), трафик заблокирован"
    echo "🧲 $u: попытки торрента ($n соединений) заблокированы"
  done < <(awk '/ accepted / && /block-bt\]/ && / email: / {c[$NF]++} END {for (u in c) print c[u], u}' "$1")
}

cmd_torrent() {
