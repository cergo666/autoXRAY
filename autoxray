  cmd_user_list
  rule
  printf ' %bИтого%b   %b↑ %s%b   %b↓ %s%b\n' "$BOLD" "$NC" "$CYAN" "$(hbytes "$(jq '[.[].up] | add // 0' "$TRAFFIC")")" "$NC" \
