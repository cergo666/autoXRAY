| "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-ru.srs" as $geoip
| "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ru.srs" as $geosite
| {
    log: {level: "warn"},
    inbounds: [{type: "mixed", tag: "mixed-in", listen: "127.0.0.1", listen_port: 2080},
               {type: "tun", tag: "tun-in", address: ["172.19.0.1/30"], auto_route: true}],
    outbounds: (
      [$Q[] | if .kind == "vision" then
          {type: "vless", tag: .name, server: $S.domain, server_port: 443, uuid: .secret, flow: "xtls-rprx-vision",
           tls: {enabled: true, server_name: $S.domain, utls: {enabled: true, fingerprint: $S.fingerprint}}}
        else
          {type: "hysteria2", tag: .name, server: $S.domain, server_port: 443, password: .secret,
           tls: {enabled: true, server_name: $S.domain, alpn: ["h3"]}}
        end]
      + (if ($auto | length) > 0 then [{type: "urltest", tag: "🧭 Авто", outbounds: [$Q[].name], url: "https://www.gstatic.com/generate_204", interval: "3m"}] else [] end)
      + [{type: "selector", tag: "proxy", outbounds: ([$Q[].name] + $auto), default: $Q[0].name}, {type: "direct", tag: "direct"}]),
    route: {
      rules: ([{action: "sniff"}, {protocol: "dns", action: "hijack-dns"}, {ip_is_private: true, action: "route", outbound: "direct"}]
              + srules($R.block; {action: "reject"}) + srules($R.proxy; {action: "route", outbound: "proxy"}) + srules($R.direct; {action: "route", outbound: "direct"})
              + (if $rd then [{domain_suffix: ["ru", "su", "xn--p1ai"], action: "route", outbound: "direct"},
                              {rule_set: ["geoip-ru", "geosite-category-ru"], action: "route", outbound: "direct"}] else [] end)),
      rule_set: (if $rd then [{tag: "geoip-ru", type: "remote", format: "binary", url: $geoip, download_detour: "direct"},
                              {tag: "geosite-category-ru", type: "remote", format: "binary", url: $geosite, download_detour: "direct"}] else [] end),
      final: "proxy", auto_detect_interface: true
    }
  }
JQ
)

# Clash/Mihomo: JSON является подмножеством YAML, поэтому отдаётся он же (клиенты его принимают как .yaml)
sub_clash() { subjq "$1" "$SUB_CLASH_TAIL"; }
sub_sing()  { subjq "$1" "$SUB_SING_TAIL"; }

# Универсальная подписка: ссылки vless:// и hy2:// через перевод строки в base64 (v2rayNG, NekoBox, Streisand, Hiddify и др.)
sub_txt() {
  local txt; txt=$(sub_status_text "$1")
  {
    user_links "$1" | cut -d'|' -f2-
    [[ -n $txt ]] && printf 'vless://00000000-0000-4000-8000-000000000000@127.0.0.1:1?security=none&type=tcp#%s\n' "$(jq -rn --arg t "$txt" '$t | @uri')"
  } | base64 -w0; echo
}

sub_json() {
  local prog="$CLIENT_JQ"$'\n'"$CLIENT_DIRECT_TAIL"
  [[ $(mode) == bridge ]] && prog="$CLIENT_JQ"$'\n'"$CLIENT_BRIDGE_TAIL"
  subjq "$1" "$prog"
}

html_esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }

sub_html() {
  local name=$1 tpl="$TPL_DIR/sub.html" u domain token used limit expire status tg rows="" idx=1 label link
  [[ -f $tpl ]] || { warn "Нет шаблона $tpl — HTML-страница подписки пропущена."; return 1; }
  u=$(user_must "$name")
  domain=$(st .domain); token=$(jq -r .token <<<"$u")
  limit=$(jq -r .limit <<<"$u"); expire=$(jq -r .expire <<<"$u")
  used=$(jq -r --arg n "$name" '((.[$n].up // 0) + (.[$n].down // 0))' "$TRAFFIC")
  status=$(jq_state -r --arg n "$name" "$JQ_DEFS"'.users[] | select(.name == $n) | status(.)')
  tg=$(st '.telegram.link // ""')

  while IFS='|' read -r label link; do
    rows+="<div class=\"cfg\"><div class=\"cfg-head\"><span class=\"cfg-name\">$(html_esc <<<"$label")</span><span class=\"cfg-actions\"><button class=\"mini\" data-copy=\"c$idx\">Копировать</button><button class=\"mini\" data-qr=\"c$idx\">QR</button></span></div><code id=\"c$idx\">$(html_esc <<<"$link")</code></div>"$'\n'
    idx=$((idx + 1))
  done < <(user_links "$name")

  local tg_block=""
  if [[ -n $tg ]]; then
    tg_block="<section class=\"card\"><h2>Telegram</h2><p class=\"muted\">Web Proxy на этом же сервере — открывается одной кнопкой.</p><div class=\"row\"><a class=\"btn tg\" href=\"$(html_esc <<<"$tg")\">Добавить прокси в Telegram</a><button class=\"btn ghost\" data-copy-text=\"$(html_esc <<<"$tg")\">Копировать ссылку</button></div></section>"
  fi

  local sub_url="https://$domain/$token.json" out
  out=$(<"$tpl")
  out=${out//'{{NAME}}'/$(html_esc <<<"$name")}
  out=${out//'{{DOMAIN}}'/$(html_esc <<<"$domain")}
  out=${out//'{{SUB_URL}}'/$(html_esc <<<"$sub_url")}
  out=${out//'{{LINKS_URL}}'/$(html_esc <<<"https://$domain/$token.txt")}
  out=${out//'{{CLASH_URL}}'/$(html_esc <<<"https://$domain/$token.yaml")}
  out=${out//'{{SING_URL}}'/$(html_esc <<<"https://$domain/$token.sing")}
  out=${out//'{{USED}}'/$used}
  out=${out//'{{LIMIT}}'/$limit}
  out=${out//'{{EXPIRE}}'/$expire}
  out=${out//'{{STATUS}}'/$status}
  out=${out//'{{TG_BLOCK}}'/$tg_block}
  out=${out//'{{CONFIGS}}'/$rows}
  printf '%s\n' "$out"
}

# Файлы подписок + map для заголовка subscription-userinfo в nginx.
render_subs() {
  local web name token map_new changed=0 keep=" "
  web=$(st .web); mkdir -p "$web"
  map_new=$(mktemp)
  while IFS= read -r name; do
    token=$(user_get "$name" | jq -r .token)
    sub_json "$name" >"$web/$token.json" || warn "Не удалось собрать подписку для $name"
    sub_html "$name" >"$web/$token.html" 2>/dev/null || rm -f "$web/$token.html"
    sub_txt "$name" >"$web/$token.txt"
    sub_clash "$name" >"$web/$token.yaml" 2>/dev/null || { warn "Не удалось собрать Clash-подписку для $name"; rm -f "$web/$token.yaml"; }
    sub_sing "$name" >"$web/$token.sing" 2>/dev/null || { warn "Не удалось собрать sing-box-подписку для $name"; rm -f "$web/$token.sing"; }
    chmod 644 "$web/$token".{json,html,txt,yaml,sing} 2>/dev/null
    keep+="$token "
    jq -r --arg n "$name" --arg tok "$token" --slurpfile t "$TRAFFIC" '
      .users[] | select(.name == $n) as $u
      | (($t[0][$n].up // 0)) as $up | (($t[0][$n].down // 0)) as $dn
      | ("upload=\($up); download=\($dn)"
         + (if $u.limit > 0 then "; total=\($u.limit)" else "" end)
         + (if $u.expire > 0 then "; expire=\($u.expire)" else "" end)) as $info
      | ("json", "txt", "yaml", "sing") as $ext | "\"/\($tok).\($ext)\" \"\($info)\";"' "$STATE" >>"$map_new"
  done < <(jq -r '.users[].name' "$STATE")

  # удаляем файлы подписок отозванных пользователей
  local f base
  for f in "$web"/*.json "$web"/*.html "$web"/*.txt "$web"/*.yaml "$web"/*.sing; do
    [[ -e $f ]] || continue
    base=$(basename "$f"); base=${base%.*}
    [[ $base =~ ^[A-Za-z0-9]{20,32}$ ]] || continue
    [[ $keep == *" $base "* ]] || rm -f "$f"
  done

  if [[ ! -f $NGX_MAP ]] || ! cmp -s "$map_new" "$NGX_MAP"; then
    # Если изменились только счётчики трафика, nginx перечитывается не чаще раза в час: после каждого reload старые
    # процессы nginx живут, пока не закроются длинные соединения XHTTP, и частые reload копят их в памяти.
    # Лимиты, сроки, новые и удалённые пользователи применяются сразу.
    local strip='s/upload=[0-9]+; download=[0-9]+//'
    if [[ -f $NGX_MAP ]] && [[ $(sed -E "$strip" "$map_new") == "$(sed -E "$strip" "$NGX_MAP")" ]] \
       && (( $(now) - $(stat -c %Y "$NGX_MAP") < ${AX_USERINFO_EVERY:-3600} )); then :
    else mkdir -p "$(dirname "$NGX_MAP")"; cat "$map_new" >"$NGX_MAP"; changed=1; fi
  fi
  rm -f "$map_new"
  [[ $changed == 1 ]] && svc reload nginx 2>/dev/null
  return 0
}

NGX_CONF="${AX_NGINX_CONF:-/etc/nginx/conf.d/default.conf}"

FALLBACK_PROXY='    # web proxy Telegram (tproxy-server) + раздача статики сайта-маскировки
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }'
FALLBACK_STATIC='    location / {
        try_files $uri $uri/ =404;
    }'

# nginx.conf собирается из шаблона и state.json; при ошибке `nginx -t` прежний файл возвращается.
render_nginx() {
  local tpl="$TPL_DIR/nginx.conf" out fb new
  [[ -f $tpl ]] || { warn "Нет шаблона $tpl — nginx.conf не обновлён."; return 0; }
  [[ -f $NGX_MAP ]] || { mkdir -p "$(dirname "$NGX_MAP")"; : >"$NGX_MAP"; }
  fb=$FALLBACK_STATIC
  [[ $(st '.telegram.enabled // false') == true ]] && fb=$FALLBACK_PROXY
  out=$(<"$tpl")
  local rb=""
  if [[ -n $(report_users) && -n $(st '.reports.token // empty') ]]; then
    rb="    # отчёты о посещениях (секретный адрес; включаются у пользователей: autoxray user set <имя> --report on)
    location = /r/ {
        return 404;
    }
    location ^~ /r/ {
        alias $REPORT_WEB/;
        index index.html;
        add_header Cache-Control \"no-store\" always;
        add_header X-Robots-Tag \"noindex\" always;
    }"
  fi
  out=${out//'{{REPORTS}}'/$rb}
  out=${out//'{{FALLBACK}}'/$fb}
  out=${out//'{{NGX_MAP}}'/$NGX_MAP}
  out=${out//'{{DOMAIN}}'/$(st .domain)}
  out=${out//'{{WEB}}'/$(st .web)}
  out=${out//'{{XHTTP_PATH}}'/$(st .paths.xhttp)}
  out=${out//'{{AUTH_PATH}}'/$(st .paths.auth)}
  out=${out//'{{AUTH_CODE}}'/$(st '.auth.code // "ERR_AUTH_FAILED"')}
  out=${out//'{{AUTH_MSG}}'/$(st '.auth.msg // "Authentication failed."')}
  new=$(mktemp); printf '%s\n' "$out" >"$new"
  if [[ -f $NGX_CONF ]] && cmp -s "$new" "$NGX_CONF"; then rm -f "$new"; return 0; fi
  [[ -f $NGX_CONF ]] && cp -p "$NGX_CONF" "$NGX_CONF.bak"
  mkdir -p "$(dirname "$NGX_CONF")"; cat "$new" >"$NGX_CONF"; rm -f "$new"
  if command -v nginx >/dev/null 2>&1 && ! nginx -t >/tmp/autoxray-nginx.log 2>&1; then
    warn "nginx отклонил конфиг, возвращаю прежний. Лог: /tmp/autoxray-nginx.log"; tail -n 5 /tmp/autoxray-nginx.log >&2
    if [[ -f $NGX_CONF.bak ]]; then cp -p "$NGX_CONF.bak" "$NGX_CONF"; else rm -f "$NGX_CONF"; fi
    return 1
  fi
  svc reload nginx 2>/dev/null || svc restart nginx
}

render_all() { apply_xray; local rc=$?; render_subs; render_nginx || rc=1; return $rc; }
# Для команд, меняющих state: если конфиг не применился, не рапортуем об успехе.
apply_or_die() { render_all || die "Изменения сохранены в state.json, но не применены (причина выше). Исправьте её и выполните: autoxray render"; }

# ------------------------------------------------------------ пользователи

user_summary() {
  jq_state -r "$JQ_DEFS"'.users[] | [.name, status(.), (used(.)|tostring), (.limit|tostring), (.expire|tostring), ((.ip_limit // 0)|tostring), (.ru // "direct"), ((.report // false)|tostring)] | @tsv'
}

# user_filter <tag|find> <значение> — имена пользователей по метке или по тексту (в имени, заметке, метках), по одному в строке
user_filter() {
  jq -r --arg m "$1" --arg v "$2" 'def rx: gsub("(?<c>[\\^$.|?*+()\\[\\]{}])"; "\\" + .c);
    .users[] | select(
      if $m == "tag" then any((.tags // [])[]; test("^" + ($v | rx) + "$"; "i"))
      else ([.name, (.note // ""), ((.tags // []) | join(" "))] | join(" ") | test($v | rx; "i")) end) | .name' "$STATE"
}

cmd_user_list() {
  need_state
  local only=""
  if [[ ${1:-} == --plain ]]; then user_summary; return; fi
  case ${1:-} in
    --tag|--find) [[ -n ${2:-} ]] || die "user list ${1} <значение>"; only=" $(user_filter "${1#--}" "$2" | tr '\n' ' ')"
                  [[ $only != " " ]] || { echo -e " ${DIM}Никого не найдено.${NC}"; return 0; } ;;
  esac
  section "👥 Пользователи"
  printf '%b   %s %s %s %s %s %s %s%b\n' "$DIM" "$(pad ИМЯ 14)" "$(pad СТАТУС 12)" "$(pad РАСХОД 15)" "$(pad ТРАФИК 17)" "$(pad RU 7)" "$(pad IP 6)" ДЕЙСТВУЕТ "$NC"
  local name status used limit expire ipl ru icon col col2 label txt left exp rul ipt wru
  wru=$([[ $(st '.warp.enabled // false') == true && $(st '.warp.ru // false') == true ]] && echo 1 || echo 0)
  local meta
  while IFS=$'\t' read -r name status used limit expire ipl ru _rp; do
    [[ -z $only || $only == *" $name "* ]] || continue
    case $status in
      active)   icon="🟢"; col=$GRN;  label="активен" ;;
      disabled) icon="⚫"; col=$DIM;  label="отключён" ;;
      expired)  icon="⌛"; col=$YEL;  label="срок истёк" ;;
      limit)    icon="🚫"; col=$RED;  label="лимит" ;;
      *)        icon="❔"; col=$NC;   label=$status ;;
    esac
    txt="$(hbytes "$used")"; [[ $limit -gt 0 ]] && txt+=" / $(hbytes "$limit")"
    if [[ $expire -gt 0 ]]; then
      left=$(days_left "$expire"); col2=$GRN; [[ $left -le 7 ]] && col2=$YEL; [[ $left -le 3 ]] && col2=$RED
      exp="$(hdate "$expire") ${col2}($left дн.)${NC}"
    else exp="${DIM}бессрочно${NC}"; fi
    if [[ $ru == server ]]; then rul=$([[ $wru == 1 ]] && echo WARP || echo сервер); else rul=прямо; fi
    if [[ ${ipl:-0} -gt 0 ]]; then ipt="$(ips_count "$name")/$ipl"; else ipt="∞"; fi
    printf '%s %b%s%b %b%s%b %b %s %s %s %b\n' "$icon" "$BOLD" "$(pad "$name" 14)" "$NC" "$col" "$(pad "$label" 12)" "$NC" "$(bar "$used" "$limit" 10)" "$(pad "$txt" 17)" "$(pad "$rul" 7)" "$(pad "$ipt" 6)" "$exp"
    meta=$(jq -r --arg n "$name" '.users[] | select(.name == $n) | [((.tags // []) | map("#" + .) | join(" ")), (.note // ""), ((.hide // []) | if length > 0 then "скрыто: " + join(",") else "" end)] | map(select(length > 0)) | join(" · ")' "$STATE")
    [[ -z $meta ]] || echo -e "      ${DIM}$meta${NC}"
  done < <(user_summary)
}

cmd_user_add() {
  need_root; need_state
  local name=${1:-} limit=0 expire=0 reset=never ru=direct ips=0 rpt=false
  valid_name "$name" || die "Имя: 1-24 символа, только A-Z a-z 0-9 _ -"
  shift
  [[ -z $(user_get "$name") ]] || die "Пользователь '$name' уже существует."
  while (($#)); do
    case $1 in
      --limit) [[ $# -ge 2 ]] && is_num "$2" || die "--limit <ГБ>"; limit=$(awk -v g="$2" 'BEGIN{printf "%d", g*1073741824}'); shift 2 ;;
      --days)  [[ $# -ge 2 ]] && is_num "$2" || die "--days <N> (0 — бессрочно)"; expire=$(awk -v n="$2" -v t="$(now)" 'BEGIN{printf "%d", (n>0) ? t+n*86400 : 0}'); shift 2 ;;
      --reset) [[ ${2:-} =~ ^(monthly|weekly|never)$ ]] || die "--reset monthly|weekly|never"; reset=$2; shift 2 ;;
      --ru)    [[ ${2:-} =~ ^(direct|server)$ ]] || die "--ru direct|server"; ru=$2; shift 2 ;;
      --ips)   [[ ${2:-} =~ ^[0-9]+$ ]] || die "--ips <число IP> (0 без лимита)"; ips=$2; shift 2 ;;
      --report) [[ ${2:-} =~ ^(on|off)$ ]] || die "--report on|off"; [[ $2 == on ]] && rpt=true || rpt=false; shift 2 ;;
      *) die "Неизвестный параметр: $1" ;;
    esac
  done
  [[ $rpt == true ]] && report_ensure_token
  st_edit --arg n "$name" --arg ru "$ru" --argjson ips "$ips" --argjson rpt "$rpt" --arg id "$(user_uuid "$(mode)")" --arg h "$(rand 'a-f0-9' 16)" --arg t "$(rand 'A-Za-z0-9' 24)" \
          --argjson l "$limit" --argjson e "$expire" --argjson c "$(now)" --arg rs "$reset" --argjson nr "$(next_reset_ts "$reset")" \
    '.users += [{name: $n, uuid: $id, hy2: $h, token: $t, created: $c, first_seen: 0, expire: $e, limit: $l, enabled: true, reset: $rs, next_reset: $nr, ru: $ru, ip_limit: $ips, report: $rpt}]'
  apply_or_die
  ok "✅ Пользователь '$name' создан."
  if [[ $rpt == true ]]; then report_build "$name"; report_build_index; echo -e " 📈 ${DIM}Отчёт:${NC} ${CYAN}$(report_url "$name")${NC}"; fi
  show_user "$name"
}

cmd_user_del() {
  need_root; need_state
  local name=${1:-}; user_must "$name" >/dev/null
  [[ $(jq '.users | length' "$STATE") -gt 1 ]] || warn "Это последний пользователь — доступ к серверу будет закрыт."
  report_remove "$name" purge                                  # до удаления из state: нужен токен страницы
  st_edit --arg n "$name" '.users |= map(select(.name != $n))'
  jq --arg n "$name" 'del(.[$n])' "$TRAFFIC" >"$TRAFFIC.tmp" && mv "$TRAFFIC.tmp" "$TRAFFIC"
  # известные IP и блокировки удалённого: иначе их унаследовал бы новый пользователь с тем же именем
  [[ -f $IPS ]] && jq --arg n "$name" 'del(.[$n])' "$IPS" >"$IPS.tmp" && mv "$IPS.tmp" "$IPS"
  [[ -f $BANS ]] && jq --arg n "$name" 'map(select(.user != $n))' "$BANS" >"$BANS.tmp" && mv "$BANS.tmp" "$BANS"
  apply_or_die
  ok "✅ Пользователь '$name' удалён (ключи и ссылки подписки больше не работают)."
}

cmd_user_set() {
  need_root; need_state
  local name=${1:-} report_after=""; user_must "$name" >/dev/null; shift
  (($#)) || die "Укажите параметры: --report on|off | --limit ГБ | --days N | --ips N | --trust IP|сеть | --untrust IP|all | --ru direct|server | --reset monthly|weekly|never | --hide hy2|xhttp|vision | --show протокол|all | --note текст | --tags a,b | --enable | --disable | --reset-traffic"
  while (($#)); do
    case $1 in
      --limit)  [[ $# -ge 2 ]] && is_num "$2" || die "--limit <ГБ> (0 — без лимита)"
                st_edit --arg n "$name" --argjson l "$(awk -v g="$2" 'BEGIN{printf "%d", g*1073741824}')" '(.users[] | select(.name == $n) | .limit) = $l'; shift 2 ;;
      --days)   [[ $# -ge 2 ]] && is_num "$2" || die "--days <N> (0 — бессрочно)"
                st_edit --arg n "$name" --argjson e "$(awk -v n="$2" -v t="$(now)" 'BEGIN{printf "%d", (n>0) ? t+n*86400 : 0}')" '(.users[] | select(.name == $n) | .expire) = $e'; shift 2 ;;
      --reset)  [[ ${2:-} =~ ^(monthly|weekly|never)$ ]] || die "--reset monthly|weekly|never"
                st_edit --arg n "$name" --arg r "$2" --argjson nr "$(next_reset_ts "$2")" '(.users[] | select(.name == $n)) |= (.reset = $r | .next_reset = $nr)'; shift 2 ;;
      --ips)    [[ ${2:-} =~ ^[0-9]+$ ]] || die "--ips <число IP> (0 без лимита)"
                st_edit --arg n "$name" --argjson v "$2" '(.users[] | select(.name == $n) | .ip_limit) = $v'
                [[ $2 -gt 0 ]] || { jq --arg n "$name" 'del(.[$n])' "$IPS" >"$IPS.tmp" 2>/dev/null && mv "$IPS.tmp" "$IPS"; }; shift 2 ;;
      --ru)     [[ ${2:-} =~ ^(direct|server)$ ]] || die "--ru direct|server"
                st_edit --arg n "$name" --arg v "$2" '(.users[] | select(.name == $n) | .ru) = $v'; shift 2 ;;
      --hide)   [[ ${2:-} =~ ^(xhttp|vision|hy2)$ ]] || die "--hide xhttp|vision|hy2 (протокол пропадёт из подписок этого пользователя, на сервере он остаётся)"
                local left; left=$(jq -r --arg n "$name" --arg k "$2" --arg m "$(mode)" '.users[] | select(.name == $n) | ((.hide // []) + [$k] | unique) as $h | (if $m == "bridge" then ["xhttp","vision"] else ["xhttp","vision","hy2"] end) - $h | length' "$STATE")
                [[ $left -ge 1 ]] || die "Нельзя скрыть все протоколы: у пользователя не останется ни одного профиля."
                st_edit --arg n "$name" --arg k "$2" '(.users[] | select(.name == $n) | .hide) = ((((.users[] | select(.name == $n) | .hide) // []) + [$k]) | unique)'; shift 2 ;;
      --show)   [[ ${2:-} =~ ^(xhttp|vision|hy2|all)$ ]] || die "--show xhttp|vision|hy2|all"
                if [[ $2 == all ]]; then st_edit --arg n "$name" '(.users[] | select(.name == $n) | .hide) = []'
                else st_edit --arg n "$name" --arg k "$2" '(.users[] | select(.name == $n) | .hide) = (((.users[] | select(.name == $n) | .hide) // []) - [$k])'; fi; shift 2 ;;
      --note)   [[ $# -ge 2 ]] || die "--note <текст> (пустой убирает)"
                local nt; nt=$(printf '%s' "$2" | tr -d '[:cntrl:]' | sed 's/^ *//; s/ *$//' | cut -c1-120)
                st_edit --arg n "$name" --arg v "$nt" '(.users[] | select(.name == $n) | .note) = $v'; shift 2 ;;
      --tags)   [[ $# -ge 2 ]] || die "--tags метка1,метка2 (пустое значение убирает)"
                [[ $2 =~ ^[^[:cntrl:]\|\<\>\"\']*$ ]] || die "В метках нельзя управляющие символы и | < > кавычки."
                st_edit --arg n "$name" --arg v "$2" '(.users[] | select(.name == $n) | .tags) = ($v | split(",") | map(gsub("^ +| +$"; "") | .[0:24]) | map(select(length > 0)) | unique | .[0:8])'; shift 2 ;;
      --trust)  valid_trust "${2:-}" || die "--trust <IP или сеть IPv4: 1.2.3.4, 1.2.3.0/24>"
                st_edit --arg n "$name" --arg v "$2" '(.users[] | select(.name == $n) | .ip_trust) = ((((.users[] | select(.name == $n) | .ip_trust) // []) + [$v]) | unique)'; shift 2 ;;
      --untrust) [[ -n ${2:-} ]] || die "--untrust <IP, сеть или all>"
                if [[ $2 == all ]]; then st_edit --arg n "$name" '(.users[] | select(.name == $n) | .ip_trust) = []'
                else st_edit --arg n "$name" --arg v "$2" '(.users[] | select(.name == $n) | .ip_trust) = (((.users[] | select(.name == $n) | .ip_trust) // []) - [$v])'; fi; shift 2 ;;
      --report) [[ ${2:-} =~ ^(on|off)$ ]] || die "--report on|off"
                if [[ $2 == on ]]; then
                  report_ensure_token
                  warn "Будут записываться сайты и IP-адреса, на которые заходит '$name'. Предупредите пользователя."
                  st_edit --arg n "$name" '(.users[] | select(.name == $n) | .report) = true'; report_after=on
                else st_edit --arg n "$name" '(.users[] | select(.name == $n) | .report) = false'; report_remove "$name"; report_after=off; fi
                shift 2 ;;
      --enable)  st_edit --arg n "$name" '(.users[] | select(.name == $n) | .enabled) = true'; shift ;;
      --disable) st_edit --arg n "$name" '(.users[] | select(.name == $n) | .enabled) = false'; shift ;;
      --reset-traffic) jq --arg n "$name" 'del(.[$n])' "$TRAFFIC" >"$TRAFFIC.tmp" && mv "$TRAFFIC.tmp" "$TRAFFIC"; shift ;;
      *) die "Неизвестный параметр: $1" ;;
    esac
  done
  apply_or_die
  if [[ $report_after == on ]]; then report_build "$name"; report_build_index; echo -e " 📈 ${DIM}Отчёт:${NC} ${CYAN}$(report_url "$name")${NC}"
  elif [[ $report_after == off ]]; then report_build_index; echo -e " 📈 ${DIM}Отчёт выключен, страница удалена. Накопленные данные хранятся до истечения срока, удалить сразу: autoxray report purge $name${NC}"; fi
  ok "✅ Параметры '$name' обновлены."
}

# Приглашение: одноразовая ссылка t.me/<бот>?start=<код> на 7 дней. Клиент открывает её и привязывает свой Telegram к пользователю:
# после этого он сам видит в боте трафик, срок и ссылки (и получает уведомления о лимите).
bot_username() {
  local u; u=$(st '.bot.username // empty')
  if [[ -z $u ]] && [[ -s $BOT_TOKEN_FILE ]]; then
    u=$(tg_call getMe '{}' 15 2>/dev/null | jq -r '.result.username // empty')
    [[ -n $u ]] && st_edit --arg u "$u" '.bot.username = $u'
  fi
  printf '%s' "$u"
}

