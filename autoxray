# Общие определения для всех форматов подписок (Xray JSON, Clash, sing-box, ссылки).
# hidden/visible: профили, которые администратор скрыл у пользователя (user set --hide hy2|xhttp|vision).
# rt: свои правила маршрутов (autoxray route add direct|proxy|block ...) и готовые наборы (route preset).
# statustext: строка «осталось ... до ...» для необязательного профиля-статуса (autoxray sub statusnode on).
SUB_COMMON_JQ=$(cat <<'JQ'
def hidden($u; $k): (($u.hide // []) | index($k)) != null;
def visible($u; $k): hidden($u; $k) | not;
def is_cidr: test("^[0-9]{1,3}(\\.[0-9]{1,3}){3}(/[0-9]{1,2})?$");
def push_domains: ["mtalk.google.com", "push.apple.com", "courier.push.apple.com", "push-apple.com.akadns.net"];
def rt($S; $k): (($S.routes // {})[$k] // []) + (if $k == "direct" and ((($S.routes // {}).presets // []) | index("push")) != null then push_domains else [] end) | unique;
def routes($S): {direct: rt($S; "direct"), proxy: rt($S; "proxy"), block: rt($S; "block")};
def used($u): (($t[0][$u.name].up // 0) + ($t[0][$u.name].down // 0));
def gb($b): ((($b * 10 / 1073741824) | round) / 10 | tostring) + " ГБ";
def statustext($u): "ℹ️ " + (if $u.limit > 0 then "Осталось " + gb([$u.limit - used($u), 0] | max) + " из " + gb($u.limit) else "Без лимита" end)
  + (if $u.expire > 0 then " · до " + ($u.expire | strftime("%d.%m.%Y")) else " · бессрочно" end);
def ru_direct($S; $u):
  $S.mode == "bridge" or (($u.ru // (if ($S.warp.enabled == true and $S.warp.registered == true and $S.warp.ru == true) then "server" else "direct" end)) == "direct");
# Профили для Clash/sing-box и «Авто»: {name, kind: xhttp|vision|hy2, secret}. В режиме моста UUID содержит номер маршрута.
def profiles($S; $u):
  (if $S.mode == "bridge" then
    ((if ($S.nodes | length) > 1 then [{name: "🇷🇺 RU>EU Автобалансир", kind: "xhttp", secret: route_uuid($u.uuid; 0)}] else [] end)
     + [$S.nodes[] as $x
        | {name: "🇷🇺 RU>EU xhttp | \($x.name)", kind: "xhttp", secret: route_uuid($u.uuid; $x.id)},
          {name: "🇷🇺 RU>EU raw | \($x.name)", kind: "vision", secret: route_uuid($u.uuid; $x.id)}])
  else
    [{name: "🇪🇺 VLESS XHTTP", kind: "xhttp", secret: $u.uuid},
     {name: "🇪🇺 VLESS Vision", kind: "vision", secret: $u.uuid},
     {name: "🇪🇺 Hysteria2", kind: "hy2", secret: $u.hy2}]
  end) | map(select(visible($u; .kind)));
JQ
)

# подписки строятся одним вызовом jq с общими аргументами: subjq <имя> <программа> [параметры jq]
subjq() {
  local name=$1 prog=$2; shift 2
  jq "$@" --arg n "$name" --arg ex "$EXTRA" --slurpfile t "$TRAFFIC" --argjson now "$(now)" "$BRIDGE_COMMON"$'\n'"$SUB_COMMON_JQ"$'\n'"$prog" "$STATE"
}

