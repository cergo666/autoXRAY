def col: ({"direct": "var(--accent)", "warp": "var(--accent2)", "block": "var(--bad)"})[.] // "var(--warn)";
def oname: ({"direct": "напрямую с сервера", "warp": "через WARP", "block": "заблокировано"})[.] // (. | esc);

sort_by(.date) as $ALL
| ($ALL | .[-7:]) as $D
| ($D | map(.total // 0) | add // 0) as $total
| ($D | map(.blocked // 0) | add // 0) as $blocked
| ($D | sum("hosts")) as $hosts | ($D | sum("ports")) as $ports | ($D | sum("out")) as $out
| ($D | reduce .[] as $d ([range(24) | 0]; reduce range(24) as $h (.; .[$h] += (($d.hours // [])[$h] // 0)))) as $hours
| ($D | reduce .[] as $d ({}; reduce (($d.src // {}) | to_entries[]) as $e (.;
    .[$e.key] |= ((. // {n: 0, first: $e.value.first, last: $e.value.last, hosts: {}})
      | .n += ($e.value.n // 0) | .first = ([.first, $e.value.first] | min) | .last = ([.last, $e.value.last] | max)
      | .hosts = (reduce (($e.value.hosts // {}) | to_entries[]) as $x (.hosts; .[$x.key] = ((.[$x.key] // 0) + $x.value))))))) as $src
| ([($hours | max), 1] | max) as $mx
| ($out | to_entries | map(.value) | add // 0) as $tot
| ([($ALL | map(.total // 0) | max), 1] | max) as $dm
| {
    kpi: ([["Подключений", $total], ["Адресов назначения", ($hosts | length)], ["IP клиента", ($src | length)], ["Заблокировано", $blocked]]
          | map("<div class=\"kpi\"><b>\(.[1])</b><span>\(.[0])</span></div>") | join("")),
    hours: ($hours | to_entries | map("<i title=\"\(.key):00, \(.value)\" style=\"height:\([2, (.value * 100 / $mx)] | max)%\"></i>") | join("")),
    axis: ($hours | to_entries | map("<span>\(if .key % 3 == 0 then .key else "" end)</span>") | join("")),
    hosts: rows(topn($hosts; 20); $total; namehtml($info)),
    srcs: ($src | to_entries | sort_by(-.value.n) | .[:12]
           | map("<details><summary><span>📱 \(.key | esc)" + (.key | small($info)) + "</span><span class=\"muted\">\(.value.n) · \(pct(.value.n; $total))%</span></summary><div class=\"sub\"><div><span>Активность</span><span>\(.value.first // "" | tostring | esc) – \(.value.last // "" | tostring | esc)</span></div>"
                 + (topn(.value.hosts; 8) | map("<div><span>\(.key | esc)</span><span>\(.value)</span></div>") | join("")) + "</div></details>")
           | join("") | if . == "" then "<div class=\"empty\">Нет данных</div>" else . end),
    ports: rows(topn($ports; 8); $total; esc),
    stack: ($out | to_entries | map("<i style=\"width:\(if $tot > 0 then .value * 100 / $tot else 0 end)%;background:\(.key | col)\"></i>") | join("")),
    legend: ($out | to_entries | map("<span><b style=\"background:\(.key | col)\"></b>\(.key | oname): \(.value)</span>") | join("") | if . == "" then "<span>Нет данных</span>" else . end),
    days: ($ALL | map("<i data-d=\"\(.date)\" title=\"\(.date): \(.total // 0)\" style=\"height:\([3, ((.total // 0) * 100 / $dm)] | max)%\"></i>") | join("")),
    rank: ($ALL | sort_by(-(.total // 0)) | map("<tr class=\"dayrow\" data-d=\"\(.date)\"><td>\(.date)</td><td>\(.total // 0)</td><td>\((.hosts // {}) | length)</td><td>\((.src // {}) | length)</td></tr>") | join("")
           | if . == "" then "<tr><td colspan=\"4\" class=\"empty\">Данных пока нет: отчёт наполняется по мере использования</td></tr>" else . end),
