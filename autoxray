# Раз в минуту из cron. Для пользователей с лимитом IP: первые N адресов считаются «своими» (пока их видно,
# слот занят; через 10 минут без активности слот освобождается), следующие блокируются на 30 минут.
# Лог доступа читается и сразу обнуляется: он живёт не дольше минуты.
cmd_ipwatch() {
  need_state
  debug_expire
  trim_logs
  local ipl=0 rep=0 ta=0
  jq -e '[.users[] | select(.enabled and ((.ip_limit // 0) > 0))] | length > 0' "$STATE" >/dev/null && ipl=1
  [[ -n $(report_users) ]] && rep=1
  [[ $(st '.torrent.alert // false') == true ]] && ta=1
  [[ $ipl == 1 || $rep == 1 || $ta == 1 ]] || return 0
  [[ -f $ACCESS_LOG ]] || return 0
  local tmp seen new old_act new_act t
  t=$(now)
  tmp=$(mktemp); cp "$ACCESS_LOG" "$tmp"; : >"$ACCESS_LOG"
  [[ $rep == 1 ]] && report_ingest "$tmp"
  [[ $ta == 1 ]] && torrent_check "$tmp"
  if [[ $ipl == 1 ]]; then
    local pairs u ip
    pairs=$(ipwatch_parse <"$tmp")
    # пары с доверенными адресами исключаются целиком: они не занимают слот и не блокируются
    if jq -e 'any(.users[]; (.ip_trust // []) | length > 0)' "$STATE" >/dev/null 2>&1; then
      declare -A TR=()
      while read -r u ip; do
        [[ -n $u ]] || continue
        [[ -v TR[$u] ]] || TR[$u]=$(ip_trusted_list "$u")
        ip_in "$ip" "${TR[$u]}" || printf '%s %s\n' "$u" "$ip"
      done <<<"$pairs" >"$tmp.f"
      pairs=$(<"$tmp.f"); rm -f "$tmp.f"
    fi
    seen=$(printf '%s\n' "$pairs" | jq -Rn '[inputs | split(" ") | select(length == 2)]')
    [[ -f $IPS ]] || echo '{}' >"$IPS"; [[ -f $BANS ]] || echo '[]' >"$BANS"
    new=$(jq -n --argjson seen "$seen" --slurpfile st "$STATE" --slurpfile ips "$IPS" --slurpfile bans "$BANS" --argjson now "$t" '
      ($st[0].users | map(select(.enabled and ((.ip_limit // 0) > 0)) | {key: .name, value: .ip_limit}) | from_entries) as $lim
      | ($ips[0] // {} | with_entries(select($lim[.key] != null) | .value |= with_entries(select(.value.last >= ($now - 600))))) as $known
      | reduce ($seen[] | select($lim[.[0]] != null)) as [$u, $ip]
          ({ips: $known, bans: ($bans[0] // [] | map(select(.until > $now)))};
           if .ips[$u][$ip] != null then .ips[$u][$ip].last = $now
           elif ([.bans[] | select(.user == $u and .ip == $ip)] | length) > 0 then .
           elif ((.ips[$u] // {}) | length) < $lim[$u] then .ips[$u][$ip] = {first: $now, last: $now}
           else .bans += [{user: $u, ip: $ip, until: ($now + 1800)}] end)')
    old_act=$(jq -c --argjson now "$t" '[.[] | select(.until > $now) | {user, ip}] | sort' "$BANS")
    new_act=$(jq -c '[.bans[] | {user, ip}] | sort' <<<"$new")
    jq '.ips' <<<"$new" >"$IPS.tmp" && mv "$IPS.tmp" "$IPS"
    if [[ $old_act != "$new_act" ]]; then
      jq '.bans' <<<"$new" >"$BANS.tmp" && mv "$BANS.tmp" "$BANS"
      local msg
      msg=$(jq -r --argjson old "$old_act" '.bans[] | select(. as $b | ($old | index({user: $b.user, ip: $b.ip})) == null) | "🚫 \(.user): лишний IP \(.ip) заблокирован на 30 минут"' <<<"$new")
      [[ -n $msg ]] && { echo "$msg"; bot_notify "$msg"; }
      apply_xray
    fi
  fi
  rm -f "$tmp"
}

cmd_ips() {
  need_state
  local filter=${1:-} u lim ip last until_ n=0
  section "📱 Устройства (IP)"
  while IFS=$'\t' read -r u lim; do
    [[ -n $filter && $filter != "$u" ]] && continue
    n=$((n + 1))
    echo -e "\n ${BOLD}$u${NC}  ${DIM}лимит: $lim, сейчас: $(ips_count "$u")${NC}"
    local tl; tl=$(ip_trusted_list "$u"); [[ -n $tl ]] && echo -e "    ${CYAN}🛡${NC} ${DIM}доверенные, не считаются: $tl${NC}"
    while IFS=$'\t' read -r ip last; do
      echo -e "    ${GRN}●${NC} $ip ${DIM}(последняя активность $(( ($(now) - last) / 60 )) мин назад)${NC}"
    done < <(jq -r --arg n "$u" --argjson now "$(now)" '(.[$n] // {}) | to_entries[] | select(.value.last >= ($now - 600)) | [.key, .value.last] | @tsv' "$IPS" 2>/dev/null)
    while IFS=$'\t' read -r ip until_; do
      echo -e "    ${RED}🚫${NC} $ip ${DIM}заблокирован ещё $(( (until_ - $(now)) / 60 )) мин${NC}"
    done < <(jq -r --arg n "$u" --argjson now "$(now)" '.[] | select(.user == $n and .until > $now) | [.ip, .until] | @tsv' "$BANS" 2>/dev/null)
  done < <(jq -r '.users[] | select((.ip_limit // 0) > 0) | [.name, (.ip_limit | tostring)] | @tsv' "$STATE")
  [[ $n -gt 0 ]] || echo -e " ${DIM}Лимиты IP не заданы. Включить: autoxray user set <имя> --ips 3${NC}"
}

cmd_unban() {
  need_root; need_state
  local who=${1:-}; [[ -n $who ]] || die "unban <имя|--all>"
  if [[ $who == --all ]]; then echo '[]' >"$BANS"; echo '{}' >"$IPS"
  else
    user_must "$who" >/dev/null
    jq --arg n "$who" 'map(select(.user != $n))' "$BANS" >"$BANS.tmp" && mv "$BANS.tmp" "$BANS"
    jq --arg n "$who" 'del(.[$n])' "$IPS" >"$IPS.tmp" && mv "$IPS.tmp" "$IPS"
  fi
  apply_or_die; ok "✅ Блокировки сняты."
}

# Расписание: учёт трафика, лимиты IP, гео-данные
cmd_setup_cron() {
  need_root; mkdir -p /etc/cron.d
  cat >/etc/cron.d/autoxray <<'EOF'
# учёт трафика, лимиты и сроки пользователей autoXRAY
*/5 * * * * root /usr/local/bin/autoxray collect >/dev/null 2>&1
# лимит IP: разбор лога доступа (работает, только если у кого-то задан лимит)
* * * * * root /usr/local/bin/autoxray ipwatch >/dev/null 2>&1
# прогрев туннеля WARP: без трафика сессия WireGuard устаревает, и первый запрос ждёт рукопожатия
* * * * * root /usr/local/bin/autoxray warp warm >/dev/null 2>&1
# ночная проверка endpoint'ов WARP (если включена: autoxray warp nightly on)
23 4 * * * root /usr/local/bin/autoxray warp rescan >/dev/null 2>&1
# обновление гео-данных (маршрутизация), по понедельникам
17 4 * * 1 root /usr/local/bin/autoxray geo-update --quiet >/dev/null 2>&1
EOF
  chmod 644 /etc/cron.d/autoxray
}

# ------------------------------------------------------- отчёты о посещениях

REPORT_DATA="$AX_ETC/reports"                                  # суточные агрегаты по пользователям (закрыто, 700)
REPORT_WEB="${AX_REPORT_WEB:-/var/lib/autoxray/reports}"       # готовый html, отдаётся nginx по секретному адресу

report_users() { jq -r '.users[] | select(.enabled and (.report == true)) | .name' "$STATE"; }

# Из access.log: «email дата час src хост порт выход число первое_время последнее_время».
# Хосты и адреса чистятся от всего, кроме допустимых символов: имя назначения задаёт клиент, в отчёт оно попадать должно безопасным.
report_parse() {
  awk '/ accepted / && / email: / {
    date = $1; time = $2; hour = substr(time, 1, 2); src = ""; dest = ""
    for (i = 1; i <= NF; i++) { if ($i == "from") src = $(i + 1); if ($i == "accepted") dest = $(i + 1) }
    email = $NF; if (src == "" || dest == "" || email == "") next
    sub(/^(tcp|udp):/, "", src); sub(/:[0-9]+$/, "", src); gsub(/[^A-Za-z0-9.:_-]/, "", src)
    sub(/^(tcp|udp):/, "", dest); port = dest; sub(/^.*:/, "", port); host = dest; sub(/:[0-9]+$/, "", host)
    host = tolower(host); gsub(/[^a-z0-9.:_-]/, "", host); gsub(/[^0-9]/, "", port)
    if (host == "" || src == "") next
    out = "direct"
    if (match($0, /\[[^\]]+\]/)) { br = substr($0, RSTART + 1, RLENGTH - 2); n = split(br, a, " "); out = a[n]; gsub(/[^a-z0-9_-]/, "", out) }
    key = email "\t" date "\t" hour "\t" src "\t" host "\t" port "\t" out
    cnt[key]++; if (!(key in t0) || time < t0[key]) t0[key] = time; if (time > t1[key]) t1[key] = time
  } END { for (k in cnt) print k "\t" cnt[k] "\t" t0[k] "\t" t1[k] }'
}

REPORT_MERGE_JQ='
  [inputs | split("\t")] as $rows
  | $old[0]
  | (.date //= ($rows[0][1] | gsub("/"; "-"))) | (.hours //= [range(24) | 0])
  | reduce $rows[] as $r (.;
      ($r[7] | tonumber) as $c | $r[3] as $src | $r[4] as $host
      | .total += $c | .hours[($r[2] | tonumber)] += $c
      | (if $r[6] == "block" then .blocked += $c else . end)
      | .hosts[$host] += $c | .ports[$r[5]] += $c | .out[$r[6]] += $c
      | .src[$src].n += $c
      | .src[$src].first = ([(.src[$src].first // $r[8]), $r[8]] | min)
      | .src[$src].last = ([(.src[$src].last // $r[9]), $r[9]] | max)
      | .src[$src].hosts[$host] += $c)
  | (if (.hosts | length) > 4000 then .hosts |= (to_entries | sort_by(-.value) | .[:3000] | from_entries) else . end)
  | .src |= with_entries(.value.hosts |= (if length > 300 then (to_entries | sort_by(-.value) | .[:200] | from_entries) else . end))'

# report_ingest <файл журнала> — добавляет разобранные записи в суточные файлы пользователей с включённым отчётом
report_ingest() {
  local rows u d f
  rows=$(report_parse <"$1"); [[ -n $rows ]] || return 0
  while read -r u; do
    [[ -n $u ]] || continue
    mkdir -p "$REPORT_DATA/$u"; chmod 700 "$REPORT_DATA" "$REPORT_DATA/$u"
    while read -r d; do
      [[ -n $d ]] || continue
      f="$REPORT_DATA/$u/${d//\//-}.json"; [[ -f $f ]] || echo '{}' >"$f"
      awk -F'\t' -v u="$u" -v d="$d" '$1 == u && $2 == d' <<<"$rows" | jq -Rn --slurpfile old "$f" "$REPORT_MERGE_JQ" >"$f.tmp" && mv "$f.tmp" "$f"
    done < <(awk -F'\t' -v u="$u" '$1 == u {print $2}' <<<"$rows" | sort -u)
  done < <(report_users)
}

report_keep_days() { st '.reports.keep_days // 30'; }

report_prune() {
  local cutoff f d; cutoff=$(date -d "-$(report_keep_days) days" +%F)
  for f in "$REPORT_DATA"/*/*.json; do
    [[ -e $f ]] || continue
    d=$(basename "$f" .json); [[ $d < $cutoff ]] && rm -f "$f"
  done
  return 0
}

# У каждого пользователя своя секретная ссылка на отчёт (/r/<токен пользователя>/), у администратора своя на список
# (/r/<общий токен>/). Ссылку пользователя можно отдать ему самому: по ней не видно ни список, ни чужие отчёты.
report_user_token() { # имя -> токен страницы отчёта (создаётся при первом обращении)
  local t; t=$(jq -r --arg n "$1" '.users[] | select(.name == $n) | .report_token // empty' "$STATE")
  if [[ -z $t ]]; then t=$(rand 'A-Za-z0-9' 32); st_edit --arg n "$1" --arg t "$t" '(.users[] | select(.name == $n) | .report_token) = $t'; fi
  echo "$t"
}

# Удаляет страницу отчёта пользователя (и, если purge, накопленные данные)
report_remove() { # имя [purge]
  local u=${1:?} t
  t=$(jq -r --arg n "$u" '.users[] | select(.name == $n) | .report_token // empty' "$STATE" 2>/dev/null)
  [[ -n $t ]] && rm -rf "${REPORT_WEB:?}/${t:?}"
  rm -rf "${REPORT_WEB:?}/${u:?}"                     # папка по имени: так страницы лежали до 3.10
  [[ ${2:-} == purge ]] && rm -rf "${REPORT_DATA:?}/${u:?}"
  return 0
}

# ---- сведения об адресах: страна, AS, обратный DNS (кэш в /etc/autoxray/ipinfo.json)
IPINFO="$AX_ETC/ipinfo.json"
priv_ip() { [[ $1 =~ ^(10\.|127\.|192\.168\.|169\.254\.|0\.|172\.(1[6-9]|2[0-9]|3[01])\.) || $1 == ::1 || $1 == [fF][eE]80:* || $1 == [fF][cCdD]* ]]; }

# ipinfo_fetch <ip> -> «страна<TAB>asn<TAB>имя AS<TAB>обратная запись». Страна и AS: DNS-сервис Team Cymru (только IPv4),
# обратная запись: PTR. Запросы идут с сервера обычным DNS.
ipinfo_fetch() {
  local ip=$1 rev r asn="" cc="" asname="" ptr=""
  if [[ -n ${AX_IPINFO_FAKE:-} ]]; then   # подмена для тестов: файл «ip<TAB>страна<TAB>asn<TAB>имя<TAB>ptr»
    awk -F'\t' -v i="$ip" '$1 == i {print $2 "\t" $3 "\t" $4 "\t" $5; f = 1} END {if (!f) print "\t\t\t"}' "$AX_IPINFO_FAKE"; return 0
  fi
  command -v dig >/dev/null 2>&1 || { printf '\t\t\t\n'; return 0; }
  if [[ $ip =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    rev="${BASH_REMATCH[4]}.${BASH_REMATCH[3]}.${BASH_REMATCH[2]}.${BASH_REMATCH[1]}"
    r=$(dig +short +time=2 +tries=1 TXT "$rev.origin.asn.cymru.com" 2>/dev/null | head -n1 | tr -d '"')
    asn=$(awk -F'|' '{split($1, a, " "); print a[1]}' <<<"$r")
    cc=$(awk -F'|' '{gsub(/ /, "", $3); print $3}' <<<"$r")
    if [[ $asn =~ ^[0-9]+$ ]]; then
      asname=$(dig +short +time=2 +tries=1 TXT "AS$asn.asn.cymru.com" 2>/dev/null | head -n1 | tr -d '"' | awk -F'|' '{sub(/^ +/, "", $5); sub(/ +$/, "", $5); sub(/, [A-Z][A-Z]$/, "", $5); print $5}')
    fi
  fi
  ptr=$(dig +short +time=2 +tries=1 -x "$ip" 2>/dev/null | head -n1); ptr=${ptr%.}
  [[ $asn =~ ^[0-9]+$ ]] || asn=""; [[ $cc =~ ^[A-Z][A-Z]$ ]] || cc=""
  printf '%s\t%s\t%s\t%s\n' "$cc" "$asn" "$(tr -cd 'A-Za-z0-9 ._&-' <<<"$asname" | head -c 40)" "$(tr -cd 'A-Za-z0-9.-' <<<"$ptr" | tr 'A-Z' 'a-z' | head -c 80)"
}

# Список IP из stdin -> JSON {ip: {cc, asn, as, ptr}}. Новые адреса узнаются пачками по 10 параллельно (не больше AX_IPINFO_MAX
# за вызов, остальные при следующей сборке), результат хранится 30 дней.
report_ipinfo() {
  local ips=() ip need=() d i n=0 lim=${AX_IPINFO_MAX:-40} listj cutoff
  mapfile -t ips; [[ ${#ips[@]} -gt 0 ]] || { echo '{}'; return 0; }
  [[ -f $IPINFO ]] || { (umask 077; echo '{}' >"$IPINFO"); }
  cutoff=$(( $(now) - 2592000 ))
  listj=$(printf '%s\n' "${ips[@]}" | jq -Rn '[inputs]')
  mapfile -t need < <(jq -r --argjson l "$listj" --argjson t "$cutoff" '. as $c | $l[] | select(($c[.].at // 0) <= $t)' "$IPINFO")
  d=$(mktemp -d)
  for ip in "${need[@]}"; do
    priv_ip "$ip" && continue
    [[ $n -lt $lim ]] || break
    ( ipinfo_fetch "$ip" >"$d/$n.row" 9>&- 8>&- 7>&-; echo "$ip" >"$d/$n.ip" ) &
    n=$((n + 1)); (( n % 10 == 0 )) && wait
  done
  wait
  for ((i = 0; i < n; i++)); do
    [[ -s $d/$i.ip ]] || continue
    printf '%s\t%s\n' "$(<"$d/$i.ip")" "$(<"$d/$i.row")"
  done >"$d/all.tsv"
  if [[ -s $d/all.tsv ]]; then
    jq -Rn --slurpfile c "$IPINFO" --argjson now "$(now)" --argjson keep "$(( $(now) - 7776000 ))" '
      reduce (inputs | split("\t")) as $r ($c[0]; .[$r[0]] = {cc: $r[1], asn: $r[2], as: $r[3], ptr: $r[4], at: $now})
      | with_entries(select(.value.at > $keep))' <"$d/all.tsv" >"$d/new.json" && (umask 077; cat "$d/new.json" >"$IPINFO")
  fi
  rm -rf "$d"
  jq --argjson l "$listj" '. as $c | [$l[] | select($c[.] != null and ($c[.].cc != "" or $c[.].asn != "" or $c[.].ptr != "")) | {key: ., value: ($c[.] | del(.at))}] | from_entries' "$IPINFO"
}

# IP-адреса, чаще всего встречающиеся в данных (JSON-массив дней в stdin)
report_ip_list() {
  jq -r 'reduce .[] as $d ({}; reduce ((($d.hosts // {}) | to_entries[]), (($d.src // {}) | to_entries | map({key, value: .value.n})[])) as $e (.; .[$e.key] += $e.value))
         | to_entries | sort_by(-.value) | map(.key | select(test("^[0-9.]+$") or contains(":"))) | .[:120][]'
}

# Статическая версия отчёта: те же блоки, что рисует JavaScript, но готовыми (за последние 7 дней). Страница остаётся полной там,
# где скрипты не запускаются (встроенный просмотр файлов в Telegram и т. п.). Плюс готовый текст для Telegram (поле text).
REPORT_STATIC_JQ=$(cat <<'JQ'
def esc: gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;") | gsub("\""; "&quot;");
def isip: test("^[0-9.]+$") or contains(":");
def flag: if (. // "") | test("^[A-Z]{2}$") then ([explode[] | . + 127397] | implode) else "" end;
def infotxt($i): ($i // {}) as $x
  | [(if ($x.cc // "") != "" then ($x.cc | flag) + " " + $x.cc else empty end),
     (if ($x.asn // "") != "" then "AS" + $x.asn + (if ($x.as // "") != "" then " " + $x.as else "" end) else empty end),
     (if ($x.ptr // "") != "" then $x.ptr else empty end)] | join(" · ");
def small($info): infotxt($info[.]) | if . != "" then "<small class=\"info\">" + esc + "</small>" else "" end;
def namehtml($info): . as $h | if isip then "🔢 " + esc + ($h | small($info)) else "🌐 " + esc end;
def sum($k): reduce .[] as $d ({}; reduce (($d[$k] // {}) | to_entries[]) as $e (.; .[$e.key] = ((.[$e.key] // 0) + $e.value)));
def topn($m; $n): $m | to_entries | sort_by(-.value) | .[:$n];
def pct($v; $t): if $t > 0 then ((($v * 1000 / $t) | round) / 10) else 0 end;
def rows($list; $total; f): if ($list | length) == 0 then "<div class=\"empty\">Нет данных</div>"
  else $list[0].value as $max
