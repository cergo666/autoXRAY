# Общее для серверных конфигов: лог доступа нужен только при лимитах IP; блокировка лишних IP по правилу user + source
SERVER_COMMON=$(cat <<'JQ'
def debug_on($S): (($S.debug.until // 0) > $now);
def has_ip_limit($S): ([$S.users[] | select(.enabled and (((.ip_limit // 0) > 0) or (.report == true)))] | length) > 0;
def ban_rules: ([$b[0][] | select(.until > $now)] | group_by(.user) | map({user: [.[0].user], source: (map(.ip) | unique), outboundTag: "block"}));
JQ
)

# Исходящее подключение к EU-узлу (общее для сервера моста и клиентского профиля «Direct EU»)
BRIDGE_COMMON=$(cat <<'JQ'
def node_user($n): {id: $n.uuid, encryption: "none"} + (if $n.flow != "" then {flow: $n.flow} else {} end);
def node_stream($n):
  {network: $n.type}
  + (if $n.type == "xhttp" then {xhttpSettings: {extra: (if $n.extra == "" then null else ($n.extra | fromjson) end), mode: $n.mode, path: $n.path}} else {} end)
  + (if $n.security == "tls" then {security: "tls", tlsSettings: {serverName: $n.sni, fingerprint: $n.fp, alpn: $n.alpn}} else {security: "none"} end);
def hex4($i): ([($i / 4096 | floor), (($i / 256 | floor) % 16), (($i / 16 | floor) % 16), ($i % 16)] | map("0123456789abcdef"[. : (. + 1)]) | join(""));
def route_uuid($uuid; $i): $uuid[0:14] + hex4($i) + $uuid[18:];
JQ
)

