           + (topn($hosts; 10) | map("• " + (.key | esc) + " — \(.value)" + (infotxt($info[.key]) | if . != "" then "\n   <i>" + esc + "</i>" else "" end)) | join("\n"))
           + "\n\n📱 С каких IP:\n"
