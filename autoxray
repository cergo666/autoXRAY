usage() {
  local H="${BOLD}${MAG}" C="${CYAN}" D="${DIM}" N="${NC}"
  echo -e "${BOLD}🔐 autoxray $AX_VERSION${N} ${D}— управление autoXRAY${N}\n"
  echo -e "${H}Общее${N}"
  echo -e "  ${C}autoxray${N}                       меню"
  echo -e "  ${C}autoxray status${N}                состояние служб, сертификата, WARP"
  echo -e "  ${C}autoxray doctor${N}                🩺 диагностика сервера"
  echo -e "  ${C}autoxray stats${N}                 📊 трафик по пользователям"
  echo -e "${H}Пользователи${N}"
  echo -e "  ${C}autoxray user list${N} ${D}[--plain]${N}"
  echo -e "  ${C}autoxray user add${N} <имя> ${D}[--limit ГБ] [--days N] [--ips N] [--ru direct|server] [--reset monthly]${N}"
  echo -e "  ${C}autoxray user set${N} <имя> ${D}[--limit ГБ] [--days N] [--ips N] [--ru direct|server] [--reset monthly|never] [--enable|--disable] [--reset-traffic]${N}"
  echo -e "  ${C}autoxray ips${N} ${D}[имя]${N}  ${C}unban${N} <имя|--all>   ${D}лимит устройств (IP) и блокировки${N}"
  echo -e "  ${C}autoxray report${N} list|build [имя]|url <имя>|purge <имя>|keep <дней>   ${D}html-отчёты о посещениях (user set --report on)${N}"
  echo -e "  ${C}autoxray user del${N} <имя>        ${C}user rotate${N} <имя>  ${D}новые ключи и ссылка${N}"
  echo -e "  ${C}autoxray user link${N} <имя> ${D}[--plain]${N}  ${C}user qr${N} <имя> ${D}[sub|links|xhttp|vision|hy2]${N}"
  echo -e "${H}Сеть${N}"
  echo -e "  ${C}autoxray warp${N} register|on|off|status|check|add|del  ${C}warp debug${N} ${D}[--quick]${N} ${D}разбор проблем${N}"
  echo -e "  ${C}autoxray warp scan${N} ${D}[--apply] [--depth quick|more|all] [--colo FRA,AMS] [--exclude-colo DME]${N}  ${D}самый быстрый endpoint${N}"
  echo -e "  ${C}autoxray warp soak${N} ${D}[--apply] [--rounds N] [endpoint...]${N}  ${D}стабильность endpoint'ов${N}   ${C}warp renew${N} ${D}новое устройство Cloudflare${N}"
  echo -e "  ${C}autoxray warp coldtest${N} ${D}[--idle 200] [--site сайт]${N}  ${D}почему первый запрос после простоя медленный${N}"
  echo -e "  ${C}autoxray debug${N} on [минут]|show [сайт]|off   ${D}временный подробный лог (адреса видны, выключается сам)${N}"
  echo -e "  ${C}autoxray warp nightly${N} on|off  ${C}depth${N} quick|more|all  ${C}threshold${N} <мс>  ${C}rescan${N} now  ${C}hosts${N} <сайты>"
  echo -e "  ${C}autoxray warp ru${N} on|off        ${D}российские сайты через WARP${N}"
  echo -e "  ${C}autoxray node${N} add <vless://…>|del <имя|id>|list   ${D}(режим моста)${N}"
  echo -e "  ${C}autoxray fingerprint${N} <браузер> ${C}telegram${N} set <ссылка>|off|update|remove"
  echo -e "  ${C}autoxray bot${N} setup|status|on|off|add-admin|del-admin|proxy|test|remove   ${D}Telegram-бот администратора и уведомления${N}"
  echo -e "  ${C}autoxray site${N} status|regenerate|set <папка>   ${D}сайт-маскировка: новый дизайн или свой сайт${N}"
  echo -e "  ${C}autoxray firewall${N} [--dry-run]  ${D}🔥 настроить ufw (SSH, 80, 443)${N}"
  echo -e "${H}Обслуживание${N}"
  echo -e "  ${C}autoxray backup${N} [файл]  ${C}restore${N} <файл>  ${C}render${N}  ${D}пересобрать конфиги${N}"
  echo -e "  ${C}autoxray self-update${N} [vX.Y.Z]  ${C}rollback${N} ${D}[list|N]${N}  ${C}geo-update${N}   ${D}обновление со снимком и откатом при сбое${N}"
  echo -e "  ${C}autoxray core${N} list|update [версия]  ${D}ядро Xray: что установлено и что новее${N}"
  echo -e "  ${C}autoxray migrate${N} [имя]         ${D}перенос с autoXRAY 2${N}"
  echo -e "  ${C}autoxray uninstall${N}             ${D}удалить всё (с подтверждением)${N}"
  echo -e "  ${C}autoxray version${N}  ${C}collect${N} ${D}(cron: учёт трафика)${N}"
}

main() {
  local cmd=${1:-menu}; shift || true
  case $cmd in
    menu)         menu ;;
    status)       cmd_status ;;
    user|users)   cmd_users "$@" ;;
    stats)        cmd_stats ;;
    collect)      need_root; locked cmd_collect ;;
    warp)         cmd_warp "$@" ;;
    fingerprint)  cmd_fingerprint "$@" ;;
    telegram)     cmd_telegram "$@" ;;
    backup)       cmd_backup "$@" ;;
    restore)      cmd_restore "$@" ;;
    update-core)  cmd_core update "$@" ;;
    core)         cmd_core "$@" ;;
    render)       cmd_render ;;
    init)         cmd_init "$@" ;;
    migrate)      cmd_migrate "$@" ;;
    node|nodes)   cmd_node "$@" ;;
    self-update)  cmd_self_update "$@" ;;
    uninstall)    cmd_uninstall ;;
    selfcheck)    post_update_check ;;
    site)         cmd_site "$@" ;;
    bot)          cmd_bot "$@" ;;
    debug)        cmd_debug "$@" ;;
    rollback)     cmd_rollback "$@" ;;
    ipwatch)      need_root; locked cmd_ipwatch ;;
    report)       cmd_report "$@" ;;
    ips)          cmd_ips "$@" ;;
    unban)        cmd_unban "$@" ;;
    setup-cron)   cmd_setup_cron ;;
    doctor)       cmd_doctor ;;
    geo-update)   need_root; cmd_geo_update "$@" ;;
    firewall)     cmd_firewall "$@" ;;
    -v|--version|version) echo "autoxray $AX_VERSION" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
