# --------------------------------------------- свои правила маршрутов и строка статуса

# Нормализует домен или IPv4-сеть для правил; код 1, если ввод неверный
route_norm() {
  local v=${1,,}
  if [[ $v =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?$ ]]; then valid_trust "$v" && [[ $v != */* || ${v#*/} -ge 8 ]] && { echo "$v"; return 0; }; return 1; fi
  v=${v#http://}; v=${v#https://}; v=${v%%/*}; v=${v#domain:}; v=${v#\*.}; v=${v%.}
  [[ $v =~ ^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z0-9-]{2,}$ ]] || return 1
  echo "$v"
}

# autoxray route list | add direct|proxy|block <домен|сеть>... | del <домен|сеть>... | preset push on|off
# Правила попадают в подписки (Xray JSON, Clash, sing-box) всех пользователей: direct идёт мимо сервера, proxy через сервер, block режется на устройстве.
cmd_route() {
  need_state
  local sub=${1:-list}; shift || true
  case $sub in
    list|ls)
      section "🧭 Свои правила маршрутов"
      local k ico title
      for k in direct proxy block; do
        case $k in direct) ico="🏠"; title="напрямую, мимо сервера" ;; proxy) ico="🛰 "; title="через сервер" ;; block) ico="🚫"; title="блокировать" ;; esac
        echo -e " $ico ${BOLD}$k${NC} ${DIM}($title)${NC}: $(jq -r --arg k "$k" '((.routes // {})[$k] // []) | if length == 0 then "нет" else join(", ") end' "$STATE")"
      done
      echo -e " 📲 ${BOLD}push${NC} ${DIM}(пуш-уведомления Apple и Google напрямую)${NC}: $(tick "$(jq -r '((.routes // {}).presets // []) | index("push") != null' "$STATE")")"
      echo -e "\n ${DIM}Добавить: autoxray route add direct|proxy|block сайт.ру 1.2.3.0/24. Убрать: route del сайт.ру. После изменения обновите подписку в приложении.${NC}" ;;
    add) need_root
      local kind=${1:-} item norm items=()
      [[ $kind =~ ^(direct|proxy|block)$ ]] || die "route add direct|proxy|block <домен|сеть>..."
      shift; [[ $# -gt 0 ]] || die "Укажите домен или IPv4-сеть: route add $kind example.com 203.0.113.0/24"
      for item in "$@"; do norm=$(route_norm "$item") || die "Не похоже на домен или IPv4-сеть: $item (кириллические домены записывайте в punycode: xn--...)"; items+=("$norm"); done
      st_edit --arg k "$kind" --argjson l "$(printf '%s\n' "${items[@]}" | jq -Rn '[inputs]')" '
        .routes = ((.routes // {}) | reduce ("direct", "proxy", "block") as $x (.; .[$x] = ((.[$x] // []) - $l)) | .[$k] = (((.[$k] // []) + $l) | unique))'
      locked render_subs; ok "✅ $kind: ${items[*]}"
      echo -e " ${DIM}Подписки обновлены. В приложении клиента нажмите «обновить подписку».${NC}" ;;
    del|rm) need_root
      local item norm items=()
      [[ $# -gt 0 ]] || die "route del <домен|сеть>..."
      for item in "$@"; do norm=$(route_norm "$item") || die "Не похоже на домен или IPv4-сеть: $item"; items+=("$norm"); done
      st_edit --argjson l "$(printf '%s\n' "${items[@]}" | jq -Rn '[inputs]')" '.routes = ((.routes // {}) | reduce ("direct", "proxy", "block") as $x (.; .[$x] = ((.[$x] // []) - $l)))'
      locked render_subs; ok "✅ Убрано: ${items[*]}" ;;
    preset) need_root
      [[ ${1:-} == push && ${2:-} =~ ^(on|off)$ ]] || die "route preset push on|off"
      if [[ $2 == on ]]; then st_edit '.routes.presets = (((.routes.presets // []) + ["push"]) | unique)'; else st_edit '.routes.presets = ((.routes.presets // []) - ["push"])'; fi
      locked render_subs; ok "✅ Пуш-уведомления Apple и Google: $2" ;;
    *) die "route: list | add direct|proxy|block <домен|сеть>... | del <домен|сеть>... | preset push on|off" ;;
  esac
}

