# Печатает «название|ссылка» по строке на каждый протокол.
user_links() {
  jq -r --arg n "$1" --arg ex "$EXTRA" "$BRIDGE_COMMON"'
    def xl($S; $id; $u; $tag): "vless://\(route_uuid($u.uuid; $id))@\($S.domain):443?security=tls&alpn=h2&type=xhttp&mode=stream-up&path=%2F\($S.paths.xhttp)&extra=\($ex)&sni=\($S.domain)&fp=\($S.fingerprint)#\($tag | @uri)";
    . as $S | ($S.users[] | select(.name == $n)) as $u
    | if $S.mode == "bridge" then
        (if ($S.nodes | length) > 1 then "🇷🇺 RU>EU Автобалансир|\(xl($S; 0; $u; "RU>EU Автобалансир"))" else empty end),
        ($S.nodes[] as $x
         | "XHTTP TLS stream-up (RU>EU \($x.name))|\(xl($S; $x.id; $u; "RU>EU_xhttp_" + $x.name))",
           "RAW VISION (RU>EU \($x.name))|vless://\(route_uuid($u.uuid; $x.id))@\($S.domain):443?security=tls&type=tcp&headerType=&path=&host=&flow=xtls-rprx-vision&sni=\($S.domain)&fp=\($S.fingerprint)&spx=%2F#\("RU>EU_raw_" + $x.name | @uri)",
           "Direct EU (\($x.name))|\($x.url)")
      else
        "VLESS XHTTP TLS stream-up (для моста)|vless://\($u.uuid)@\($S.domain):443?security=tls&alpn=h2&type=xhttp&mode=stream-up&path=%2F\($S.paths.xhttp)&extra=\($ex)&sni=\($S.domain)&fp=\($S.fingerprint)#vlessXHTTPtls-\($u.name)",
        "VLESS RAW TLS VISION|vless://\($u.uuid)@\($S.domain):443?security=tls&type=tcp&headerType=&path=&host=&flow=xtls-rprx-vision&sni=\($S.domain)&fp=\($S.fingerprint)&spx=%2F#vlessRAWtlsVision-\($u.name)",
        "HYSTERIA2|hy2://\($u.hy2)@\($S.domain):443/?sni=\($S.domain)&alpn=h3#Hysteria2-\($u.name)"
      end
  ' "$STATE"
}

CLIENT_JQ=$(cat <<'JQ'
def ru_domains: ["domain:ru", "domain:su", "domain:xn--p1ai", "geosite:yandex", "geosite:vk", "geosite:category-ru"];
def sniff: {enabled: true, destOverride: ["http", "tls", "quic"]};

def client($proxy; $remark; $ru_direct): {
  log: {loglevel: "warning"},
  dns: {
    servers: [
      {address: "https+local://77.88.8.8/dns-query",
       domains: ["geosite:category-ru", "geosite:yandex", "geosite:vk", "domain:ru", "domain:su", "domain:xn--p1ai"],
       skipFallback: true},
      "https://8.8.4.4/dns-query", "https://8.8.8.8/dns-query", "https://1.1.1.1/dns-query"
    ],
    queryStrategy: "UseIPv4"
  },
  routing: {
    domainMatcher: "hybrid", domainStrategy: "IPIfNonMatch",
    rules: [
      {domain: ["geosite:category-ads", "geosite:win-spy"], outboundTag: "block"},
      {protocol: ["bittorrent"], outboundTag: "direct"},
      {domain: ["habr.com", "apkmirror.com"], outboundTag: "proxy"},
      {domain: (["geosite:private", "ifconfig.me", "checkip.amazonaws.com", "pify.org", "2ip.io",
                 "geosite:category-ip-geo-detect", "geosite:apple", "geosite:apple-pki", "geosite:f-droid"]
                + (if $ru_direct then ru_domains else [] end)),
       outboundTag: "direct"},
      {ip: (["geoip:private"] + (if $ru_direct then ["geoip:ru"] else [] end)), outboundTag: "direct"}
    ]
  },
  inbounds: [
    {tag: "socks-in", protocol: "socks", listen: "127.0.0.1", port: 10808, settings: {udp: true}, sniffing: sniff},
    {tag: "socks-sb", protocol: "mixed", listen: "127.0.0.1", port: 2080, settings: {udp: true}, sniffing: sniff},
    {tag: "http-in", protocol: "http", listen: "127.0.0.1", port: 10809, sniffing: sniff}
  ],
  outbounds: [$proxy, {tag: "direct", protocol: "freedom"}, {tag: "block", protocol: "blackhole"}],
  remarks: $remark
};

JQ
)

CLIENT_DIRECT_TAIL=$(cat <<'JQ'
. as $S
| ($S.users[] | select(.name == $n)) as $u
| (($S.warp.enabled == true and $S.warp.registered == true and $S.warp.ru == true) | not) as $ru_direct
| {tag: "proxy", protocol: "vless",
   settings: {vnext: [{address: $S.domain, port: 443, users: [{id: $u.uuid, encryption: "none"}]}]},
   streamSettings: {
     network: "xhttp",
     xhttpSettings: {
       mode: "stream-up", path: ("/" + $S.paths.xhttp),
       extra: {noGRPCHeader: false, xPaddingBytes: "150-400", scMaxEachPostBytes: 500000,
               scMinPostsIntervalMs: "5-15", scMaxBufferedPosts: 20, scStreamUpServerSecs: "90-180",
               xmux: {maxConcurrency: "2-4", cMaxReuseTimes: "800-1500", hMaxReusableSecs: "900-1200"}}
     },
     security: "tls",
     tlsSettings: {serverName: $S.domain, alpn: ["h2"], fingerprint: $S.fingerprint}
   }} as $xhttp
| {tag: "proxy", protocol: "vless",
   settings: {vnext: [{address: $S.domain, port: 443, users: [{id: $u.uuid, flow: "xtls-rprx-vision", encryption: "none"}]}]},
   streamSettings: {network: "raw", security: "tls",
                    tlsSettings: {serverName: $S.domain, fingerprint: $S.fingerprint}}} as $vision
| {tag: "proxy", protocol: "hysteria",
   settings: {address: $S.domain, port: 443, version: 2},
   streamSettings: {
     network: "hysteria", security: "tls",
     tlsSettings: {serverName: $S.domain, alpn: ["h3"], fingerprint: $S.fingerprint},
     hysteriaSettings: {version: 2, auth: $u.hy2},
     finalmask: {quicParams: {congestion: "brutal", brutalUp: "100 mbps", brutalDown: "100 mbps"}}
   }} as $hy2
| [client($xhttp; "🇪🇺 VLESS XHTTP TLS stream-up"; $ru_direct),
   client($vision; "🇪🇺 VLESS RAW TLS VISION"; $ru_direct),
   client($hy2; "🇪🇺 HYSTERIA2"; $ru_direct)]
JQ
)

CLIENT_BRIDGE_TAIL=$(cat <<'JQ'
def xextra: {noGRPCHeader: false, xPaddingBytes: "150-400", scMaxEachPostBytes: 500000, scMinPostsIntervalMs: "5-15",
             scMaxBufferedPosts: 20, scStreamUpServerSecs: "90-180",
             xmux: {maxConcurrency: "2-4", cMaxReuseTimes: "800-1500", hMaxReusableSecs: "900-1200"}};
def via_xhttp($S; $u; $id): {mux: {concurrency: -1, enabled: false}, tag: "proxy", protocol: "vless",
  settings: {vnext: [{address: $S.domain, port: 443, users: [{id: route_uuid($u.uuid; $id), encryption: "none"}]}]},
  streamSettings: {network: "xhttp", security: "tls",
                   tlsSettings: {serverName: $S.domain, alpn: ["h2"], fingerprint: $S.fingerprint},
                   xhttpSettings: {mode: "stream-up", path: ("/" + $S.paths.xhttp), extra: xextra}}};
def via_vision($S; $u; $id): {mux: {concurrency: -1, enabled: false}, tag: "proxy", protocol: "vless",
  settings: {vnext: [{address: $S.domain, port: 443, users: [{id: route_uuid($u.uuid; $id), flow: "xtls-rprx-vision", encryption: "none"}]}]},
  streamSettings: {network: "raw", security: "tls", tlsSettings: {serverName: $S.domain, fingerprint: $S.fingerprint}}};
def direct_eu($n): {mux: {concurrency: -1, enabled: false}, tag: "proxy", protocol: "vless",
  settings: {vnext: [{address: $n.addr, port: $n.port, users: [node_user($n)]}]}, streamSettings: node_stream($n)};

. as $S
| ($S.users[] | select(.name == $n)) as $u
| ((if ($S.nodes | length) > 1 then [client(via_xhttp($S; $u; 0); "🇷🇺 RU>EU Автобалансир"; true)] else [] end)
   + [$S.nodes[] as $x
      | client(via_xhttp($S; $u; $x.id); "🇷🇺 RU>EU xhttp | \($x.name)"; true),
        client(via_vision($S; $u; $x.id); "🇷🇺 RU>EU raw | \($x.name)"; true),
        client(direct_eu($x); "🇪🇺 EU dir | \($x.name)"; true)])
JQ
)

sub_json() {
  local prog="$CLIENT_JQ"$'\n'"$CLIENT_DIRECT_TAIL"
  [[ $(mode) == bridge ]] && prog="$BRIDGE_COMMON"$'\n'"$CLIENT_JQ"$'\n'"$CLIENT_BRIDGE_TAIL"
  jq --arg n "$1" "$prog" "$STATE"
}

html_esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }

sub_html() {
  local name=$1 tpl="$TPL_DIR/sub.html" u domain token used limit expire status tg rows="" idx=1 label link
  [[ -f $tpl ]] || { warn "Нет шаблона $tpl — HTML-страница подписки пропущена."; return 1; }
  u=$(user_must "$name")
  domain=$(st .domain); token=$(jq -r .token <<<"$u")
  limit=$(jq -r .limit <<<"$u"); expire=$(jq -r .expire <<<"$u")
  used=$(jq -r --arg n "$name" '((.[$n].up // 0) + (.[$n].down // 0))' "$TRAFFIC")
  status=$(jq_state -r --arg n "$name" "$JQ_DEFS"'.users[] | select(.name == $n) | status(.)')
  tg=$(st '.telegram.link // ""')

  while IFS='|' read -r label link; do
    rows+="<div class=\"cfg\"><div class=\"cfg-head\"><span class=\"cfg-name\">$(html_esc <<<"$label")</span><span class=\"cfg-actions\"><button class=\"mini\" data-copy=\"c$idx\">Копировать</button><button class=\"mini\" data-qr=\"c$idx\">QR</button></span></div><code id=\"c$idx\">$(html_esc <<<"$link")</code></div>"$'\n'
    idx=$((idx + 1))
  done < <(user_links "$name")

  local tg_block=""
  if [[ -n $tg ]]; then
    tg_block="<section class=\"card\"><h2>Telegram</h2><p class=\"muted\">Web Proxy на этом же сервере — открывается одной кнопкой.</p><div class=\"row\"><a class=\"btn tg\" href=\"$(html_esc <<<"$tg")\">Добавить прокси в Telegram</a><button class=\"btn ghost\" data-copy-text=\"$(html_esc <<<"$tg")\">Копировать ссылку</button></div></section>"
  fi

  local sub_url="https://$domain/$token.json" out
  out=$(<"$tpl")
  out=${out//'{{NAME}}'/$(html_esc <<<"$name")}
  out=${out//'{{DOMAIN}}'/$(html_esc <<<"$domain")}
  out=${out//'{{SUB_URL}}'/$(html_esc <<<"$sub_url")}
  out=${out//'{{USED}}'/$used}
  out=${out//'{{LIMIT}}'/$limit}
  out=${out//'{{EXPIRE}}'/$expire}
  out=${out//'{{STATUS}}'/$status}
  out=${out//'{{TG_BLOCK}}'/$tg_block}
  out=${out//'{{CONFIGS}}'/$rows}
  printf '%s\n' "$out"
}

# Файлы подписок + map для заголовка subscription-userinfo в nginx.
render_subs() {
  local web name token map_new changed=0 keep=" "
  web=$(st .web); mkdir -p "$web"
  map_new=$(mktemp)
  while IFS= read -r name; do
    token=$(user_get "$name" | jq -r .token)
    sub_json "$name" >"$web/$token.json" || warn "Не удалось собрать подписку для $name"
    sub_html "$name" >"$web/$token.html" 2>/dev/null || rm -f "$web/$token.html"
    chmod 644 "$web/$token.json" "$web/$token.html" 2>/dev/null
    keep+="$token "
    jq -r --arg n "$name" --arg tok "$token" --slurpfile t "$TRAFFIC" '
      .users[] | select(.name == $n) as $u
      | (($t[0][$n].up // 0)) as $up | (($t[0][$n].down // 0)) as $dn
      | "\"/\($tok).json\" \"upload=\($up); download=\($dn)"
        + (if $u.limit > 0 then "; total=\($u.limit)" else "" end)
        + (if $u.expire > 0 then "; expire=\($u.expire)" else "" end) + "\";"' "$STATE" >>"$map_new"
  done < <(jq -r '.users[].name' "$STATE")

  # удаляем файлы подписок отозванных пользователей
  local f base
  for f in "$web"/*.json "$web"/*.html; do
    [[ -e $f ]] || continue
    base=$(basename "$f"); base=${base%.*}
    [[ $base =~ ^[A-Za-z0-9]{20,32}$ ]] || continue
    [[ $keep == *" $base "* ]] || rm -f "$f"
  done

  if [[ ! -f $NGX_MAP ]] || ! cmp -s "$map_new" "$NGX_MAP"; then
    mkdir -p "$(dirname "$NGX_MAP")"; cat "$map_new" >"$NGX_MAP"; changed=1
  fi
  rm -f "$map_new"
  [[ $changed == 1 ]] && svc reload nginx 2>/dev/null
  return 0
}

NGX_CONF="${AX_NGINX_CONF:-/etc/nginx/conf.d/default.conf}"

FALLBACK_PROXY='    # web proxy Telegram (tproxy-server) + раздача статики сайта-маскировки
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }'
FALLBACK_STATIC='    location / {
        try_files $uri $uri/ =404;
    }'

# nginx.conf собирается из шаблона и state.json; при ошибке `nginx -t` прежний файл возвращается.
render_nginx() {
  local tpl="$TPL_DIR/nginx.conf" out fb new
  [[ -f $tpl ]] || { warn "Нет шаблона $tpl — nginx.conf не обновлён."; return 0; }
  [[ -f $NGX_MAP ]] || { mkdir -p "$(dirname "$NGX_MAP")"; : >"$NGX_MAP"; }
  fb=$FALLBACK_STATIC
  [[ $(st '.telegram.enabled // false') == true ]] && fb=$FALLBACK_PROXY
  out=$(<"$tpl")
  out=${out//'{{FALLBACK}}'/$fb}
  out=${out//'{{NGX_MAP}}'/$NGX_MAP}
  out=${out//'{{DOMAIN}}'/$(st .domain)}
  out=${out//'{{WEB}}'/$(st .web)}
  out=${out//'{{XHTTP_PATH}}'/$(st .paths.xhttp)}
  out=${out//'{{AUTH_PATH}}'/$(st .paths.auth)}
  out=${out//'{{AUTH_CODE}}'/$(st '.auth.code // "ERR_AUTH_FAILED"')}
  out=${out//'{{AUTH_MSG}}'/$(st '.auth.msg // "Authentication failed."')}
  new=$(mktemp); printf '%s\n' "$out" >"$new"
  if [[ -f $NGX_CONF ]] && cmp -s "$new" "$NGX_CONF"; then rm -f "$new"; return 0; fi
  [[ -f $NGX_CONF ]] && cp -p "$NGX_CONF" "$NGX_CONF.bak"
  mkdir -p "$(dirname "$NGX_CONF")"; cat "$new" >"$NGX_CONF"; rm -f "$new"
  if command -v nginx >/dev/null 2>&1 && ! nginx -t >/tmp/autoxray-nginx.log 2>&1; then
    warn "nginx отклонил конфиг, возвращаю прежний. Лог: /tmp/autoxray-nginx.log"; tail -n 5 /tmp/autoxray-nginx.log >&2
    if [[ -f $NGX_CONF.bak ]]; then cp -p "$NGX_CONF.bak" "$NGX_CONF"; else rm -f "$NGX_CONF"; fi
    return 1
  fi
  svc reload nginx 2>/dev/null || svc restart nginx
}

render_all() { apply_xray; local rc=$?; render_subs; render_nginx || rc=1; return $rc; }
# Для команд, меняющих state: если конфиг не применился, не рапортуем об успехе.
apply_or_die() { render_all || die "Изменения сохранены в state.json, но не применены (причина выше). Исправьте её и выполните: autoxray render"; }

# ------------------------------------------------------------ пользователи

user_summary() {
  jq_state -r "$JQ_DEFS"'.users[] | [.name, status(.), (used(.)|tostring), (.limit|tostring), (.expire|tostring)] | @tsv'
}

cmd_user_list() {
  need_state
  if [[ ${1:-} == --plain ]]; then user_summary; return; fi
  section "👥 Пользователи"
  printf '%b   %s %s %s %s %s%b\n' "$DIM" "$(pad ИМЯ 14)" "$(pad СТАТУС 12)" "$(pad РАСХОД 15)" "$(pad ТРАФИК 17)" ДЕЙСТВУЕТ "$NC"
  local name status used limit expire icon col col2 label txt left exp
  while IFS=$'\t' read -r name status used limit expire; do
    case $status in
      active)   icon="🟢"; col=$GRN;  label="активен" ;;
      disabled) icon="⚫"; col=$DIM;  label="отключён" ;;
      expired)  icon="⌛"; col=$YEL;  label="срок истёк" ;;
      limit)    icon="🚫"; col=$RED;  label="лимит" ;;
      *)        icon="❔"; col=$NC;   label=$status ;;
    esac
    txt="$(hbytes "$used")"; [[ $limit -gt 0 ]] && txt+=" / $(hbytes "$limit")"
    if [[ $expire -gt 0 ]]; then
      left=$(days_left "$expire"); col2=$GRN; [[ $left -le 7 ]] && col2=$YEL; [[ $left -le 3 ]] && col2=$RED
      exp="$(hdate "$expire") ${col2}($left дн.)${NC}"
    else exp="${DIM}бессрочно${NC}"; fi
    printf '%s %b%s%b %b%s%b %b %s %b\n' "$icon" "$BOLD" "$(pad "$name" 14)" "$NC" "$col" "$(pad "$label" 12)" "$NC" "$(bar "$used" "$limit" 10)" "$(pad "$txt" 17)" "$exp"
  done < <(user_summary)
}

cmd_user_add() {
  need_root; need_state
  local name=${1:-} limit=0 expire=0 reset=never
  valid_name "$name" || die "Имя: 1-24 символа, только A-Z a-z 0-9 _ -"
  shift
  [[ -z $(user_get "$name") ]] || die "Пользователь '$name' уже существует."
  while (($#)); do
    case $1 in
      --limit) [[ $# -ge 2 ]] && is_num "$2" || die "--limit <ГБ>"; limit=$(awk -v g="$2" 'BEGIN{printf "%d", g*1073741824}'); shift 2 ;;
      --days)  [[ $# -ge 2 ]] && is_num "$2" || die "--days <N>";   expire=$(awk -v n="$2" -v t="$(now)" 'BEGIN{printf "%d", t+n*86400}'); shift 2 ;;
      --reset) [[ ${2:-} =~ ^(monthly|never)$ ]] || die "--reset monthly|never"; reset=$2; shift 2 ;;
      *) die "Неизвестный параметр: $1" ;;
    esac
  done
  st_edit --arg n "$name" --arg id "$(user_uuid "$(mode)")" --arg h "$(rand 'a-f0-9' 16)" --arg t "$(rand 'A-Za-z0-9' 24)" \
          --argjson l "$limit" --argjson e "$expire" --argjson c "$(now)" --arg rs "$reset" --argjson nr "$([[ $reset == monthly ]] && next_month || echo 0)" \
    '.users += [{name: $n, uuid: $id, hy2: $h, token: $t, created: $c, expire: $e, limit: $l, enabled: true, reset: $rs, next_reset: $nr}]'
  apply_or_die
  ok "✅ Пользователь '$name' создан."
  show_user "$name"
}

cmd_user_del() {
  need_root; need_state
  local name=${1:-}; user_must "$name" >/dev/null
  [[ $(jq '.users | length' "$STATE") -gt 1 ]] || warn "Это последний пользователь — доступ к серверу будет закрыт."
  st_edit --arg n "$name" '.users |= map(select(.name != $n))'
  jq --arg n "$name" 'del(.[$n])' "$TRAFFIC" >"$TRAFFIC.tmp" && mv "$TRAFFIC.tmp" "$TRAFFIC"
  apply_or_die
  ok "✅ Пользователь '$name' удалён (ключи и ссылки подписки больше не работают)."
}

cmd_user_set() {
  need_root; need_state
  local name=${1:-}; user_must "$name" >/dev/null; shift
  (($#)) || die "Укажите параметры: --limit ГБ | --days N | --reset monthly|never | --enable | --disable | --reset-traffic"
  while (($#)); do
    case $1 in
      --limit)  [[ $# -ge 2 ]] && is_num "$2" || die "--limit <ГБ> (0 — без лимита)"
                st_edit --arg n "$name" --argjson l "$(awk -v g="$2" 'BEGIN{printf "%d", g*1073741824}')" '(.users[] | select(.name == $n) | .limit) = $l'; shift 2 ;;
      --days)   [[ $# -ge 2 ]] && is_num "$2" || die "--days <N> (0 — бессрочно)"
                st_edit --arg n "$name" --argjson e "$(awk -v n="$2" -v t="$(now)" 'BEGIN{printf "%d", (n>0) ? t+n*86400 : 0}')" '(.users[] | select(.name == $n) | .expire) = $e'; shift 2 ;;
      --reset)  [[ ${2:-} =~ ^(monthly|never)$ ]] || die "--reset monthly|never"
                st_edit --arg n "$name" --arg r "$2" --argjson nr "$([[ $2 == monthly ]] && next_month || echo 0)" '(.users[] | select(.name == $n)) |= (.reset = $r | .next_reset = $nr)'; shift 2 ;;
      --enable)  st_edit --arg n "$name" '(.users[] | select(.name == $n) | .enabled) = true'; shift ;;
      --disable) st_edit --arg n "$name" '(.users[] | select(.name == $n) | .enabled) = false'; shift ;;
      --reset-traffic) jq --arg n "$name" 'del(.[$n])' "$TRAFFIC" >"$TRAFFIC.tmp" && mv "$TRAFFIC.tmp" "$TRAFFIC"; shift ;;
      *) die "Неизвестный параметр: $1" ;;
    esac
  done
  apply_or_die
  ok "✅ Параметры '$name' обновлены."
}

cmd_user_rotate() {
  need_root; need_state
  local name=${1:-}; user_must "$name" >/dev/null
  st_edit --arg n "$name" --arg id "$(user_uuid "$(mode)")" --arg h "$(rand 'a-f0-9' 16)" --arg t "$(rand 'A-Za-z0-9' 24)" \
    '(.users[] | select(.name == $n)) |= (.uuid = $id | .hy2 = $h | .token = $t)'
  apply_or_die
  ok "✅ Для '$name' выпущены новые ключи и новая ссылка подписки."
  show_user "$name"
}

qr_show() {
  if command -v qrencode >/dev/null 2>&1; then qrencode -t ANSIUTF8 -m 1 "$1"
  else warn "qrencode не установлен: apt install qrencode"; fi
}

show_user() {
  need_state
  local name=${1:-} u domain token label link ico
  u=$(user_must "$name"); domain=$(st .domain); token=$(jq -r .token <<<"$u")
  section "🔗 Ссылки пользователя «$name»"
  echo -e "\n ${BOLD}📄 Личная страница${NC} ${DIM}(приложения, QR, остаток трафика)${NC}"
  echo -e "    ${CYAN}https://$domain/$token.html${NC}"
  echo -e "\n ${BOLD}📥 Подписка${NC} ${DIM}(вставить в Happ / v2rayTun)${NC}"
  echo -e "    ${CYAN}https://$domain/$token.json${NC}"
  while IFS='|' read -r label link; do
    case $label in *XHTTP*) ico="⚡" ;; *VISION*) ico="🔐" ;; *HYSTERIA*) ico="🚀" ;; *Direct*) ico="🧭" ;; *) ico="🔀" ;; esac
    echo -e "\n ${BOLD}${YEL}$ico $label${NC}\n    ${WHT}$link${NC}"
  done < <(user_links "$name")
  local tg; tg=$(st '.telegram.link // ""')
  [[ -n $tg ]] && echo -e "\n ${BOLD}${BLU}💬 Telegram Web Proxy${NC}\n    ${WHT}$tg${NC}"
  echo
}

cmd_user_qr() {
  need_state
