#!/usr/bin/env bash
# autoxray — управление пользователями, WARP и конфигурацией autoXRAY.
#
# Единственный источник правды — /etc/autoxray/state.json.
# config.json Xray, страницы и файлы подписок — производные, их создаёт `autoxray render`.
# Без аргументов открывается меню (TUI). Справка: autoxray help

set -uo pipefail
# bash >= 5.2: '&' в замене ${var//a/b} — спецсимвол; ссылки содержат '&'
shopt -u patsub_replacement 2>/dev/null || true

AX_VERSION="3.2.0"
AX_REPO="cergo666/autoXRAY"
XRAY_TESTED="v26.9.9"          # версия ядра, с которой этот релиз проверен тестами
API="${AX_API:-https://api.github.com}"
AX_ETC="${AX_ETC:-/etc/autoxray}"
STATE="$AX_ETC/state.json"
TRAFFIC="$AX_ETC/traffic.json"
LOCK="$AX_ETC/.lock"
XRAY_CFG="${AX_XRAY_CFG:-/usr/local/etc/xray/config.json}"
NGX_MAP="${AX_NGINX_MAP:-/etc/nginx/autoxray-userinfo.map}"
TPL_DIR="${AX_TEMPLATES:-/usr/local/share/autoxray}"
CURL="${AX_CURL:-curl}"
DRY="${AX_DRY:-0}"            # 1 — не трогать службы (для тестов)
API_ADDR="127.0.0.1:10085"
WARP_API="https://api.cloudflareclient.com/v0i1909051800"
WARP_ENDPOINT="162.159.192.1:2408"

BOLD='\033[1m'; DIM='\033[2m'
GRN='\033[1;32m'; RED='\033[1;31m'; YEL='\033[1;33m'; BLU='\033[1;34m'
MAG='\033[1;35m'; CYAN='\033[1;36m'; WHT='\033[1;37m'; NC='\033[0m'

ok()   { echo -e "${GRN}$*${NC}"; }
warn() { echo -e "${YEL}⚠  $*${NC}" >&2; }
die()  { echo -e "${RED}❌ $*${NC}" >&2; exit 1; }

section() { echo -e "\n${BOLD}${MAG}▌$*${NC}"; }
rule()    { echo -e "${DIM}──────────────────────────────────────────────────────────${NC}"; }
tick()    { [[ ${1:-} == true ]] && printf '%b✔%b' "$GRN" "$NC" || printf '%b✘%b' "$RED" "$NC"; }
# pad <строка> <ширина> — дополняет пробелами по числу СИМВОЛОВ (printf %-Ns считает байты, если локаль не UTF-8)
pad()     { local LC_ALL=C t=${1//[$'\200'-$'\277']/} n; n=$(( $2 - ${#t} )); printf '%s' "$1"; [[ $n -gt 0 ]] && printf '%*s' "$n" ""; return 0; }
kv()      { printf ' %s %b%s%b %b\n' "$1" "$DIM" "$(pad "$2" 14)" "$NC" "$3"; }

# bar <использовано> <лимит> [ширина] — полоса расхода, цвет по заполнению
bar() {
  local used=${1:-0} limit=${2:-0} w=${3:-12} pct=0 filled i col out=""
  if [[ $limit -gt 0 ]]; then
    pct=$(( used * 100 / limit )); [[ $pct -gt 100 ]] && pct=100
    col=$GRN; [[ $pct -ge 70 ]] && col=$YEL; [[ $pct -ge 90 ]] && col=$RED
    filled=$(( pct * w / 100 ))
    for ((i = 0; i < w; i++)); do [[ $i -lt $filled ]] && out+="█" || out+="░"; done
    printf '%b%s%b %3d%%' "$col" "$out" "$NC" "$pct"
  else
    for ((i = 0; i < w; i++)); do out+="░"; done
    printf '%b%s%b   ∞ ' "$DIM" "$out" "$NC"
  fi
}
# ver_gt A B — истина, если версия A новее B (числа через точку, префикс v допускается)
ver_gt() {
  local a=${1#v} b=${2#v}
  [[ -n $a && -n $b && $a != "$b" && $(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n1) == "$a" ]]
}

# Последний релиз autoXRAY. Кэш /etc/autoxray/.latest обновляет cron (collect раз в 12 часов);
# интерактивный запуск ходит в сеть только если кэша ещё нет (таймаут 3 с).
latest_ax() { # [force]
  local cache="$AX_ETC/.latest" age=999999 tag
  [[ -f $cache ]] && age=$(( $(date +%s) - $(stat -c %Y "$cache") ))
  if [[ ${1:-} == force ]] && [[ $age -gt 43200 ]] || [[ ! -f $cache ]]; then
    tag=$("$CURL" -fsS --max-time 3 "$API/repos/$AX_REPO/releases/latest" 2>/dev/null | jq -r '.tag_name // empty' 2>/dev/null)
    mkdir -p "$AX_ETC" 2>/dev/null
    { [[ -n $tag ]] && printf '%s\n' "${tag#v}" || { cat "$cache" 2>/dev/null || true; }; } >"$cache.tmp" 2>/dev/null && mv "$cache.tmp" "$cache" 2>/dev/null
  fi
  cat "$cache" 2>/dev/null
}

update_banner() {
  local latest; latest=$(latest_ax)
  if ver_gt "$latest" "$AX_VERSION"; then
    echo -e "\n 🆕 ${BOLD}${GRN}Доступна версия $latest${NC} ${DIM}(у вас $AX_VERSION)${NC}  ${CYAN}autoxray self-update${NC}"
  fi
}

days_left() { echo $(( ($1 - $(date +%s)) / 86400 )); }

need_root()  { [[ $DRY == 1 || $EUID -eq 0 ]] || die "Нужны root права."; }
need_state() { [[ -f $STATE ]] || die "autoXRAY не установлен: нет $STATE"; }
svc()        { [[ $DRY == 1 ]] || systemctl "$@" 9>&-; }

rand()     { LC_ALL=C tr -dc "$1" </dev/urandom | head -c "$2"; }
new_uuid() { cat /proc/sys/kernel/random/uuid; }
now()      { date +%s; }
next_month() { date -d "$(date +%Y-%m-01) +1 month" +%s; }

urldecode() { printf '%b' "${1//%/\\x}"; }

valid_name() { [[ ${1:-} =~ ^[A-Za-z0-9_-]{1,24}$ ]]; }
is_num()     { [[ ${1:-} =~ ^[0-9]+([.][0-9]+)?$ ]]; }

hbytes() {
  awk -v b="${1:-0}" 'BEGIN{
    split("Б КБ МБ ГБ ТБ", u, " "); i = 1
    while (b >= 1024 && i < 5) { b /= 1024; i++ }
    if (i == 1) printf "%d %s", b, u[i]; else printf "%.2f %s", b, u[i] }'
}
hdate() { [[ ${1:-0} -gt 0 ]] && date -d "@$1" +%F || echo "∞"; }

lock()   { exec 9>>"$LOCK"; flock -w 30 9 || die "Другая операция autoxray ещё выполняется."; }
locked() { lock; "$@"; local rc=$?; exec 9>&-; return $rc; }

# ---------------------------------------------------------------- состояние

st()      { jq -r "$1" "$STATE"; }
mode()    { jq -r '.mode // "direct"' "$STATE"; }
# В режиме моста 3-я группа UUID зарезервирована под vlessRoute (0000 = автобалансировщик)
user_uuid() { local u; u=$(new_uuid); [[ ${1:-direct} == bridge ]] && u="${u:0:14}0000${u:18}"; echo "$u"; }
st_edit() {
  local tmp
  tmp=$(mktemp "$AX_ETC/.state.XXXXXX") || die "Не могу создать временный файл в $AX_ETC"
  if jq "$@" "$STATE" >"$tmp"; then chmod 600 "$tmp"; mv "$tmp" "$STATE"; else rm -f "$tmp"; die "Ошибка обновления state.json"; fi
}

JQ_DEFS='
def used($u): (($t[0][$u.name].up // 0) + ($t[0][$u.name].down // 0));
def status($u):
  if ($u.enabled | not) then "disabled"
  elif ($u.expire != 0 and $u.expire <= $now) then "expired"
  elif ($u.limit != 0 and used($u) >= $u.limit) then "limit"
  else "active" end;
'
jq_state() { jq --slurpfile t "$TRAFFIC" --argjson now "$(now)" "$@" "$STATE"; }

user_get() { jq -c --arg n "$1" '.users[] | select(.name == $n)' "$STATE"; }
user_must() { local j; j=$(user_get "$1"); [[ -n $j ]] || die "Пользователь '$1' не найден."; echo "$j"; }
active_names() { jq_state -r "$JQ_DEFS"'.users[] | select(status(.) == "active") | .name' | sort | tr '\n' ' '; }

