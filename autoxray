      2) if [[ $(mode) == direct ]]; then menu_warp; else warn "WARP недоступен в режиме моста."; pause; fi ;;
      3) (cmd_doctor); pause ;;
      4) menu_bot ;;
      5) menu_update ;;
      6) menu_maint ;;
      7) (cmd_firewall); pause ;;
