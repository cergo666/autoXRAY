cmd_init() {
  need_root
  local domain="" fp=firefox xp="" ap=/api/v1/authenticate web="" user=main xv="" mode=direct nodes='[]' nj
  while (($#)); do
    [[ $# -ge 2 ]] || die "init: у параметра $1 нет значения"   # все параметры init с аргументом
    case $1 in
      --mode) [[ ${2:-} =~ ^(direct|bridge)$ ]] || die "--mode direct|bridge"; mode=$2; shift 2 ;;
      --node) nj=$(parse_vless "${2:-}") || die "Неверная vless-ссылка узла: ${2:-}"
              nodes=$(jq -c --argjson n "$nj" '. + [$n + {id: (length + 1)}]' <<<"$nodes"); shift 2 ;;
      --domain) domain=$2; shift 2 ;; --fp) fp=$2; shift 2 ;; --xhttp-path) xp=$2; shift 2 ;;
      --auth-path) ap=$2; shift 2 ;; --web) web=$2; shift 2 ;; --user) user=$2; shift 2 ;;
      --xray-version) xv=$2; shift 2 ;;
      *) die "init: неизвестный параметр $1" ;;
    esac
  done
  [[ -n $domain ]] || die "init --domain <домен>"
  [[ $mode == direct || $(jq length <<<"$nodes") -gt 0 ]] || die "Для режима моста нужен хотя бы один --node vless://..."
  valid_name "$user" || die "Недопустимое имя пользователя"
  [[ -f $STATE ]] && die "Уже инициализировано: $STATE (для повторной установки удалите его или сделайте backup)"
  mkdir -p "$AX_ETC"; chmod 700 "$AX_ETC"
  [[ -n $xp ]] || xp=$(rand 'a-z0-9' 6)
  [[ -n $web ]] || web="${AX_WEB:-/var/www/$domain}"
  echo '{}' >"$TRAFFIC"; chmod 600 "$TRAFFIC"
  local variants=(
    "ERR_INVALID_CREDENTIALS|The username or password you entered is incorrect."
    "ERR_INVALID_CREDENTIALS|The identity or security key you provided is invalid."
    "ERR_BAD_PASSWORD|Incorrect password. Please verify your credentials and retry."
    "ERR_KEY_MISMATCH|The security key provided does not match the account identity."
    "ERR_CREDENTIAL_REJECTED|Credential verification rejected by the authentication authority."
    "ERR_PASSWORD_MISMATCH|The password provided does not match the registered key."
    "ERR_INCORRECT_KEY|Incorrect security credentials provided for this principal."
    "ERR_USER_NOT_FOUND|Principal identity not found in directory services."
    "ERR_IDENTITY_NOT_FOUND|No account found matching the provided identity."
    "ERR_PRINCIPAL_MISSING|User principal does not exist in this organizational realm."
    "ERR_ACCOUNT_NOT_FOUND|Account identifier not recognized by the identity provider."
    "ERR_UNKNOWN_USER|Unrecognized user identity. Please verify your login."
    "ERR_LOOKUP_FAILED|User lookup failed: Specified identity does not exist."
    "ERR_AUTH_FAILED|Authentication failed: The provided credentials do not match."
    "ERR_DIRECTORY_MISMATCH|Credentials could not be verified against the corporate directory."
    "ERR_RECORDS_MISMATCH|The security credentials entered do not match our records."
  )
  local pick=${variants[$((RANDOM % ${#variants[@]}))]}
  jq -n --arg ac "${pick%%|*}" --arg am "${pick#*|}" --arg d "$domain" --arg f "$fp" --arg xp "$xp" --arg ap "$ap" --arg w "$web" --arg xv "$xv" \
        --arg su "$(rand 'A-Za-z0-9' 6)" --arg sp "$(rand 'A-Za-z0-9' 16)" \
        --arg n "$user" --arg id "$(user_uuid "$mode")" --arg h "$(rand 'a-f0-9' 16)" --arg t "$(rand 'A-Za-z0-9' 24)" --argjson c "$(now)" \
        --arg mode "$mode" --argjson nodes "$nodes" '
    {version: 3, mode: $mode, nodes: $nodes, auth: {code: $ac, msg: $am}, domain: $d, fingerprint: $f, web: $w, xray_version: $xv,
     paths: {xhttp: $xp, auth: $ap}, socks: {user: $su, pass: $sp},
     telegram: {enabled: false, link: ""},
     warp: {registered: false, enabled: false, ru: false, domains: []},
     users: [{name: $n, uuid: $id, hy2: $h, token: $t, created: $c, first_seen: 0, expire: 0, limit: 0, enabled: true, reset: "never", next_reset: 0}]}' >"$STATE"
  chmod 600 "$STATE"
  ok "✅ state.json создан: $STATE"
}

