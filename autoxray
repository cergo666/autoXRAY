      {tag: "api", port: 10085, listen: "127.0.0.1", protocol: "dokodemo-door", settings: {address: "127.0.0.1"}}
    ],
    outbounds: (
      [$S.nodes[] | node_out(.)]
      + [{tag: "direct", protocol: "freedom", settings: {}, streamSettings: {sockopt: {domainStrategy: "ForceIPv4"}}},
