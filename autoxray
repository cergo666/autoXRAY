          {protocol: ["bittorrent"], outboundTag: "block"},
          {domain: ["geosite:category-ads", "geosite:win-spy", "geosite:private"], outboundTag: "block"},
          {domain: ["testipv6.net", "ifconfig.me", "checkip.amazonaws.com", "pify.org", "2ip.io", "domain:ru", "domain:su", "domain:xn--p1ai",
                    "geosite:category-ip-geo-detect", "geosite:apple", "geosite:apple-pki", "geosite:f-droid", "geosite:yandex", "geosite:vk", "geosite:category-ru"],
