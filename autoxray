# Карточка пользователя (текст HTML) и клавиатура
bot_user_card() {
  local line name status used limit expire ipl ru rpt icon label pct="" left="∞" ipt="∞" rul rptt
  line=$(user_summary | awk -F'\t' -v n="$1" '$1 == n') || true
  [[ -n $line ]] || return 1
  IFS=$'\t' read -r name status used limit expire ipl ru rpt <<<"$line"
  case $status in active) icon="🟢"; label="активен" ;; disabled) icon="⚫"; label="отключён" ;; expired) icon="⌛"; label="срок истёк" ;; limit) icon="🚫"; label="лимит" ;; *) icon="❔"; label=$status ;; esac
  [[ $limit -gt 0 ]] && pct=" ($(( used * 100 / limit ))%)"
  [[ $expire -gt 0 ]] && left="$(hdate "$expire") ($(days_left "$expire") дн.)"
  [[ ${ipl:-0} -gt 0 ]] && ipt="$(ips_count "$name")/$ipl"
  [[ $ru == server ]] && rul="через сервер" || rul="напрямую"
  [[ $rpt == true ]] && rptt="вкл" || rptt="выкл"
  printf '👤 <b>%s</b>  %s %s\n📊 %s%s%s\n⏳ срок: %s\n📱 IP: %s   🇷🇺 RU: %s   📈 отчёт: %s' \
    "$name" "$icon" "$label" "$(hbytes "$used")" "$([[ $limit -gt 0 ]] && echo " / $(hbytes "$limit")")" "$pct" "$left" "$ipt" "$rul" "$rptt"
  # заметка, метки, скрытые протоколы и привязка Telegram
  jq -r --arg n "$name" '.users[] | select(.name == $n) | [
      (if (.tg // null) != null then "✈️ Telegram привязан" else "✈️ Telegram не привязан" end),
      (if ((.tags // []) | length) > 0 then "🏷 " + ((.tags // []) | map("#" + .) | join(" ")) else empty end),
      (if ((.hide // []) | length) > 0 then "🙈 скрыто: " + ((.hide // []) | join(", ")) else empty end),
      (if (.note // "") != "" then "📝 " + .note else empty end)] | "\n" + join("\n")' "$STATE" | html_esc
}
bot_user_kb() {
  local n=$1 enabled rep
  enabled=$(jq -r --arg n "$n" '.users[] | select(.name == $n) | .enabled' "$STATE")
  rep=$(jq -r --arg n "$n" '.users[] | select(.name == $n) | (.report // false)' "$STATE")
  jq -nc --argjson rep "$rep" --arg n "$n" --arg tog "$([[ $enabled == true ]] && echo "⏸ Отключить" || echo "▶️ Включить")" '
    {inline_keyboard: [
      [{text: "🔗 Ссылки", callback_data: "u:\($n):links"}, {text: "📷 QR", callback_data: "u:\($n):qr"}, {text: "✉️ Пригласить", callback_data: "u:\($n):inv"}],
      [{text: "∞", callback_data: "u:\($n):lim:0"}, {text: "10 ГБ", callback_data: "u:\($n):lim:10"}, {text: "50 ГБ", callback_data: "u:\($n):lim:50"}, {text: "100 ГБ", callback_data: "u:\($n):lim:100"}],
      [{text: $tog, callback_data: "u:\($n):tog"}, {text: "🔁 Новые ключи", callback_data: "u:\($n):rot"}],
      (if $rep then [{text: "📎 Отчёт файлом", callback_data: "u:\($n):repsend"}, {text: "🔗 Ссылка на отчёт", callback_data: "u:\($n):replink"}]
       else empty end),
      [(if $rep then {text: "⏸ Выключить отчёт", callback_data: "u:\($n):repoffq"} else {text: "📈 Включить отчёт", callback_data: "u:\($n):rep"} end),
       {text: "🗑 Удалить", callback_data: "u:\($n):del"}],
      [{text: "⬅️ К списку", callback_data: "list"}]]}'
