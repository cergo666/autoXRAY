pause() { echo; read -rp "$(echo -e "${DIM}Enter, чтобы продолжить...${NC}")" _; }
ask()   { local v; read -rp "$(echo -e " ${BOLD}${CYAN}›${NC} $1: ")" v; printf '%s' "$v"; }
confirm() { local v; read -rp "$(echo -e " ${BOLD}${YEL}?${NC} $1 (y/N): ")" v; [[ $v =~ ^[YyДд]$ ]]; }

# choose <заголовок> <пункт>... — выбор стрелками (↑ ↓, j k), цифрой или Enter; q / Esc — отмена.
# Результат: CHOICE (индекс с нуля). Без терминала (пайп, тесты) работает как нумерованный список.
# Пункты передавайте без цветовых кодов: выбранная строка подсвечивается инверсией.
CHOICE=-1
choose() {
  local title=$1; shift
  local items=("$@") n=$# cur=0 key rest i
  CHOICE=-1
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "$title"
    for ((i = 0; i < n; i++)); do printf '  %d) %s\n' $((i + 1)) "${items[i]}"; done
    read -r key
    [[ $key =~ ^[0-9]+$ && $key -ge 1 && $key -le $n ]] || return 1
    CHOICE=$((key - 1)); return 0
  fi
  draw() {
    for ((i = 0; i < n; i++)); do
      if [[ $i -eq $cur ]]; then printf '\033[2K\r  \033[7m %2d  %s \033[0m\n' $((i + 1)) "${items[i]}"
      else printf '\033[2K\r  %b%2d%b  %s\n' "$DIM" $((i + 1)) "$NC" "${items[i]}"; fi
    done
  }
  echo -e " ${BOLD}$title${NC}  ${DIM}↑↓ выбрать · Enter · цифра · q отмена${NC}"
  printf '\033[?25l'
  draw
  while true; do
    IFS= read -rsn1 key || { printf '\033[?25h'; return 1; }
    case $key in
      $'\033') IFS= read -rsn2 -t 0.05 rest
               case $rest in '[A') ((cur > 0)) && cur=$((cur - 1)) || cur=$((n - 1)) ;;
                             '[B') ((cur < n - 1)) && cur=$((cur + 1)) || cur=0 ;;
                             '') printf '\033[?25h'; return 1 ;; esac ;;
      k) ((cur > 0)) && cur=$((cur - 1)) || cur=$((n - 1)) ;;
      j) ((cur < n - 1)) && cur=$((cur + 1)) || cur=0 ;;
      q|Q) printf '\033[?25h'; return 1 ;;
      [1-9]) if [[ $key -le $n ]]; then cur=$((key - 1)); [[ $n -le 9 ]] && break; fi ;;
      '') break ;;
    esac
    printf '\033[%dA' "$n"; draw
  done
  printf '\033[?25h'
  CHOICE=$cur
}

# pick_user — выбор пользователя; имя в PICKED
PICKED=""
pick_user() {
  local labels=() names=() name status used limit expire _ipl _ru _rp ic
  while IFS=$'\t' read -r name status used limit expire _ipl _ru _rp; do
    case $status in active) ic="🟢" ;; disabled) ic="⚫" ;; expired) ic="⌛" ;; limit) ic="🚫" ;; *) ic="❔" ;; esac
    names+=("$name")
    if [[ $limit -gt 0 ]]; then labels+=("$ic $(pad "$name" 16) $(hbytes "$used") / $(hbytes "$limit")"); else labels+=("$ic $(pad "$name" 16) $(hbytes "$used")"); fi
  done < <(user_summary)
  [[ ${#names[@]} -gt 0 ]] || { warn "Пользователей нет."; return 1; }
  choose "${1:-Выберите пользователя}" "${labels[@]}" || return 1
  PICKED=${names[$CHOICE]}
}

