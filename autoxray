        ]
        + [$S.nodes[] | {vlessRoute: (.id | tostring), outboundTag: ("proxy-" + (.id | tostring))}]
        + [{inboundTag: ["RUsocks5"], balancerTag: "Super_Balancer"},
           {network: "tcp,udp", balancerTag: "Super_Balancer"}]
      )
    }
  }
JQ
)

render_xray_json() {
  local prog="$SERVER_COMMON"$'\n'"$XRAY_JQ"
  [[ $(mode) == bridge ]] && prog="$SERVER_COMMON"$'\n'"$BRIDGE_COMMON"$'\n'"$BRIDGE_JQ"
  [[ -f $BANS ]] || echo '[]' >"$BANS"
  jq -n --slurpfile s "$STATE" --slurpfile t "$TRAFFIC" --slurpfile b "$BANS" --argjson now "$(now)" \
    --arg dummy_id "$(new_uuid)" --arg dummy_auth "$(rand 'a-f0-9' 16)" "$prog"
}

xray_group() {
  local u g
  u=$(systemctl show xray -p User --value 2>/dev/null); u=${u:-nobody}
  g=$(id -gn "$u" 2>/dev/null) || g=""
  echo "$g"
}

# Применяет config.json: проверка через `xray run -test`, откат при ошибке,
# перезапуск только если файл действительно изменился.
apply_xray() {
  local new rc=0 grp
  new=$(mktemp --suffix=.json) || die "mktemp"
  render_xray_json >"$new" || { rm -f "$new"; die "Не удалось собрать config.json"; }
  if [[ -f $XRAY_CFG ]] && cmp -s "$new" "$XRAY_CFG"; then rm -f "$new"; return 0; fi
  if command -v xray >/dev/null 2>&1; then
    if ! xray run -test -c "$new" >/tmp/autoxray-test.log 2>&1; then
      warn "Xray отклонил новый конфиг, изменения НЕ применены. Лог: /tmp/autoxray-test.log"
      tail -n 5 /tmp/autoxray-test.log >&2
      rm -f "$new"; return 1
    fi
  fi
  [[ -f $XRAY_CFG ]] && cp -p "$XRAY_CFG" "$XRAY_CFG.bak"
  mkdir -p "$(dirname "$XRAY_CFG")"
  cat "$new" >"$XRAY_CFG"; rm -f "$new"
  grp=$([[ $DRY == 1 ]] && echo "" || xray_group)
  if [[ -n $grp ]]; then chown "root:$grp" "$XRAY_CFG"; chmod 640 "$XRAY_CFG"; else chmod 644 "$XRAY_CFG"; fi
  svc restart xray || rc=1
  # устройство WireGuard создаётся при первом запросе: прогреваем сразу после перезапуска
  if [[ $DRY != 1 && $(st '.warp.enabled // false') == true ]]; then ( sleep 3; warp_warm ) >/dev/null 2>&1 9>&- & fi
  return $rc
}

# ----------------------------------------------------- клиентские конфиги

EXTRA='%7B%22noGRPCHeader%22%3Afalse%2C%22xPaddingBytes%22%3A%22150-400%22%2C%22scMaxEachPostBytes%22%3A500000%2C%22scMinPostsIntervalMs%22%3A%225-15%22%2C%22scMaxBufferedPosts%22%3A20%2C%22scStreamUpServerSecs%22%3A%2290-180%22%2C%22xmux%22%3A%7B%22maxConcurrency%22%3A%222-4%22%2C%22cMaxReuseTimes%22%3A%22800-1500%22%2C%22hMaxReusableSecs%22%3A%22900-1200%22%7D%7D'

# Печатает «название|ссылка» по строке на каждый протокол.
user_links() {
  jq -r --arg n "$1" --arg ex "$EXTRA" "$BRIDGE_COMMON"'
    def xl($S; $id; $u; $tag): "vless://\(route_uuid($u.uuid; $id))@\($S.domain):443?security=tls&alpn=h2&type=xhttp&mode=stream-up&path=%2F\($S.paths.xhttp)&extra=\($ex)&sni=\($S.domain)&fp=\($S.fingerprint)#\($tag | @uri)";
    . as $S | ($S.users[] | select(.name == $n)) as $u
    | if $S.mode == "bridge" then
        (if ($S.nodes | length) > 1 then "🇷🇺 RU>EU Автобалансир|\(xl($S; 0; $u; "RU>EU Автобалансир"))" else empty end),
        ($S.nodes[] as $x
         | "XHTTP TLS stream-up (RU>EU \($x.name))|\(xl($S; $x.id; $u; "RU>EU_xhttp_" + $x.name))",
           "RAW VISION (RU>EU \($x.name))|vless://\(route_uuid($u.uuid; $x.id))@\($S.domain):443?security=tls&type=tcp&headerType=&path=&host=&flow=xtls-rprx-vision&sni=\($S.domain)&fp=\($S.fingerprint)&spx=%2F#\("RU>EU_raw_" + $x.name | @uri)",
           "Direct EU (\($x.name))|\($x.url)")
      else
        "VLESS XHTTP TLS stream-up|vless://\($u.uuid)@\($S.domain):443?security=tls&alpn=h2&type=xhttp&mode=stream-up&path=%2F\($S.paths.xhttp)&extra=\($ex)&sni=\($S.domain)&fp=\($S.fingerprint)#vlessXHTTPtls-\($u.name)",
        "VLESS RAW TLS VISION|vless://\($u.uuid)@\($S.domain):443?security=tls&type=tcp&headerType=&path=&host=&flow=xtls-rprx-vision&sni=\($S.domain)&fp=\($S.fingerprint)&spx=%2F#vlessRAWtlsVision-\($u.name)",
        "HYSTERIA2|hy2://\($u.hy2)@\($S.domain):443/?sni=\($S.domain)&alpn=h3#Hysteria2-\($u.name)"
      end
  ' "$STATE"
}

