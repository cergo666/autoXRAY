  report_build "$name" >/dev/null 2>&1
  f="$REPORT_WEB/$(report_user_token "$name")/index.html"
  [[ -s $f ]] || { tg_send "$chat" "❌ Не удалось собрать отчёт"; return 0; }
  # сводка текстом: читается в самом чате, не зависит от того, чем телефон открывает html
  tg_send "$chat" "$(report_summary "$name" | head -c 3800)"
  tg_document "$chat" "$f" "📎 Полный отчёт <b>$name</b> на $(date '+%F %H:%M'). Лучше открывать в браузере (Chrome, Firefox, Safari)" "report-$name-$(date +%F).html"
  tg_send "$chat" "🔗 Тот же отчёт по ссылке: $(report_url "$name")"
}

bot_show_user() { # chat message_id|"" имя
  local card kb
  card=$(bot_user_card "$3") || { tg_send "$1" "Пользователь не найден."; return 0; }
  kb=$(bot_user_kb "$3")
  if [[ -n $2 ]]; then tg_edit "$1" "$2" "$card" "$kb"; else tg_send "$1" "$card" "$kb"; fi
}
bot_show_list() { # chat message_id|""
  local text="👥 <b>Пользователи</b>" kb; kb=$(bot_list_kb)
  if [[ -n $2 ]]; then tg_edit "$1" "$2" "$text" "$kb"; else tg_send "$1" "$text" "$kb"; fi
}

bot_report_text() { # результат bot_do
  if [[ $BOT_RC -eq 0 ]]; then echo "✅ Готово"; else printf '❌ <pre>%s</pre>' "$(html_esc <<<"${BOT_OUT:0:900}")"; fi
}

bot_callback() { # chat message_id callback_id data
  local chat=$1 mid=$2 cbid=$3 data=$4 a b c d name
  IFS=: read -r a b c d <<<"$data"
  tg_answer "$cbid"
  case $a in
    bc) if [[ $b == ok && -s $AX_ETC/.broadcast.txt ]]; then bot_broadcast_send "$chat"; else rm -f "$AX_ETC/.broadcast.txt"; tg_send "$chat" "Рассылка отменена."; fi ;;
    list) bot_show_list "$chat" "$mid" ;;
    new) tg_send "$chat" "Создайте пользователя: <code>/add имя [ГБ] [дней]</code>" ;;
    status) bot_do cmd_status; tg_send "$chat" "$(printf '%s' "$BOT_OUT" | tg_pre)" "$BOT_MAIN_KB" ;;
    doctor) bot_do cmd_doctor; tg_send "$chat" "$(printf '%s' "$BOT_OUT" | tg_pre)" ;;
    warp) bot_do cmd_warp status; tg_send "$chat" "$(printf '%s' "$BOT_OUT" | tg_pre)" ;;
    u)
      name=$b; valid_name "$name" && [[ -n $(user_get "$name") ]] || { tg_send "$chat" "Пользователь не найден."; return 0; }
      case $c in
        "") bot_show_user "$chat" "$mid" "$name" ;;
        links) tg_send "$chat" "$(bot_links_text "$name")" ;;
        qr) bot_send_qr "$chat" "$name" ;;
        lim) [[ $d =~ ^[0-9]+$ ]] || return 0; bot_do locked cmd_user_set "$name" --limit "$d"; bot_show_user "$chat" "$mid" "$name" ;;
        tog) if [[ $(jq -r --arg n "$name" '.users[] | select(.name == $n) | .enabled' "$STATE") == true ]]
             then bot_do locked cmd_user_set "$name" --disable; else bot_do locked cmd_user_set "$name" --enable; fi
             bot_show_user "$chat" "$mid" "$name" ;;
        rot) tg_edit "$chat" "$mid" "🔁 Выпустить новые ключи для <b>$name</b>? Старая ссылка перестанет работать." "$(bot_confirm_kb "u:$name:rotok" "u:$name")" ;;
        rotok) bot_do locked cmd_user_rotate "$name"; tg_send "$chat" "$(bot_report_text)"; [[ $BOT_RC -eq 0 ]] && tg_send "$chat" "$(bot_links_text "$name")" ;;
        del) tg_edit "$chat" "$mid" "🗑 Удалить <b>$name</b> без возможности восстановления?" "$(bot_confirm_kb "u:$name:delok" "u:$name")" ;;
        delok) bot_do locked cmd_user_del "$name"; tg_send "$chat" "$(bot_report_text)"; bot_show_list "$chat" "$mid" ;;
        rep) if [[ $(jq -r --arg n "$name" '.users[] | select(.name == $n) | (.report // false)' "$STATE") == true ]]
             then tg_edit "$chat" "$mid" "📈 Отчёт о посещениях <b>$name</b>" "$(jq -nc --arg n "$name" '{inline_keyboard: [[{text: "📎 Файл HTML", callback_data: "u:\($n):repsend"}, {text: "🔗 Ссылка", callback_data: "u:\($n):replink"}], [{text: "⏸ Выключить", callback_data: "u:\($n):repoffq"}], [{text: "⬅️ Назад", callback_data: "u:\($n)"}]]}')"
             else tg_edit "$chat" "$mid" "📈 Включить отчёт о посещениях <b>$name</b>? Будут записываться сайты и IP, на которые он заходит. Предупредите пользователя." "$(bot_confirm_kb "u:$name:repon" "u:$name")"; fi ;;
        inv) bot_do locked cmd_user_invite "$name"; tg_send "$chat" "$(printf '✉️ Приглашение для <b>%s</b> (7 дней, одноразовое). Отправьте эту ссылку клиенту:\n%s' "$name" "$(printf '%s' "$BOT_OUT" | grep -o 'https://t.me/[^ ]*' | head -n1)")" ;;
        repsend) bot_send_report "$chat" "$name" ;;
        replink) tg_send "$chat" "📈 $name: $(report_url "$name")" ;;
        repoffq) tg_edit "$chat" "$mid" "📈 Выключить отчёт о посещениях <b>$name</b> и удалить страницу?" "$(bot_confirm_kb "u:$name:repoff" "u:$name:rep")" ;;
        repon) bot_do locked cmd_user_set "$name" --report on; tg_send "$chat" "$(bot_report_text)"
               [[ $BOT_RC -eq 0 ]] && tg_send "$chat" "📈 Отчёт включён. Данные накапливаются со следующей минуты, страница: $(report_url "$name")"
               bot_show_user "$chat" "$mid" "$name" ;;
        repoff) bot_do locked cmd_user_set "$name" --report off; bot_show_user "$chat" "$mid" "$name" ;;
      esac ;;
  esac
}

bot_command() { # chat текст
  local chat=$1 text=$2 cmd rest a name
  read -r cmd rest <<<"$text"; cmd=${cmd%%@*}; read -ra a <<<"$rest"; name=${a[0]:-}
  need_name() { valid_name "$name" && [[ -n $(user_get "$name") ]] || { tg_send "$chat" "Укажите существующего пользователя: <code>$cmd имя</code>"; return 1; }; }
  case $cmd in
    /start|/help) tg_send "$chat" "$(bot_help)" "$BOT_MAIN_KB" ;;
    /status) bot_do cmd_status; tg_send "$chat" "$(printf '%s' "$BOT_OUT" | tg_pre)" "$BOT_MAIN_KB" ;;
    /users) bot_show_list "$chat" "" ;;
    /user) need_name && bot_show_user "$chat" "" "$name" ;;
    /add)
      valid_name "$name" || { tg_send "$chat" "Имя: латиница, цифры, _ и -, до 24 символов. Пример: <code>/add anna 50 30</code>"; return 0; }
      [[ -z $(user_get "$name") ]] || { tg_send "$chat" "Такой пользователь уже есть."; return 0; }
      local args=()
      [[ -n ${a[1]:-} ]] && { is_num "${a[1]}" || { tg_send "$chat" "ГБ: число"; return 0; }; args+=(--limit "${a[1]}"); }
      [[ -n ${a[2]:-} ]] && { is_num "${a[2]}" || { tg_send "$chat" "Дней: число"; return 0; }; args+=(--days "${a[2]}"); }
      bot_do locked cmd_user_add "$name" "${args[@]}"
      if [[ $BOT_RC -eq 0 ]]; then tg_send "$chat" "✅ Пользователь <b>$name</b> создан"; bot_show_user "$chat" "" "$name"; tg_send "$chat" "$(bot_links_text "$name")"
      else tg_send "$chat" "$(bot_report_text)"; fi ;;
    /link) need_name && tg_send "$chat" "$(bot_links_text "$name")" ;;
    /limit) need_name || return 0; is_num "${a[1]:-}" || { tg_send "$chat" "Пример: <code>/limit $name 50</code>"; return 0; }
      bot_do locked cmd_user_set "$name" --limit "${a[1]}"; tg_send "$chat" "$(bot_report_text)" ;;
    /days) need_name || return 0; [[ ${a[1]:-} =~ ^[0-9]+$ ]] || { tg_send "$chat" "Пример: <code>/days $name 30</code>"; return 0; }
      bot_do locked cmd_user_set "$name" --days "${a[1]}"; tg_send "$chat" "$(bot_report_text)" ;;
    /ips) need_name || return 0; [[ ${a[1]:-} =~ ^[0-9]+$ ]] || { tg_send "$chat" "Пример: <code>/ips $name 3</code>"; return 0; }
      bot_do locked cmd_user_set "$name" --ips "${a[1]}"; tg_send "$chat" "$(bot_report_text)" ;;
    /ru) need_name || return 0; [[ ${a[1]:-} =~ ^(direct|server)$ ]] || { tg_send "$chat" "Пример: <code>/ru $name server</code>"; return 0; }
      bot_do locked cmd_user_set "$name" --ru "${a[1]}"; tg_send "$chat" "$(bot_report_text)" ;;
    /report) need_name || return 0
      if [[ -z ${a[1]:-} ]]; then bot_send_report "$chat" "$name"
      elif [[ ${a[1]} =~ ^(on|off)$ ]]; then bot_do locked cmd_user_set "$name" --report "${a[1]}"; tg_send "$chat" "$(bot_report_text)"
      else tg_send "$chat" "Пример: <code>/report $name</code> (прислать отчёт) или <code>/report $name on|off</code>"; fi ;;
    /trust) need_name || return 0; valid_trust "${a[1]:-}" || { tg_send "$chat" "Пример: <code>/trust $name 203.0.113.5</code> или сеть <code>/trust $name 203.0.113.0/24</code>"; return 0; }
      bot_do locked cmd_user_set "$name" --trust "${a[1]}"; tg_send "$chat" "$(bot_report_text)" ;;
    /untrust) need_name || return 0; [[ -n ${a[1]:-} ]] || { tg_send "$chat" "Пример: <code>/untrust $name 203.0.113.5</code> или <code>all</code>"; return 0; }
      bot_do locked cmd_user_set "$name" --untrust "${a[1]}"; tg_send "$chat" "$(bot_report_text)" ;;
    /backup) bot_send_backup "$chat" ;;
    /invite) need_name || return 0; bot_do locked cmd_user_invite "$name"
      if [[ $BOT_RC -eq 0 ]]; then tg_send "$chat" "$(printf '✉️ Приглашение для <b>%s</b> (7 дней, одноразовое). Отправьте эту ссылку клиенту:\n%s' "$name" "$(printf '%s' "$BOT_OUT" | grep -o 'https://t.me/[^ ]*' | head -n1)")"; else tg_send "$chat" "$(bot_report_text)"; fi ;;
    /unlink) need_name || return 0; bot_do locked cmd_user_unlink "$name"; tg_send "$chat" "$(bot_report_text)" ;;
    /note) need_name || return 0; bot_do locked cmd_user_set "$name" --note "${rest#"$name"}"; tg_send "$chat" "$(bot_report_text)" ;;
    /tags) need_name || return 0; bot_do locked cmd_user_set "$name" --tags "${a[1]:-}"; tg_send "$chat" "$(bot_report_text)" ;;
    /hide) need_name || return 0; [[ ${a[1]:-} =~ ^(xhttp|vision|hy2)$ ]] || { tg_send "$chat" "Пример: <code>/hide $name hy2</code> (xhttp, vision или hy2)"; return 0; }
      bot_do locked cmd_user_set "$name" --hide "${a[1]}"; tg_send "$chat" "$(bot_report_text)" ;;
    /show) need_name || return 0; [[ ${a[1]:-} =~ ^(xhttp|vision|hy2|all)$ ]] || { tg_send "$chat" "Пример: <code>/show $name hy2</code> или <code>all</code>"; return 0; }
      bot_do locked cmd_user_set "$name" --show "${a[1]}"; tg_send "$chat" "$(bot_report_text)" ;;
    /find) [[ -n $rest ]] || { tg_send "$chat" "Пример: <code>/find мама</code> (ищет в имени, заметке и метках)"; return 0; }
      bot_do cmd_user_list --find "$rest"; tg_send "$chat" "$(printf '%s' "$BOT_OUT" | tg_pre)" ;;
    /broadcast) bot_broadcast_ask "$chat" "$rest" ;;
    /enable) need_name || return 0; bot_do locked cmd_user_set "$name" --enable; bot_show_user "$chat" "" "$name" ;;
    /disable) need_name || return 0; bot_do locked cmd_user_set "$name" --disable; bot_show_user "$chat" "" "$name" ;;
    /del) need_name || return 0; tg_send "$chat" "🗑 Удалить <b>$name</b> без возможности восстановления?" "$(bot_confirm_kb "u:$name:delok" "u:$name")" ;;
    /stats) bot_do cmd_stats; tg_send "$chat" "$(printf '%s' "$BOT_OUT" | tg_pre)" ;;
    /doctor) bot_do cmd_doctor; tg_send "$chat" "$(printf '%s' "$BOT_OUT" | tg_pre)" ;;
    /warp) bot_do cmd_warp status; tg_send "$chat" "$(printf '%s' "$BOT_OUT" | tg_pre)" ;;
    *) tg_send "$chat" "Не знаю такой команды. /help" ;;
  esac
}

# --- режим клиента: пользователь с привязанным Telegram видит только свои данные

user_by_tg() { jq -r --argjson i "$1" '[.users[] | select((.tg // null) == $i) | .name][0] // empty' "$STATE"; }

bot_client_card() { # имя
  local line name status used limit expire _ icon label pct="" left="∞"
  line=$(user_summary | awk -F'\t' -v n="$1" '$1 == n') || true
  [[ -n $line ]] || return 1
  IFS=$'\t' read -r name status used limit expire _ <<<"$line"
  case $status in active) icon="🟢"; label="доступ открыт" ;; disabled) icon="⚫"; label="доступ отключён" ;; expired) icon="⌛"; label="срок истёк" ;; limit) icon="🚫"; label="лимит трафика исчерпан" ;; *) icon="❔"; label=$status ;; esac
  [[ $limit -gt 0 ]] && pct=" ($(( used * 100 / limit ))%)"
  [[ $expire -gt 0 ]] && left="до $(hdate "$expire") (дней: $(days_left "$expire"))"
  printf '👤 <b>%s</b>  %s %s\n📊 Использовано: %s%s%s\n⏳ Срок: %s' "$name" "$icon" "$label" "$(hbytes "$used")" "$([[ $limit -gt 0 ]] && echo " из $(hbytes "$limit")")" "$pct" "$left"
}

BOT_CLIENT_KB='{"inline_keyboard":[[{"text":"📊 Мой трафик","callback_data":"c:me"},{"text":"🔗 Ссылки","callback_data":"c:links"}],[{"text":"📷 QR подписки","callback_data":"c:qr"}]]}'

bot_client() { # chat имя текст cbid data
  local chat=$1 name=$2 text=$3 cbid=$4 data=$5 cmd
  if [[ -n $cbid ]]; then
    tg_answer "$cbid"; cmd=${data#c:}
  else cmd=${text%% *}; cmd=${cmd%%@*}; fi
  case $cmd in
    me|/me|/start|/menu) tg_send "$chat" "$(bot_client_card "$name")" "$BOT_CLIENT_KB" ;;
    links|/link|/links) tg_send "$chat" "$(bot_links_text "$name")" ;;
    qr|/qr) bot_send_qr "$chat" "$name" ;;
    *) tg_send "$chat" "Вам доступны: /me (трафик и срок), /link (ссылки), /qr (QR подписки)." "$BOT_CLIENT_KB" ;;
  esac
}

# Привязка по приглашению. Неверные коды считаются: после пяти ошибок за час бот молчит.
bot_invite_redeem() { # chat uid код имя_в_telegram
  local chat=$1 uid=$2 code=$3 who=$4 f="$AX_ETC/.invite-fails" name t; t=$(now)
  touch "$f"
  [[ $(awk -v u="$uid" -v t="$t" '$1 == u && t - $2 < 3600' "$f" | wc -l) -lt 5 ]] || return 0
  name=""
  [[ $code =~ ^[A-Za-z0-9]{16}$ ]] && name=$(jq -r --arg c "$code" --argjson t "$t" '[.users[] | select((.invite.code // "") == $c and (.invite.until // 0) > $t and (.tg // null) == null) | .name][0] // empty' "$STATE")
  if [[ -z $name ]]; then
    printf '%s %s\n' "$uid" "$t" >>"$f"
    tg_send "$chat" "Приглашение недействительно или просрочено. Попросите у администратора новое."; return 0
  fi
  locked bot_bind_user "$name" "$uid"
  tg_send "$chat" "✅ Готово, вы подключены как <b>$name</b>." "$BOT_CLIENT_KB"
  tg_send "$chat" "$(bot_client_card "$name")" "$BOT_CLIENT_KB"
  bot_notify "✈️ <b>$name</b> привязал(а) Telegram: $(html_esc <<<"$who") (ID <code>$uid</code>)"
}
bot_bind_user() { st_edit --arg n "$1" --argjson i "$2" '(.users[] | select(.name == $n)) |= (.tg = $i | del(.invite))'; }

# Уведомление самому клиенту (если привязан Telegram)
bot_notify_user() { # имя текст
  bot_enabled || return 0
  local tg; tg=$(jq -r --arg n "$1" '(.users[] | select(.name == $n) | .tg) // empty' "$STATE")
  [[ -n $tg ]] && { tg_send "$tg" "$2" "" 8 || true; }
  return 0
}

# Рассылка: текст сначала показывается администратору с числом получателей и отправляется после подтверждения
bot_broadcast_ask() { # chat текст
  local chat=$1 text=${2:0:1000} n
  [[ -n $text ]] || { tg_send "$chat" "Пример: <code>/broadcast Завтра с 02:00 до 03:00 возможны перебои</code>"; return 0; }
  n=$(jq '[.users[] | select(.enabled and ((.tg // null) != null))] | length' "$STATE")
  [[ $n -gt 0 ]] || { tg_send "$chat" "Нет клиентов с привязанным Telegram. Выдать приглашение: /invite имя"; return 0; }
  (umask 077; printf '%s' "$text" >"$AX_ETC/.broadcast.txt")
  tg_send "$chat" "$(printf '📢 Отправить %s клиент(ам) сообщение?\n\n<i>%s</i>' "$n" "$(html_esc <<<"$text")")" "$(bot_confirm_kb "bc:ok" "bc:no")"
}
bot_broadcast_send() { # chat
  local chat=$1 text n=0 tg
  text=$(<"$AX_ETC/.broadcast.txt"); rm -f "$AX_ETC/.broadcast.txt"
  for tg in $(jq -r '.users[] | select(.enabled and ((.tg // null) != null)) | .tg' "$STATE"); do
    tg_send "$tg" "$(printf '📢 <b>Сообщение от администратора</b>\n\n%s' "$(html_esc <<<"$text")")" "" 10 && n=$((n + 1)) || true
  done
  tg_send "$chat" "✅ Отправлено: $n"
}

bot_handle_update() { # json одного update
  local u=$1 uid chat ctype text cbid data mid
  uid=$(jq -r '(.message.from.id // .callback_query.from.id // empty)' <<<"$u")
  chat=$(jq -r '(.message.chat.id // .callback_query.message.chat.id // empty)' <<<"$u")
  ctype=$(jq -r '(.message.chat.type // .callback_query.message.chat.type // empty)' <<<"$u")
  text=$(jq -r '.message.text // empty' <<<"$u")
  cbid=$(jq -r '.callback_query.id // empty' <<<"$u"); data=$(jq -r '.callback_query.data // empty' <<<"$u")
  mid=$(jq -r '.callback_query.message.message_id // empty' <<<"$u")
  [[ -n $uid && -n $chat ]] || return 0
  # /id работает у всех: так проще узнать свой числовой ID для настройки
  if [[ $text == /id || $text == /id@* ]]; then tg_send "$chat" "Ваш Telegram ID: <code>$uid</code>"; return 0; fi
  [[ $ctype == private ]] || return 0                  # только личные чаты
  # приглашение может предъявить любой, у кого есть ссылка
  if [[ $text == "/start "* ]]; then
    bot_invite_redeem "$chat" "$uid" "$(printf '%s' "${text#/start }" | tr -d '[:space:]' | head -c 40)" "$(jq -r '(.message.from | (.first_name // "") + " @" + (.username // "-"))' <<<"$u")"
    return 0
  fi
  if ! bot_is_admin "$uid"; then                       # посторонним бот не отвечает, привязанным клиентам отвечает по-своему
    local cname; cname=$(user_by_tg "$uid")
    [[ -n $cname ]] && bot_client "$chat" "$cname" "$text" "$cbid" "$data"
    return 0
  fi
  if [[ -n $cbid ]]; then bot_callback "$chat" "$mid" "$cbid" "$data"
  elif [[ $text == /* ]]; then bot_command "$chat" "$text"; fi
}

cmd_bot_run() {
  need_state
  [[ -s $BOT_TOKEN_FILE ]] || die "Бот не настроен: autoxray bot setup"
  local off resp upd poll=${AX_TG_POLL:-50}
  off=$(cat "$AX_ETC/bot.offset" 2>/dev/null || echo 0)
  trap 'exit 0' TERM INT
  # Если файл autoxray заменили (self-update, ручная установка), бот выходит и systemd (Restart=always) запускает его заново:
  # так служба никогда не остаётся на старом коде.
  local me started; me=$(readlink -f "$0" 2>/dev/null || echo "$AX_BIN"); started=$(stat -c %Y "$me" 2>/dev/null || echo 0)
  echo "autoxray bot: запущен (long polling, администраторов: $(bot_admins | wc -l))"
  while true; do
    if [[ $(stat -c %Y "$me" 2>/dev/null || echo 0) != "$started" ]]; then echo "autoxray bot: скрипт обновлён, перезапуск"; exit 0; fi
    resp=$(tg_call getUpdates "$(jq -nc --argjson o "$off" --argjson t "$poll" '{offset: $o, timeout: $t, allowed_updates: ["message", "callback_query"]}')") || { sleep 5; continue; }
    jq -e '.ok == true' <<<"$resp" >/dev/null 2>&1 || { sleep 5; continue; }
    while IFS= read -r upd; do
      [[ -n $upd ]] || continue
      off=$(( $(jq -r '.update_id' <<<"$upd") + 1 ))
      printf '%s\n' "$off" >"$AX_ETC/bot.offset"
      ( bot_handle_update "$upd" ) || true
    done < <(jq -c '.result[]?' <<<"$resp")
  done
}

bot_write_unit() {
  mkdir -p "$(dirname "$BOT_UNIT")"
  cat >"$BOT_UNIT" <<EOF
[Unit]
Description=autoXRAY Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$AX_BIN bot run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
}

bot_setup() { # [--token T] [--admin ID] [--proxy URL]
  local tok="" adm="" prx="" me uname base resp first="" fn fid a was_active=0 real=$BOT_TOKEN_FILE
  # новый токен проверяется в отдельном файле: прежний рабочий бот не ломается, если новый не подошёл
  local BOT_TOKEN_FILE="$AX_ETC/.bot.token.new"
  while (($#)); do case $1 in --token) tok=${2:-}; shift ;; --admin) adm=${2:-}; shift ;; --proxy) prx=${2:-}; shift ;; esac; shift; done
  setup_fail() { rm -f "$BOT_TOKEN_FILE"; [[ $was_active == 1 ]] && svc start autoxray-bot; die "$1"; }
  if [[ -z $tok ]]; then
    echo -e " ${BOLD}1.${NC} Создайте бота у @BotFather (команда /newbot) и скопируйте токен."
    read -rsp "$(echo -e " ${BOLD}${CYAN}›${NC} Токен бота: ")" tok; echo
  fi
  [[ $tok =~ ^[0-9]+:[A-Za-z0-9_-]{20,}$ ]] || die "Это не похоже на токен бота (вид 123456:ABC...)"
  (umask 077; printf '%s\n' "$tok" >"$BOT_TOKEN_FILE")
  [[ -n $prx ]] && st_edit --arg p "$prx" '.bot = ((.bot // {}) + {proxy: $p})'
  me=$(tg_call getMe '{}' 20) || me=""
  jq -e '.ok == true' <<<"$me" >/dev/null 2>&1 \
    || setup_fail "Telegram не принял токен или api.telegram.org недоступен с этого сервера. Для доступа через прокси: --proxy socks5h://адрес:порт"
  uname=$(jq -r '.result.username' <<<"$me")
  if [[ -z $adm ]]; then
    # запущенная служба бота забирала бы сообщения себе (getUpdates у одного бота не делится)
    if [[ $DRY != 1 ]] && systemctl is-active --quiet autoxray-bot 2>/dev/null; then was_active=1; svc stop autoxray-bot; fi
    echo -e " ${BOLD}2.${NC} Откройте ${CYAN}https://t.me/$uname${NC} и отправьте боту любое сообщение. Жду до двух минут..."
    base=$(tg_call getUpdates '{"offset": -1, "timeout": 0}' 20 | jq -r '(.result[-1].update_id // 0)')
    for _ in $(seq 1 24); do
      resp=$(tg_call getUpdates "$(jq -nc --argjson o "$((base + 1))" '{offset: $o, timeout: 5, allowed_updates: ["message"]}')" 20) || continue
      first=$(jq -c '[.result[]? | select(.message.chat.type == "private")] | .[0] // empty' <<<"$resp")
      [[ -n $first ]] && break
    done
    [[ -n $first ]] || setup_fail "Сообщение не получено. Повторите: autoxray bot setup"
    fid=$(jq -r '.message.from.id' <<<"$first"); fn=$(jq -r '.message.from | (.first_name // "") + " " + ("@" + (.username // "-"))' <<<"$first")
    echo -e " Сообщение от ${BOLD}$fn${NC}, ID ${BOLD}$fid${NC}."
    confirm "Сделать этого пользователя администратором" || setup_fail "Отменено."
    adm=$fid
  fi
  [[ $adm =~ ^[0-9]+$ ]] || setup_fail "ID администратора: число"
  mv -f "$BOT_TOKEN_FILE" "$real"; BOT_TOKEN_FILE=$real
  st_edit --argjson a "$adm" --arg un "$uname" '.bot = ((.bot // {}) + {enabled: true, username: $un, admins: (((.bot.admins // []) + [$a]) | unique)})'
  bot_write_unit; svc daemon-reload; svc enable autoxray-bot; svc restart autoxray-bot
  tg_send "$adm" "✅ <b>autoXRAY</b>: бот подключён. Нажмите /help." "$BOT_MAIN_KB" 10 || true
  ok "✅ Бот @$uname настроен, администратор: $adm"
}

cmd_bot() {
  need_root; need_state
  local sub=${1:-status} a; shift || true
  case $sub in
    setup) bot_setup "$@" ;;
    run) cmd_bot_run ;;
    status)
      section "🤖 Telegram-бот"
      kv "🔌" "Состояние" "$(tick "$(st '.bot.enabled // false')") включён   служба: $(systemctl is-active autoxray-bot 2>/dev/null || echo "нет")"
      kv "👮" "Администраторы" "$(bot_admins | tr '\n' ' ')"
      if [[ -s $BOT_TOKEN_FILE ]]; then kv "🆔" "Бот" "@$(tg_call getMe '{}' 10 | jq -r '.result.username // "нет связи с Telegram"')"; fi
      echo -e " ${DIM}Настроить: autoxray bot setup. Администратор: bot add-admin <ID> (свой ID покажет команда /id в боте)${NC}" ;;
    on) [[ -s $BOT_TOKEN_FILE ]] || die "Сначала: autoxray bot setup"; st_edit '.bot.enabled = true'; bot_write_unit; svc daemon-reload; svc enable --now autoxray-bot; ok "✅ Бот включён" ;;
    off) st_edit '.bot.enabled = false'; svc disable --now autoxray-bot 2>/dev/null; ok "✅ Бот выключен" ;;
    add-admin) a=${1:-}; [[ $a =~ ^[0-9]+$ ]] || die "bot add-admin <числовой ID>"
      st_edit --argjson a "$a" '.bot.admins = (((.bot.admins // []) + [$a]) | unique)'; ok "✅ Администратор $a добавлен" ;;
    del-admin) a=${1:-}; [[ $a =~ ^[0-9]+$ ]] || die "bot del-admin <числовой ID>"
      st_edit --argjson a "$a" '.bot.admins = ((.bot.admins // []) - [$a])'; ok "✅ Администратор $a удалён" ;;
    proxy) [[ -n ${1:-} ]] || die "bot proxy <socks5h://адрес:порт | off>"
      if [[ $1 == off ]]; then st_edit '.bot.proxy = ""'; else st_edit --arg p "$1" '.bot.proxy = $p'; fi; ok "✅ Прокси для Telegram: $1" ;;
    backup)
      case ${1:-status} in
        pass) local p1 p2
              read -rsp "Новый пароль для копий (не короче 8 символов, запомните его: без него копию не открыть): " p1; echo
              [[ ${#p1} -ge 8 ]] || die "Пароль короче 8 символов."
              read -rsp "Повторите: " p2; echo; [[ $p1 == "$p2" ]] || die "Пароли не совпали."
              (umask 077; printf '%s' "$p1" >"$BACKUP_PASS_FILE"); ok "✅ Пароль задан. Копия в Telegram: /backup в боте или autoxray bot backup now" ;;
        now) bot_enabled || die "Бот не включён"; [[ -s $BACKUP_PASS_FILE ]] || die "Сначала задайте пароль: autoxray bot backup pass"
             local ad; for ad in $(bot_admins); do bot_send_backup "$ad"; done; ok "✅ Копия отправлена" ;;
        on) [[ -s $BACKUP_PASS_FILE ]] || die "Сначала задайте пароль: autoxray bot backup pass"; st_edit '.bot.backup_weekly = true'; ok "✅ Копия будет приходить раз в неделю" ;;
        off) st_edit '.bot.backup_weekly = false'; ok "✅ Автоматическая отправка выключена" ;;
        *) kv "🔑" "Пароль" "$([[ -s $BACKUP_PASS_FILE ]] && echo "${GRN}задан${NC}" || echo "${YEL}не задан${NC}")"
           kv "🗓" "Раз в неделю" "$(tick "$(st '.bot.backup_weekly // false')")"
           echo -e " ${DIM}autoxray bot backup pass | now | on | off${NC}" ;;
      esac ;;
    test) bot_enabled || die "Бот не включён"; bot_notify "🔔 Проверка уведомлений autoXRAY"; ok "✅ Отправлено" ;;
    remove) svc disable --now autoxray-bot 2>/dev/null; rm -f "$BOT_UNIT" "$BOT_TOKEN_FILE" "$AX_ETC/bot.offset" "$BACKUP_PASS_FILE"; st_edit 'del(.bot)'; svc daemon-reload; ok "✅ Бот удалён" ;;
    *) die "bot: setup | status | on | off | add-admin <ID> | del-admin <ID> | proxy <url|off> | backup pass|now|on|off | test | remove" ;;
  esac
}

# Полное удаление: Telegram Web Proxy, Xray, nginx, acme.sh, данные и сам autoxray.
cmd_uninstall() {
  need_root; need_state
  local web; web=$(st .web)
  warn "Будут удалены: Xray, nginx, acme.sh, сайт-маскировка ($web), Telegram Web Proxy, ключи и данные пользователей."
  warn "Сначала сделайте бэкап, если он может понадобиться: autoxray backup"
  read -rp "Для подтверждения введите yes: " a; [[ $a == yes ]] || die "Отменено."
  svc disable --now autoxray-bot 2>/dev/null; rm -f "$BOT_UNIT"
  [[ -f $TPL_DIR/telegram/uninstall.sh ]] && bash "$TPL_DIR/telegram/uninstall.sh" || true
  xray_installer remove --purge
  svc disable --now nginx 2>/dev/null; apt-get remove -y nginx >/dev/null 2>&1
  [[ -x $HOME/.acme.sh/acme.sh ]] && "$HOME/.acme.sh/acme.sh" --uninstall >/dev/null 2>&1
  # /var/lib/autoxray: снимки обновлений (в них ключи и пароли) и html-отчёты о посещениях
  rm -rf "$web" /var/lib/xray /var/lib/autoxray "${SNAP_DIR:?}" "${REPORT_WEB:?}" /usr/local/share/autoxray "$AX_ETC" "$NGX_MAP" /etc/cron.d/autoxray \
         /etc/sysctl.d/999-autoXRAY.conf /etc/security/limits.d/99-autoXRAY.conf /usr/local/bin/autoxray
  ok "✅ autoXRAY удалён."
}

