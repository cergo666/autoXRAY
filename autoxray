# Списки geosite, которых нет в установленном geosite.dat. Xray не запускается целиком, если в правилах есть неизвестный список
# (так бывает после смены источника гео-данных), поэтому такие списки из серверного конфига исключаются.
geo_missing() {
  local dat=${XRAY_LOCATION_ASSET:-/usr/local/share/xray}/geosite.dat c out=()
  [[ -f $dat ]] || { echo '[]'; return 0; }
  for c in category-ads win-spy private category-ru yandex vk category-ip-geo-detect; do
    grep -qiaF -- "$c" "$dat" || out+=("geosite:$c")
  done
  printf '%s\n' "${out[@]}" | jq -Rn '[inputs | select(length > 0)]'
}

render_xray_json() {
  local prog="$SERVER_COMMON"$'\n'"$XRAY_JQ"
  [[ $(mode) == bridge ]] && prog="$SERVER_COMMON"$'\n'"$BRIDGE_COMMON"$'\n'"$BRIDGE_JQ"
  [[ -f $BANS ]] || echo '[]' >"$BANS"
  # ключи-заглушки (когда активных пользователей нет) постоянны: иначе каждый render менял бы конфиг и перезапускал Xray
  local h; h=$(jq -r '"dummy:" + (.socks.pass // "") + (.domain // "")' "$STATE" | sha256sum)
  jq -n --slurpfile s "$STATE" --slurpfile t "$TRAFFIC" --slurpfile b "$BANS" --argjson now "$(now)" \
    --argjson geomiss "$(geo_missing)" --arg dummy_id "${h:0:8}-${h:8:4}-4${h:13:3}-8${h:17:3}-${h:20:12}" --arg dummy_auth "${h:32:16}" "$prog"
}

xray_group() {
  local u g
  u=$(systemctl show xray -p User --value 2>/dev/null); u=${u:-nobody}
  g=$(id -gn "$u" 2>/dev/null) || g=""
  echo "$g"
}

# Применяет config.json: проверка через `xray run -test`, откат при ошибке,
# перезапуск только если файл действительно изменился.
apply_xray() {
  local new rc=0 grp
  new=$(mktemp --suffix=.json) || die "mktemp"
  render_xray_json >"$new" || { rm -f "$new"; die "Не удалось собрать config.json"; }
  if [[ -f $XRAY_CFG ]] && cmp -s "$new" "$XRAY_CFG"; then rm -f "$new"; return 0; fi
  if command -v xray >/dev/null 2>&1; then
    if ! xray run -test -c "$new" >/tmp/autoxray-test.log 2>&1; then
      warn "Xray отклонил новый конфиг, изменения НЕ применены. Лог: /tmp/autoxray-test.log"
      tail -n 5 /tmp/autoxray-test.log >&2
      rm -f "$new"; return 1
    fi
  fi
  [[ -f $XRAY_CFG ]] && cp -p "$XRAY_CFG" "$XRAY_CFG.bak"
  mkdir -p "$(dirname "$XRAY_CFG")"
  cat "$new" >"$XRAY_CFG"; rm -f "$new"
  grp=$([[ $DRY == 1 ]] && echo "" || xray_group)
  if [[ -n $grp ]]; then chown "root:$grp" "$XRAY_CFG"; chmod 640 "$XRAY_CFG"; else chmod 644 "$XRAY_CFG"; fi
  svc restart xray || rc=1
  # устройство WireGuard создаётся при первом запросе: прогреваем сразу после перезапуска
  if [[ $DRY != 1 && $(st '.warp.enabled // false') == true ]]; then ( sleep 3; warp_warm ) >/dev/null 2>&1 9>&- & fi
  return $rc
}

