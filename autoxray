        },
        sniffing: sniff
      },
      {
        tag: "RUsocks5", port: 10443, listen: "127.0.0.1", protocol: "mixed",
        settings: {ip: "127.0.0.1", udp: true, auth: "password", accounts: [{user: $S.socks.user, pass: $S.socks.pass}]}
