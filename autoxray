# Профиль «Авто»: все доступные протоколы сразу, клиент сам выбирает самый быстрый отвечающий (leastPing) и уходит с упавшего.
# Теги исходящих начинаются с «proxy-», пока замеров нет, трафик идёт через первый.
def client_auto($proxies; $remark; $ru_direct; $R):
  client($proxies[0]; $remark; $ru_direct; $R)
  | .outbounds = ($proxies + [{tag: "direct", protocol: "freedom"}, {tag: "block", protocol: "blackhole"}])
  | .burstObservatory = {subjectSelector: ["proxy-"], pingConfig: {destination: "https://www.gstatic.com/generate_204", connectivity: "", interval: "1m", sampling: 3, timeout: "5s"}}
  | .routing.balancers = [{tag: "auto", selector: ["proxy-"], strategy: {type: "leastPing"}, fallbackTag: $proxies[0].tag}]
  | .routing.rules |= (map(if .outboundTag == "proxy" then del(.outboundTag) | .balancerTag = "auto" else . end) + [{network: "tcp,udp", balancerTag: "auto"}]);

# строка статуса: профиль без соединения, в названии остаток трафика и срок
def client_status($text; $R): client({tag: "proxy", protocol: "blackhole"}; $text; false; $R);
JQ
)

