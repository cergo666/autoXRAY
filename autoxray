bot_confirm_kb() { jq -nc --arg y "$1" --arg n "$2" '{inline_keyboard: [[{text: "✅ Да", callback_data: $y}, {text: "↩️ Отмена", callback_data: $n}]]}'; }

bot_list_kb() {
  local rows="[]" name status used limit expire ipl ru rpt ic lbl
  while IFS=$'\t' read -r name status used limit expire ipl ru rpt; do
    case $status in active) ic="🟢" ;; disabled) ic="⚫" ;; expired) ic="⌛" ;; limit) ic="🚫" ;; *) ic="❔" ;; esac
    lbl="$ic $name  $(hbytes "$used")"; [[ $limit -gt 0 ]] && lbl+=" / $(hbytes "$limit")"
    rows=$(jq -c --arg t "$lbl" --arg d "u:$name" '. + [[{text: $t, callback_data: $d}]]' <<<"$rows")
  done < <(user_summary)
  jq -c '{inline_keyboard: (. + [[{text: "➕ Новый пользователь", callback_data: "new"}]])}' <<<"$rows"
}

# Выполняет CLI-действие в подпроцессе (die/exit не должны останавливать бота); вывод в BOT_OUT, код в BOT_RC
BOT_OUT=""; BOT_RC=0
bot_do() {
  local out; out=$( ( "$@" ) 2>&1; echo "@@RC=$?" )
  BOT_RC=${out##*@@RC=}; BOT_OUT=$(printf '%s' "${out%@@RC=*}" | strip_ansi)
}

