# Зашифрованная копия настроек админу в Telegram. Без пароля (autoxray bot backup pass) не отправляется:
# в архиве ключи и пароли, а Telegram хранит файлы на своих серверах.
bot_send_backup() { # chat
  local chat=$1 d f size
  [[ -s $BACKUP_PASS_FILE ]] || { tg_send "$chat" "Сначала задайте пароль для копий на сервере: <code>autoxray bot backup pass</code>. Без пароля архив с ключами в Telegram не отправляется."; return 0; }
  d=$(mktemp -d); chmod 700 "$d"
  f="$d/autoxray-$(st .domain)-$(date +%F).tar.gz.enc"
  if backup_make "$d/b.tar.gz" && backup_encrypt "$d/b.tar.gz" "$f"; then
    size=$(stat -c %s "$f")
    if [[ $size -gt 49000000 ]]; then tg_send "$chat" "Копия весит $(hbytes "$size"), больше лимита Telegram (50 МБ). Сделайте на сервере: <code>autoxray backup</code>"
    else tg_document "$chat" "$f" "💾 Копия настроек autoXRAY, $(date +%F). Зашифрована паролем бэкапов. Восстановление: <code>autoxray restore файл</code>"; fi
  else tg_send "$chat" "❌ Не удалось собрать копию"; fi
  rm -rf "$d"
}

