        off) st_edit '.torrent.alert = false'; locked apply_or_die; ok "✅ Уведомления о торрентах выключены" ;;
        *) die "torrent alert on|off" ;;
      esac ;;
    status|*) section "🧲 Торренты"
      kv "🚫" "Блокировка на сервере" "${GRN}всегда включена${NC} ${DIM}(сервер режет BitTorrent)${NC}"
      kv "🔔" "Уведомления" "$(tick "$(st '.torrent.alert // false')") ${DIM}torrent alert on|off${NC}"
      echo -e " ${DIM}Подписки autoXRAY отправляют торрент напрямую с устройства, поэтому на сервере виден только трафик клиентов без такой маршрутизации (ссылки vless:// в роутерах).${NC}" ;;
  esac
