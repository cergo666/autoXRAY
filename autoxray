      "➕ Добавить домен в WARP" "➖ Убрать домен из WARP" "🔎 Проверить работу" "⚡ Найти самый быстрый endpoint" "🌙 Ночная проверка и глубина сканирования" "🧪 Отладка (отчёт для разбора проблем)" "🚇 Транспорт: MASQUE или WireGuard" "🔙 Назад" || return 0
    case $CHOICE in
      0) (cmd_warp on); pause ;;
      1) (cmd_warp off); pause ;;
      2) (cmd_warp ru on); pause ;;
      3) (cmd_warp ru off); pause ;;
      4) dom=$(ask "Домен, например chatgpt.com"); [[ -n $dom ]] && (cmd_warp add "$dom"); pause ;;
      5) mapfile -t doms < <(jq -r '(.warp.domains // [])[]' "$STATE")
         if [[ ${#doms[@]} -eq 0 ]]; then warn "Список доменов пуст."; else choose "Какой домен убрать" "${doms[@]}" && (cmd_warp del "${doms[$CHOICE]}"); fi; pause ;;
      6) (cmd_warp check); pause ;;
      7) (cmd_warp scan --apply); pause ;;
      8) menu_warp_scan ;;
      9) (cmd_warp debug); pause ;;
      10) echo -e " ${DIM}MASQUE (экспериментально): WARP через HTTP/3 на порту 443 вместо WireGuard на 2408. Если туннель не заработает, вернётся WireGuard.${NC}"
          if choose "Транспорт WARP" "🚇 MASQUE" "🛡 WireGuard" "🔙 Отмена" && [[ $CHOICE -lt 2 ]]; then
            if [[ $CHOICE == 0 ]]; then (cmd_warp transport masque); else (cmd_warp transport wireguard); fi
          fi; pause ;;
      11) return 0 ;;
    esac
  done
}

menu_update() {
  local latest newer
  while true; do
    clear; section "📦 Обновления"; echo
    latest=$(latest_ax)
    kv "🔐" "autoxray" "${BOLD}$AX_VERSION${NC} $(ver_gt "$latest" "$AX_VERSION" && echo -e "${GRN}→ доступна $latest${NC}" || echo -e "${DIM}последняя версия${NC}")"
    kv "⚙️ " "Xray" "${BOLD}$(xray_version)${NC} ${DIM}(проверено с релизом: $XRAY_TESTED)${NC}"
    echo
    choose "Что обновить" "📦 autoxray (скрипты и шаблоны)" "⚙️  Ядро Xray: версии и обновление" "🗺 Гео-данные (geoip, geosite)" "🕘 Откат к предыдущей версии" "🔙 Назад" || return 0
    case $CHOICE in
      0) (cmd_self_update); pause ;;
      1) newer=$(core_newer)
         clear; cmd_core list; echo
         if [[ -n $newer ]]; then
           local tags=() labels=() t pre
           while IFS=$'\t' read -r t pre; do tags+=("$t"); if [[ $pre == true ]]; then labels+=("$t   🧪 пререлиз"); else labels+=("$t"); fi; done <<<"$newer"
           if choose "Установить версию (после подтверждения)" "${labels[@]}" "🔙 Не обновлять"; then
             [[ $CHOICE -lt ${#tags[@]} ]] && (cmd_core update "${tags[$CHOICE]}")
           fi
         fi; pause ;;
      2) (cmd_geo_update); pause ;;
      3) (cmd_rollback); pause ;;
      4) return 0 ;;
    esac
  done
}

menu_bot() {
  local id
  while true; do
    clear; cmd_bot status; echo
    choose "Telegram-бот" "⚙️  Настроить (токен и первый администратор)" "➕ Добавить администратора по ID" "🔔 Тестовое уведомление" \
      "🟢 Включить" "🔴 Выключить" "🗑 Удалить бота" "🔙 Назад" || return 0
    case $CHOICE in
      0) (cmd_bot setup); pause ;;
      1) id=$(ask "Числовой Telegram ID (его покажет команда /id в боте)"); [[ -n $id ]] && (cmd_bot add-admin "$id"); pause ;;
      2) (cmd_bot test); pause ;;
      3) (cmd_bot on); pause ;;
      4) (cmd_bot off); pause ;;
      5) confirm "Удалить бота и токен" && (cmd_bot remove); pause ;;
      6) return 0 ;;
    esac
  done
}

menu_maint() {
  while true; do
    clear; section "🧰 Обслуживание"; echo
    choose "Обслуживание" "💾 Бэкап" "🔄 Применить конфиг заново" "🎨 Сайт-маскировка: новый случайный дизайн" "🕘 Откат к снимку перед обновлением" "🔙 Назад" || return 0
    case $CHOICE in
      0) (cmd_backup); pause ;;
      1) (cmd_render); pause ;;
      2) (cmd_site regenerate); pause ;;
      3) (cmd_rollback); pause ;;
      4) return 0 ;;
    esac
  done
}

menu() {
  need_state
  while true; do
    clear
    cmd_status
    echo
    choose "Главное меню" "👥 Пользователи" "📊 Статистика" "🌍 WARP" "🩺 Диагностика" "🤖 Telegram-бот" "📦 Обновления" \
      "🧰 Обслуживание" "🔥 Файрвол" "🚪 Выход" || exit 0
    case $CHOICE in
      0) menu_users ;;
      1) cmd_stats; pause ;;
      2) if [[ $(mode) == direct ]]; then menu_warp; else warn "WARP недоступен в режиме моста."; pause; fi ;;
      3) (cmd_doctor); pause ;;
      4) menu_bot ;;
      5) menu_update ;;
      6) menu_maint ;;
      7) (cmd_firewall); pause ;;
      8) exit 0 ;;
    esac
  done
}

usage() {
  local H="${BOLD}${MAG}" C="${CYAN}" D="${DIM}" N="${NC}"
  echo -e "${BOLD}🔐 autoxray $AX_VERSION${N} ${D}— управление autoXRAY${N}\n"
  echo -e "${H}Общее${N}"
  echo -e "  ${C}autoxray${N}                       меню"
  echo -e "  ${C}autoxray status${N}                состояние служб, сертификата, WARP"
  echo -e "  ${C}autoxray doctor${N}                🩺 диагностика сервера"
  echo -e "  ${C}autoxray stats${N}                 📊 трафик по пользователям"
  echo -e "${H}Пользователи${N}"
  echo -e "  ${C}autoxray user list${N} ${D}[--plain]${N}"
  echo -e "  ${C}autoxray user add${N} <имя> ${D}[--limit ГБ] [--days N] [--ips N] [--ru direct|server] [--reset monthly|weekly]${N}"
  echo -e "  ${C}autoxray user set${N} <имя> ${D}[--limit ГБ] [--days N] [--ips N] [--ru direct|server] [--reset monthly|weekly|never] [--hide hy2|xhttp|vision] [--show протокол|all] [--note текст] [--tags a,b] [--enable|--disable] [--reset-traffic]${N}"
  echo -e "  ${C}autoxray ips${N} ${D}[имя]${N}  ${C}unban${N} <имя|--all>   ${D}лимит устройств (IP) и блокировки${N}"
  echo -e "  ${C}autoxray user set${N} <имя> ${D}--trust 1.2.3.4|1.2.3.0/24  --untrust IP|all${N}   ${D}доверенные адреса: не считаются в лимите IP${N}"
  echo -e "  ${C}autoxray report${N} list|build [имя]|url <имя>|purge <имя>|keep <дней>   ${D}html-отчёты о посещениях (user set --report on)${N}"
  echo -e "  ${C}autoxray user find${N} <текст>  ${C}user list${N} --tag метка   ${D}поиск по имени, заметке и меткам${N}"
  echo -e "  ${C}autoxray route${N} list|add direct|proxy|block <домен|сеть>|del|preset push on|off   ${D}свои правила маршрутов в подписках${N}"
  echo -e "  ${C}autoxray torrent${N} alert on|off   ${D}уведомление в бот о попытках торрента через сервер${N}"
  echo -e "  ${C}autoxray sub statusnode${N} on|off   ${D}строка «осталось ... до ...» в подписках${N}"
  echo -e "  ${C}autoxray user del${N} <имя>        ${C}user rotate${N} <имя>  ${D}новые ключи и ссылка${N}"
  echo -e "  ${C}autoxray user link${N} <имя> ${D}[--plain]${N}  ${C}user qr${N} <имя> ${D}[sub|links|xhttp|vision|hy2]${N}"
  echo -e "${H}Сеть${N}"
  echo -e "  ${C}autoxray warp${N} register|on|off|status|check|add|del  ${C}warp debug${N} ${D}[--quick]${N} ${D}разбор проблем${N}"
  echo -e "  ${C}autoxray warp scan${N} ${D}[--apply] [--depth quick|more|all] [--colo FRA,AMS] [--exclude-colo DME]${N}  ${D}самый быстрый endpoint${N}"
  echo -e "  ${C}autoxray warp soak${N} ${D}[--apply] [--rounds N] [endpoint...]${N}  ${D}стабильность endpoint'ов${N}   ${C}warp renew${N} ${D}новое устройство Cloudflare${N}"
  echo -e "  ${C}autoxray warp transport${N} masque|wireguard   ${D}WARP через MASQUE (HTTP/3 на 443) вместо WireGuard, экспериментально${N}"
  echo -e "  ${C}autoxray warp coldtest${N} ${D}[--idle 200] [--site сайт]${N}  ${D}почему первый запрос после простоя медленный${N}"
  echo -e "  ${C}autoxray debug${N} on [минут]|show [сайт]|off   ${D}временный подробный лог (адреса видны, выключается сам)${N}"
  echo -e "  ${C}autoxray warp nightly${N} on|off  ${C}depth${N} quick|more|all  ${C}threshold${N} <мс>  ${C}rescan${N} now  ${C}hosts${N} <сайты>"
  echo -e "  ${C}autoxray warp ru${N} on|off        ${D}российские сайты через WARP${N}"
  echo -e "  ${C}autoxray node${N} add <vless://…>|del <имя|id>|list   ${D}(режим моста)${N}"
  echo -e "  ${C}autoxray fingerprint${N} <браузер> ${C}telegram${N} set <ссылка>|off|update|remove"
  echo -e "  ${C}autoxray bot${N} setup|status|on|off|add-admin|del-admin|proxy|test|remove   ${D}Telegram-бот администратора и уведомления${N}"
  echo -e "  ${C}autoxray site${N} status|regenerate|set <папка>   ${D}сайт-маскировка: новый дизайн или свой сайт${N}"
  echo -e "  ${C}autoxray firewall${N} [--dry-run]  ${D}🔥 настроить ufw (SSH, 80, 443)${N}"
  echo -e "${H}Обслуживание${N}"
  echo -e "  ${C}autoxray backup${N} [файл]  ${C}restore${N} <файл>  ${C}render${N}  ${D}пересобрать конфиги${N}"
  echo -e "  ${C}autoxray self-update${N} [vX.Y.Z]  ${C}rollback${N} ${D}[list|N]${N}  ${C}geo-update${N}   ${D}обновление со снимком и откатом при сбое${N}"
  echo -e "  ${C}autoxray core${N} list|update [версия]  ${D}ядро Xray: что установлено и что новее${N}"
  echo -e "  ${C}autoxray migrate${N} [имя]         ${D}перенос с autoXRAY 2${N}"
  echo -e "  ${C}autoxray uninstall${N}             ${D}удалить всё (с подтверждением)${N}"
  echo -e "  ${C}autoxray version${N}  ${C}collect${N} ${D}(cron: учёт трафика)${N}"
}

main() {
  local cmd=${1:-menu}; shift || true
  case $cmd in
    menu)         menu ;;
    status)       cmd_status ;;
    user|users)   cmd_users "$@" ;;
    stats)        cmd_stats ;;
    collect)      need_root; locked cmd_collect ;;
    warp)         cmd_warp "$@" ;;
    fingerprint)  cmd_fingerprint "$@" ;;
    telegram)     cmd_telegram "$@" ;;
    backup)       cmd_backup "$@" ;;
    restore)      cmd_restore "$@" ;;
    update-core)  cmd_core update "$@" ;;
    core)         cmd_core "$@" ;;
    render)       cmd_render ;;
    init)         cmd_init "$@" ;;
    migrate)      cmd_migrate "$@" ;;
    node|nodes)   cmd_node "$@" ;;
    self-update)  cmd_self_update "$@" ;;
    uninstall)    cmd_uninstall ;;
    selfcheck)    post_update_check ;;
    site)         cmd_site "$@" ;;
    bot)          cmd_bot "$@" ;;
    debug)        cmd_debug "$@" ;;
    rollback)     cmd_rollback "$@" ;;
    ipwatch)      need_root; locked cmd_ipwatch ;;
    report)       cmd_report "$@" ;;
    route)        cmd_route "$@" ;;
    torrent)      cmd_torrent "$@" ;;
    sub)          cmd_sub "$@" ;;
    ips)          cmd_ips "$@" ;;
    unban)        cmd_unban "$@" ;;
    setup-cron)   cmd_setup_cron ;;
    doctor)       cmd_doctor ;;
    geo-update)   need_root; cmd_geo_update "$@" ;;
    firewall)     cmd_firewall "$@" ;;
    -v|--version|version) echo "autoxray $AX_VERSION" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
