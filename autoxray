CLIENT_BRIDGE_TAIL=$(cat <<'JQ'
def xextra: {noGRPCHeader: false, xPaddingBytes: "150-400", scMaxEachPostBytes: 500000, scMinPostsIntervalMs: "5-15",
             scMaxBufferedPosts: 20, scStreamUpServerSecs: "90-180",
             xmux: {maxConcurrency: "2-4", cMaxReuseTimes: "800-1500", hMaxReusableSecs: "900-1200"}};
def via_xhttp($S; $u; $id): {mux: {concurrency: -1, enabled: false}, tag: "proxy", protocol: "vless",
  settings: {vnext: [{address: $S.domain, port: 443, users: [{id: route_uuid($u.uuid; $id), encryption: "none"}]}]},
  streamSettings: {network: "xhttp", security: "tls",
