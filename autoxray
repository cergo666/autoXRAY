# Раз в 5 минут из cron: забирает счётчики Xray (с обнулением), накапливает в traffic.json,
# отключает пользователей с исчерпанным лимитом или истёкшим сроком, обновляет страницы.
cmd_collect() {
  need_state
  local before after raw merged
  before=$(active_names)
  if command -v xray >/dev/null 2>&1; then
    raw=$(xray api statsquery -s "$API_ADDR" -pattern "user>>>" -reset 2>/dev/null) || raw=""
    if [[ -n $raw ]]; then
      merged=$(jq --slurpfile t "$TRAFFIC" '
        reduce (.stat[]? | select(.name | startswith("user>>>"))
                | {p: (.name | split(">>>")), v: ((.value | tonumber?) // 0)}) as $e
          ($t[0]; .[$e.p[1]][(if $e.p[3] == "uplink" then "up" else "down" end)] += $e.v)' <<<"$raw") \
        && printf '%s\n' "$merged" >"$TRAFFIC.tmp" && mv "$TRAFFIC.tmp" "$TRAFFIC"
    fi
  fi
  local due
  while IFS= read -r due; do
    [[ -n $due ]] || continue
    jq --arg n "$due" 'del(.[$n])' "$TRAFFIC" >"$TRAFFIC.tmp" && mv "$TRAFFIC.tmp" "$TRAFFIC"
    st_edit --arg n "$due" --argjson nr "$(next_month)" '(.users[] | select(.name == $n) | .next_reset) = $nr'
  done < <(jq -r --argjson now "$(now)" '.users[] | select((.reset // "never") == "monthly" and (.next_reset // 0) <= $now) | .name' "$STATE")
  latest_ax force >/dev/null
  after=$(active_names)
  if [[ $before != "$after" ]]; then apply_xray; fi
  render_subs
}

# --------------------------------------------------- узлы моста (EU)

# vless://UUID@host:port?type=..&security=tls|none&...#имя  ->  JSON узла (без id)
parse_vless() {
  local url=$1 body name="" uuid hp addr rest port q pair k v pairs extra
  declare -A P=()
  [[ $url == vless://* ]] || return 1
  body=${url#vless://}
  if [[ $body == *"#"* ]]; then name=$(urldecode "${body##*#}"); body=${body%%#*}; fi
  [[ $body == *"@"* ]] || return 1
  uuid=${body%@*}; hp=${body#*@}
  addr=${hp%%:*}; rest=${hp#*:}; port=${rest%%\?*}
  q=""; [[ $rest == *"?"* ]] && q=${rest#*\?}
  IFS='&' read -ra pairs <<<"$q"
  for pair in "${pairs[@]}"; do k=${pair%%=*}; v=${pair#*=}; P[$k]=$(urldecode "$v"); done
  [[ $uuid =~ ^[0-9a-fA-F-]{36}$ && -n $addr && $port =~ ^[0-9]+$ ]] || return 1
  [[ ${P[security]:-tls} =~ ^(tls|none)$ ]] || return 1
  extra=${P[extra]:-}
  if [[ -n $extra ]]; then jq -e . <<<"$extra" >/dev/null 2>&1 || return 1; fi
  jq -n --arg url "$url" --arg name "${name:-$addr}" --arg uuid "$uuid" --arg addr "$addr" --argjson port "$port" \
    --arg type "${P[type]:-xhttp}" --arg sec "${P[security]:-tls}" --arg path "${P[path]:-/}" --arg mode "${P[mode]:-auto}" \
    --arg extra "$extra" --arg sni "${P[sni]:-$addr}" --arg fp "${P[fp]:-firefox}" --arg alpn "${P[alpn]:-}" --arg flow "${P[flow]:-}" '
    {url: $url, name: $name, uuid: $uuid, addr: $addr, port: $port, type: $type, security: $sec, path: $path, mode: $mode,
     extra: $extra, sni: $sni, fp: $fp, alpn: (if $alpn == "" then ["h2", "http/1.1"] else ($alpn | split(",")) end), flow: $flow}'
}

cmd_node() {
  need_state
  [[ $(mode) == bridge ]] || die "Узлы есть только в режиме моста (установка: autoXRAY3.sh домен vless://...)."
  local sub=${1:-list}; shift || true
  case $sub in
    add) need_root
         local j; j=$(parse_vless "${1:-}") || die "Неверная vless-ссылка (нужен security=tls или none; REALITY не поддерживается)."
         st_edit --argjson n "$j" '.nodes += [$n + {id: (([.nodes[].id] | max // 0) + 1)}]'
         locked apply_or_die; ok "✅ Узел добавлен (подписки пользователей обновлены)." ;;
    del) need_root
         local k=${1:-}; [[ -n $k ]] || die "node del <имя|id>"
         [[ $(jq --arg k "$k" '[.nodes[] | select(.name == $k or (.id | tostring) == $k)] | length' "$STATE") -gt 0 ]] || die "Узел '$k' не найден."
         [[ $(jq --arg k "$k" '[.nodes[] | select(.name != $k and (.id | tostring) != $k)] | length' "$STATE") -gt 0 ]] || die "Нельзя удалить последний узел."
         st_edit --arg k "$k" '.nodes |= map(select(.name != $k and (.id | tostring) != $k))'
         locked apply_or_die; ok "✅ Узел удалён." ;;
    list|ls) section "🔀 Узлы моста (EU)"
             printf '%b   %s %s %s %s%b\n' "$DIM" "$(pad ID 4)" "$(pad УЗЕЛ 22)" "$(pad АДРЕС 32)" ТРАНСПОРТ "$NC"
             jq -r '.nodes[] | [(.id | tostring), .name, "\(.addr):\(.port)", "\(.type)/\(.security)"] | @tsv' "$STATE" \
               | while IFS=$'\t' read -r id name addr tr; do printf ' 🇪🇺 %s %b%s%b %s %s\n' "$(pad "$id" 4)" "$BOLD" "$(pad "$name" 22)" "$NC" "$(pad "$addr" 32)" "$tr"; done ;;
    *) die "node: add <vless://...> | del <имя|id> | list" ;;
  esac
}

# ------------------------------------------------------------------ WARP

curl_warp() { # METHOD PATH [extra curl args...]
  local m=$1 p=$2; shift 2
  "$CURL" -fsS --max-time 30 -H 'User-Agent: okhttp/3.12.1' -H 'Content-Type: application/json' -X "$m" "$WARP_API/$p" "$@"
}

# Регистрация анонимного устройства Cloudflare WARP (бесплатный тариф) —
# тот же API, что использует ImMALWARE/bash-warp-generator (MIT).
# Результат хранится в state.json и подключается как нативный wireguard-outbound Xray.
warp_register() {
  command -v openssl >/dev/null || die "Нужен openssl"
  local key priv pub resp id token resp2 peer v4 v6 cid reserved tmp
  tmp=$(mktemp); key=$tmp.pem
  openssl genpkey -algorithm X25519 -out "$key" 2>/dev/null || { rm -f "$tmp" "$key"; die "openssl не умеет X25519"; }
  priv=$(openssl pkey -in "$key" -outform DER 2>/dev/null | tail -c 32 | base64 -w0)
  pub=$(openssl pkey -in "$key" -pubout -outform DER 2>/dev/null | tail -c 32 | base64 -w0)
  rm -f "$tmp" "$key"
  [[ -n $priv && -n $pub ]] || die "Не удалось сгенерировать ключи WireGuard"

  resp=$(curl_warp POST reg -d "{\"install_id\":\"\",\"tos\":\"$(date -u +%FT%TZ)\",\"key\":\"$pub\",\"fcm_token\":\"\",\"type\":\"ios\",\"locale\":\"en_US\"}") \
    || die "Cloudflare не ответил на регистрацию (сеть или блокировка API)."
  id=$(jq -r '.result.id // empty' <<<"$resp"); token=$(jq -r '.result.token // empty' <<<"$resp")
  [[ -n $id && -n $token ]] || die "Cloudflare отклонил регистрацию: $(jq -c '.errors // .' <<<"$resp" 2>/dev/null | head -c 300)"

  resp2=$(curl_warp PATCH "reg/$id" -H "Authorization: Bearer $token" -d '{"warp_enabled":true}') \
    || die "Не удалось активировать WARP-устройство."
  peer=$(jq -r '.result.config.peers[0].public_key // empty' <<<"$resp2")
  v4=$(jq -r '.result.config.interface.addresses.v4 // empty' <<<"$resp2")
  v6=$(jq -r '.result.config.interface.addresses.v6 // empty' <<<"$resp2")
  cid=$(jq -r '.result.config.client_id // empty' <<<"$resp2"); [[ -n $cid ]] || cid=$(jq -r '.result.config.client_id // empty' <<<"$resp")
  [[ -n $peer && -n $v4 ]] || die "В ответе Cloudflare нет peer/адреса — формат API мог измениться."

  reserved="[0,0,0]"
  if [[ -n $cid ]]; then
    reserved=$(printf '%s' "$cid" | base64 -d 2>/dev/null | od -An -tu1 -v | xargs | jq -Rc 'split(" ") | map(tonumber)') || reserved="[0,0,0]"
    [[ $(jq 'length' <<<"$reserved" 2>/dev/null) == 3 ]] || reserved="[0,0,0]"
  fi

  st_edit --arg sk "$priv" --arg pp "$peer" --arg v4 "$v4" --arg v6 "$v6" --argjson rs "$reserved" \
          --arg ep "$WARP_ENDPOINT" --arg id "$id" --arg tk "$token" '
    .warp = ((.warp // {}) + {
      registered: true, secretKey: $sk, peerPublicKey: $pp, endpoint: $ep, reserved: $rs,
      address: ([$v4 + "/32"] + (if $v6 != "" then [$v6 + "/128"] else [] end)),
      deviceId: $id, deviceToken: $tk})
    | .warp.enabled = (.warp.enabled // false) | .warp.ru = (.warp.ru // false) | .warp.domains = (.warp.domains // [])'
  ok "✅ WARP-устройство зарегистрировано ($v4)."
}

# Кандидаты на endpoint: порты WARP бывают закрыты провайдером выборочно (список можно задать через AX_WARP_CANDIDATES)
warp_candidates() {
  local cur; cur=$(st '.warp.endpoint // empty')
  if [[ -n ${AX_WARP_CANDIDATES:-} ]]; then tr ' ' '\n' <<<"$AX_WARP_CANDIDATES"; return; fi
  { [[ -n $cur ]] && echo "$cur"
    printf '%s\n' 162.159.192.1:2408 162.159.192.1:500 162.159.192.1:4500 162.159.192.1:1701 \
      162.159.193.1:2408 188.114.97.1:2408 188.114.99.1:2408 engage.cloudflareclient.com:2408; } | awk '!seen[$0]++'
}

# warp_probe <endpoint> — отдельный Xray только с WARP спрашивает one.one.one.one/cdn-cgi/trace.
# Результат: код 0 при warp=on; журнал сохраняется в $WARP_PROBE_LOG (секреты вырезаны).
warp_probe() {
  local ep=$1 cfg pid out port=10899 i
  command -v xray >/dev/null 2>&1 || { WARP_PROBE_OUT="xray не найден"; return 2; }
  cfg=$(mktemp --suffix=.json); WARP_PROBE_LOG=$(mktemp)
  jq -n --slurpfile s "$STATE" --arg ep "$ep" --argjson port "$port" '
    $s[0].warp as $W | {
      log: {loglevel: "debug"},
      inbounds: [{tag: "in", listen: "127.0.0.1", port: $port, protocol: "socks", settings: {udp: false}}],
      outbounds: [{tag: "warp", protocol: "wireguard", settings: {
        secretKey: $W.secretKey, address: $W.address,
        peers: [{publicKey: $W.peerPublicKey, allowedIPs: ["0.0.0.0/0", "::/0"], endpoint: $ep}],
        mtu: 1280, reserved: $W.reserved, noKernelTun: true, domainStrategy: "ForceIP"}}]}' >"$cfg"
  xray run -c "$cfg" >"$WARP_PROBE_LOG" 2>&1 9>&- &
  pid=$!
  for i in $(seq 1 15); do ss -ltn 2>/dev/null | grep -q "127.0.0.1:$port " && break; sleep 0.2; done
  WARP_PROBE_OUT=$("$CURL" -fsS --max-time 10 --socks5-hostname "127.0.0.1:$port" https://one.one.one.one/cdn-cgi/trace 2>&1)
  kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; rm -f "$cfg"
  sed -i -E 's/(secretKey|privateKey|private_key)[^,]*/\1 <скрыто>/Ig' "$WARP_PROBE_LOG" 2>/dev/null
  grep -qE '^warp=(on|plus)' <<<"$WARP_PROBE_OUT"
}

# Перебирает endpoint'ы, оставляет первый рабочий в state.json. Код 1 — WARP недоступен с этого сервера.
warp_pick_endpoint() {
  local ep
  echo -e " 🔎 ${DIM}Проверяю, отвечает ли WARP с этого сервера...${NC}"
  while read -r ep; do
    [[ -n $ep ]] || continue
    printf '    %s ... ' "$ep"
    if warp_probe "$ep"; then
      echo -e "${GRN}✔ работает${NC}"
      st_edit --arg ep "$ep" '.warp.endpoint = $ep'; return 0
    fi
    echo -e "${RED}✘${NC}"
  done < <(warp_candidates)
  return 1
}

warp_enable_checked() { # [--force]; печатает причину и возвращает 1, если WARP не отвечает
  if [[ ${1:-} == --force ]]; then return 0; fi
  if ! warp_pick_endpoint; then
    warn "WARP не отвечает ни на одном endpoint. Включение отменено, чтобы не оборвать доступ к сайтам."
    echo -e "   ${DIM}Запустите ${NC}${CYAN}autoxray warp debug${NC}${DIM} и пришлите вывод, либо ${NC}${CYAN}--force${NC}${DIM} чтобы включить без проверки.${NC}"
    return 1
  fi
}

# Один отчёт для разбора проблем с WARP, секреты скрыты.
warp_debug() {
  need_state
  local quick=0 ep ok_cnt=0; [[ ${1:-} == --quick ]] && quick=1
  section "🧪 Отладка WARP"
  kv "🔐" "autoxray" "$AX_VERSION"
  kv "⚙️ " "Xray" "$(xray_version)"
  kv "🖥 " "Система" "$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-?}"), ядро $(uname -r)"
  kv "🌐" "IPv4 наружу" "$("$CURL" -4 -fsS --max-time 5 https://api.ipify.org 2>/dev/null || echo "нет ответа")"
  kv "🌐" "IPv6 наружу" "$("$CURL" -6 -fsS --max-time 5 https://api6.ipify.org 2>/dev/null || echo "нет")"
  echo -e "\n ${BOLD}Состояние в state.json${NC} ${DIM}(ключи скрыты)${NC}"
  jq '.warp | del(.secretKey, .deviceToken) | .secretKey = "<скрыто>"' "$STATE" | sed 's/^/   /'
  if [[ -f $XRAY_CFG ]]; then
    echo -e "\n ${BOLD}Outbound warp в рабочем конфиге${NC}"
    jq '(.outbounds[]? | select(.tag == "warp") | .settings | del(.secretKey)) // "нет outbound warp"' "$XRAY_CFG" | sed 's/^/   /'
    echo -e "\n ${BOLD}Правила маршрутизации на warp${NC}"
    jq -c '.routing.rules[]? | select(.outboundTag == "warp")' "$XRAY_CFG" | sed 's/^/   /'
  fi
  [[ $(st '.warp.registered // false') == true ]] || { warn "WARP не зарегистрирован: autoxray warp register"; return 1; }
  echo -e "\n ${BOLD}Проверка endpoint'ов${NC} ${DIM}(у каждого свой тестовый Xray, до 10 с)${NC}"
  local cands; cands=$(warp_candidates); [[ $quick == 1 ]] && cands=$(head -n1 <<<"$cands")
  while read -r ep; do
    [[ -n $ep ]] || continue
    if warp_probe "$ep"; then
      ok_cnt=$((ok_cnt + 1)); echo -e "   ${GRN}✔${NC} $ep  ${DIM}$(grep -E '^(ip|loc|warp)=' <<<"$WARP_PROBE_OUT" | tr '\n' ' ')${NC}"
    else
      echo -e "   ${RED}✘${NC} $ep  ${DIM}${WARP_PROBE_OUT:0:110}${NC}"
      grep -iE 'wireguard|handshake|endpoint|dial|failed|error|reserved' "$WARP_PROBE_LOG" | tail -n 6 | cut -c1-220 | sed 's/^/        /'
    fi
  done <<<"$cands"
  echo; rule
  if [[ $ok_cnt -gt 0 ]]; then
    echo -e " ${GRN}WARP отвечает на $ok_cnt из $(wc -l <<<"$cands") endpoint'ов.${NC} Закрепить рабочий: ${CYAN}autoxray warp on${NC}"
  else
    echo -e " ${RED}WARP не ответил ни на одном endpoint.${NC} Пришлите этот вывод целиком."
    echo -e " ${DIM}Частые причины: провайдер режет UDP до Cloudflare, закрыт исходящий UDP, регистрация устройства отклонена.${NC}"
    return 1
  fi
}

cmd_warp() {
  need_state
  [[ $(mode) == direct ]] || die "WARP не используется в режиме моста: российский трафик моста и так идёт напрямую."
  local sub=${1:-status}; shift || true
  case $sub in
    register) need_root; locked warp_register ;;
    on)  need_root
         [[ $(st '.warp.registered // false') == true ]] || locked warp_register
         warp_enable_checked "${1:-}" || exit 1
         st_edit '.warp.enabled = true'; locked apply_or_die && ok "✅ WARP включён." ;;
    debug) warp_debug "$@" ;;
    endpoint) need_root; [[ -n ${1:-} ]] || die "warp endpoint <ip:порт>"
         st_edit --arg ep "$1" '.warp.endpoint = $ep'; locked apply_or_die; ok "✅ endpoint → $1" ;;
    off) need_root; st_edit '.warp.enabled = false'; locked apply_or_die && ok "✅ WARP выключен." ;;
    ru)  need_root
         case ${1:-} in
           on)  [[ $(st '.warp.registered // false') == true ]] || locked warp_register
                warp_enable_checked "${2:-}" || exit 1
                st_edit '.warp.enabled = true | .warp.ru = true'; locked apply_or_die
                ok "✅ Российские сайты идут через WARP."
                warn "Обновите подписку в клиентах: теперь RU-трафик клиент отдаёт на сервер, а не напрямую." ;;
           off) st_edit '.warp.ru = false'; locked apply_or_die; ok "✅ RU снова идёт напрямую (подписку в клиентах обновите)." ;;
           *) die "warp ru on|off" ;;
         esac ;;
    add) need_root; local d=${1:-}; [[ -n $d ]] || die "warp add <домен|geosite:xxx>"
         [[ $d == *:* ]] || d="domain:$d"
         st_edit --arg d "$d" '.warp.domains = (((.warp.domains // []) + [$d]) | unique)'
         locked apply_or_die; ok "✅ $d → WARP" ;;
    del) need_root; local d=${1:-}; [[ -n $d ]] || die "warp del <домен>"
         [[ $d == *:* ]] || d="domain:$d"
         st_edit --arg d "$d" '.warp.domains = ((.warp.domains // []) - [$d])'
         locked apply_or_die; ok "✅ $d удалён из списка WARP" ;;
    list|status)
         section "🌍 Cloudflare WARP"
         kv "🆔" "Профиль" "$(tick "$(st '.warp.registered // false')") зарегистрирован"
         kv "🔌" "Состояние" "$(tick "$(st '.warp.enabled // false')") включён"
         kv "🇷🇺" "Российские сайты" "$(tick "$(st '.warp.ru // false')") через WARP ${DIM}(иначе напрямую)${NC}"
         local n; n=$(jq '(.warp.domains // []) | length' "$STATE")
         if [[ $n -gt 0 ]]; then
           echo -e " 🎯 ${DIM}Свои домены${NC}"
           local dom; while IFS= read -r dom; do echo -e "    ${CYAN}•${NC} $dom"; done < <(jq -r '(.warp.domains // [])[]' "$STATE")
         else echo -e " 🎯 ${DIM}Свои домены: не заданы (autoxray warp add <домен>)${NC}"; fi ;;
    check)
         local su sp
         su=$(st .socks.user); sp=$(st .socks.pass)
         echo -e "🔎 ${DIM}Запрос через socks5 сервера (one.one.one.one всегда идёт через WARP)${NC}"
         local trace; trace=$("$CURL" -fsS --max-time 15 --socks5-hostname "$su:$sp@127.0.0.1:10443" https://one.one.one.one/cdn-cgi/trace | grep -E '^(ip|loc|warp)=') \
           || die "Нет ответа. Проверьте: autoxray warp status; systemctl status xray"
         echo "$trace" | sed 's/^/   /'
         grep -qE '^warp=(on|plus)' <<<"$trace" && ok "✅ WARP работает" || warn "warp не включён в ответе — трафик идёт мимо WARP" ;;
    *) die "warp: register | on | off | ru on|off | add | del | list | check | debug | endpoint" ;;
  esac
}

# ------------------------------------------------------ служебные команды

cmd_status() {
  need_state
  local d m s run="" cert_end days col
  d=$(st .domain); m=$(mode)
  section "🔐 autoXRAY $AX_VERSION"
  kv "🌐" "Домен" "${BOLD}${CYAN}$d${NC}  ${DIM}режим: $m${NC}"
  kv "🔑" "Fingerprint" "$(st .fingerprint)"
  for s in xray nginx telemt tproxy-server; do
    if systemctl is-active --quiet "$s" 2>/dev/null; then run+="$s $(tick true)  "
    elif systemctl list-unit-files "$s.service" 2>/dev/null | grep -q "$s"; then run+="$s $(tick false)  "; fi
  done
  kv "🔧 " "Службы" "$run"
  kv "👥" "Пользователи" "$(jq '.users | length' "$STATE") ${DIM}(активных: $(active_names | wc -w))${NC}"
  if [[ $m == bridge ]]; then
    kv "🔀" "Узлы EU" "$(jq '.nodes | length' "$STATE")"
  else
    kv "🌍" "WARP" "$(tick "$(st '.warp.enabled // false')") $([[ $(st '.warp.enabled // false') == true ]] && echo "включён" || echo "выключен")  ${DIM}RU через WARP:${NC} $(tick "$(st '.warp.ru // false')")"
  fi
  if [[ -r /var/lib/xray/cert/fullchain.pem ]] && command -v openssl >/dev/null; then
    cert_end=$(openssl x509 -enddate -noout -in /var/lib/xray/cert/fullchain.pem | cut -d= -f2)
    days=$(days_left "$(date -d "$cert_end" +%s)"); col=$GRN; [[ $days -le 14 ]] && col=$YEL; [[ $days -le 3 ]] && col=$RED
    kv "📜" "Сертификат" "${col}ещё $days дн.${NC} ${DIM}(до $(date -d "$cert_end" +%F))${NC}"
  fi
  update_banner
}

cmd_fingerprint() {
  need_root; need_state
  case ${1:-} in chrome|firefox|safari|ios|android|edge|360|qq) ;; *) die "fingerprint: chrome firefox safari ios android edge 360 qq" ;; esac
  st_edit --arg f "$1" '.fingerprint = $f'; locked apply_or_die; ok "✅ fingerprint → $1 (обновите подписки в клиентах)"
}

cmd_telegram() {
  need_root; need_state
  case ${1:-} in
    set) [[ -n ${2:-} ]] || die "telegram set <tg://webproxy?...>"; st_edit --arg l "$2" '.telegram = {enabled: true, link: $l}' ;;
    off) st_edit '.telegram = {enabled: false, link: ""}' ;;
    update) bash "$TPL_DIR/telegram/update.sh"; return ;;
    remove) bash "$TPL_DIR/telegram/uninstall.sh"; return ;;
    *) die "telegram: set <ссылка> | off | update | remove" ;;
  esac
  locked apply_or_die
}

cmd_backup() {
  need_root; need_state
  local out=${1:-/root/autoxray-backup-$(date +%F-%H%M).tar.gz} p paths=() web
  web=$(st .web)
  for p in etc/autoxray usr/local/etc/xray/config.json etc/telemt etc/tproxy-server var/lib/xray/cert \
           etc/nginx/conf.d/default.conf etc/nginx/autoxray-userinfo.map root/.acme.sh "${web#/}"; do
    [[ -e /$p ]] && paths+=("$p")
  done
  (umask 077; tar -C / -czf "$out" "${paths[@]}") || die "Не удалось создать бэкап"
  chmod 600 "$out"
  ok "✅ Бэкап: $out"
  warn "Внутри ключи и пароли — храните в безопасном месте."
}

cmd_restore() {
  need_root
  local f=${1:-}; [[ -f $f ]] || die "restore <файл.tar.gz>"
  tar -tzf "$f" >/dev/null 2>&1 || die "Файл не является tar.gz"
  warn "Будут перезаписаны конфиги из архива ($f)."
  read -rp "Продолжить? (y/N): " a; [[ $a =~ ^[Yy]$ ]] || exit 1
  tar -C / -xzf "$f" || die "Ошибка распаковки"
  svc daemon-reload; svc restart nginx xray; svc restart telemt tproxy-server 2>/dev/null
  ok "✅ Восстановлено."
}

xray_version() { xray version 2>/dev/null | awk 'NR == 1 {print "v" $2}'; }

# Стабильные версии Xray новее текущей (по одной в строке, свежие сверху)
core_newer() {
  local cur; cur=$(xray_version)
  "$CURL" -fsS --max-time 10 "$API/repos/XTLS/Xray-core/releases" 2>/dev/null \
    | jq -r '.[] | select(.prerelease == false and .draft == false) | .tag_name' 2>/dev/null \
    | while read -r t; do ver_gt "$t" "$cur" && echo "$t"; done | sort -rV | head -n 12
}

core_warning() {
  echo -e "\n ${BOLD}${YEL}⚠️  Ядро Xray лучше не обновлять без необходимости${NC}"
  echo -e " ${DIM}Новые версии иногда меняют формат конфигов и поведение протоколов, и работающая схема может сломаться.${NC}"
  echo -e " ${DIM}Этот релиз autoXRAY проверен с ${NC}${BOLD}$XRAY_TESTED${NC}${DIM}. Обновляйтесь, если нужна конкретная возможность или исправление.${NC}"
}

cmd_core() {
  need_state
  local sub=${1:-list}; shift || true
  case $sub in
    list)
      local cur newer t; cur=$(xray_version)
      section "⚙️  Ядро Xray"
      kv "📌" "Установлено" "${BOLD}${cur:-не найдено}${NC}"
      kv "✅" "Проверено" "$XRAY_TESTED ${DIM}(с этим релизом autoXRAY)${NC}"
      newer=$(core_newer)
      if [[ -n $newer ]]; then echo -e " 🆕 ${DIM}Новее установленной:${NC}"; while read -r t; do echo -e "    ${CYAN}•${NC} $t"; done <<<"$newer"
      else echo -e " ${DIM}Новее установленной версий нет (или GitHub недоступен).${NC}"; fi
      core_warning ;;
    update)
      need_root
      local v="" yes=0 prev
      while (($#)); do case $1 in --yes|-y) yes=1 ;; *) v=$1 ;; esac; shift; done
      [[ -n $v ]] || v=$XRAY_TESTED
      [[ $v == v* ]] || v="v$v"
      prev=$(xray_version)
      core_warning
      echo -e "\n Сейчас: ${BOLD}${prev:-?}${NC}  →  будет установлена: ${BOLD}$v${NC}"
      if [[ $yes != 1 ]]; then read -rp "$(echo -e " ${BOLD}Продолжить? Введите yes:${NC} ")" a; [[ $a == yes ]] || die "Отменено."; fi
      bash -c "$("$CURL" -fsSL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install --version "$v" \
        || die "Установка ядра $v не удалась."
      if ! xray run -test -c "$XRAY_CFG" >/dev/null 2>&1; then
        warn "Текущий конфиг не проходит проверку на $v. Возвращаю $prev."
        [[ -n $prev ]] && bash -c "$("$CURL" -fsSL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install --version "$prev"
        svc restart xray; die "Обновление отменено: $v несовместима с вашим конфигом."
      fi
      st_edit --arg v "$v" '.xray_version = $v'
      svc restart xray; ok "✅ Ядро обновлено: $prev → $v" ;;
    *) die "core: list | update [версия] [--yes]" ;;
  esac
}

# Переносит установку autoXRAY 2 (один пользователь, config.json) в state.json:
# сохраняются UUID, пароль Hysteria2, пути, ключи socks5 и адрес старой ссылки подписки.
cmd_migrate() {
  need_root
  [[ -f $STATE ]] && die "state.json уже существует — переносить нечего."
  [[ -f $XRAY_CFG ]] || die "Не найден $XRAY_CFG"
  local cfg=$XRAY_CFG ngx=${AX_NGINX_CONF:-/etc/nginx/conf.d/default.conf}
  local domain uuid hy2 xp su sp token fp="firefox" web user=${1:-main} sub
  domain=$(jq -r '.inbounds[] | select(.tag == "Hysteria2") | .streamSettings.tlsSettings.serverName // empty' "$cfg")
  uuid=$(jq -r '.inbounds[] | select(.tag == "vsRAWtlsVISION") | .settings.clients[0].id // empty' "$cfg")
  hy2=$(jq -r '.inbounds[] | select(.tag == "Hysteria2") | .settings.clients[0].auth // empty' "$cfg")
  xp=$(jq -r '.inbounds[] | select(.tag == "vsXHTTPtls") | .streamSettings.xhttpSettings.path // empty' "$cfg"); xp=${xp#/}
  su=$(jq -r '.inbounds[] | select(.tag == "socks5") | .settings.accounts[0].user // empty' "$cfg")
  sp=$(jq -r '.inbounds[] | select(.tag == "socks5") | .settings.accounts[0].pass // empty' "$cfg")
  [[ -n $domain && -n $uuid && -n $hy2 && -n $xp && -n $su && -n $sp ]] || die "config.json не похож на конфиг autoXRAY 2 (нет нужных inbound'ов)."
  token=$(sed -n 's#.*location = /\([A-Za-z0-9]\{20,32\}\)\.json.*#\1#p' "$ngx" 2>/dev/null | head -n1)
  [[ -n $token ]] || token=$(rand 'A-Za-z0-9' 24)
  web="${AX_WEB:-/var/www/$domain}"
  sub="$web/$token.json"
  [[ -f $sub ]] && fp=$(jq -r '.[0].outbounds[0].streamSettings.tlsSettings.fingerprint // "firefox"' "$sub")
  mkdir -p "$AX_ETC"; chmod 700 "$AX_ETC"
  echo '{}' >"$TRAFFIC"; chmod 600 "$TRAFFIC"
  cp -p "$cfg" "$AX_ETC/config.v2.json.bak"
  jq -n --arg d "$domain" --arg f "$fp" --arg xp "$xp" --arg w "$web" --arg su "$su" --arg sp "$sp" \
        --arg n "$user" --arg id "$uuid" --arg h "$hy2" --arg t "$token" --argjson c "$(now)" '
    {version: 3, mode: "direct", nodes: [], domain: $d, fingerprint: $f, web: $w, xray_version: "",
     paths: {xhttp: $xp, auth: "/api/v1/authenticate"}, socks: {user: $su, pass: $sp},
     telegram: {enabled: false, link: ""}, warp: {registered: false, enabled: false, ru: false, domains: []},
     users: [{name: $n, uuid: $id, hy2: $h, token: $t, created: $c, expire: 0, limit: 0, enabled: true, reset: "never", next_reset: 0}]}' >"$STATE"
  chmod 600 "$STATE"
  ok "✅ Перенесено из autoXRAY 2: пользователь '$user', ссылка подписки сохранена (токен $token)."
  warn "Прежний config.json сохранён: $AX_ETC/config.v2.json.bak"
}

# Обновление самого autoxray, шаблонов и компонентов до релиза (по умолчанию — последнего).
cmd_self_update() {
  need_root
  local tag=${1:-} raw tmp f
  if [[ -z $tag ]]; then
    tag=$("$CURL" -fsS --max-time 15 "https://api.github.com/repos/$AX_REPO/releases/latest" | jq -r '.tag_name // empty')
    [[ -n $tag ]] || die "Не удалось узнать последний релиз (GitHub API недоступен)."
  fi
  [[ $tag == v* ]] || tag="v$tag"
  [[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "Версия вида vX.Y.Z"
  [[ ${tag#v} == "$AX_VERSION" ]] && { ok "Уже установлена версия $AX_VERSION."; return 0; }
  raw="https://raw.githubusercontent.com/$AX_REPO/$tag"
  tmp=$(mktemp -d)
  for f in autoxray templates/sub.html templates/nginx.conf components/telegram/install.sh components/telegram/update.sh components/telegram/uninstall.sh; do
    mkdir -p "$tmp/$(dirname "$f")"
    "$CURL" -fsSL --max-time 30 "$raw/$f" -o "$tmp/$f" || { rm -rf "$tmp"; die "Не удалось скачать $f ($tag)"; }
  done
  bash -n "$tmp/autoxray" || { rm -rf "$tmp"; die "Скачанный autoxray не прошёл проверку синтаксиса."; }
  install -m 755 "$tmp/autoxray" /usr/local/bin/autoxray
  mkdir -p "$TPL_DIR/telegram"
  install -m 644 "$tmp/templates/sub.html" "$tmp/templates/nginx.conf" "$TPL_DIR/"
  install -m 755 "$tmp"/components/telegram/*.sh "$TPL_DIR/telegram/"
  rm -rf "$tmp"
  ok "✅ autoxray $AX_VERSION → ${tag#v}. Заметки: https://github.com/$AX_REPO/releases/tag/$tag"
  /usr/local/bin/autoxray render
}

# Обновление geoip.dat / geosite.dat (на них опираются правила маршрутизации). Перезапуск Xray — только при изменении.
cmd_geo_update() {
  need_root
  local quiet=0 dir=${XRAY_LOCATION_ASSET:-/usr/local/share/xray} before after
  [[ ${1:-} == --quiet ]] && quiet=1
  before=$(cat "$dir"/geoip.dat "$dir"/geosite.dat 2>/dev/null | md5sum)
  bash -c "$("$CURL" -fsSL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install-geodata >/dev/null 2>&1 \
    || { [[ $quiet == 1 ]] || die "Не удалось обновить гео-данные (нет доступа к GitHub?)"; return 1; }
  after=$(cat "$dir"/geoip.dat "$dir"/geosite.dat 2>/dev/null | md5sum)
  if [[ $before != "$after" ]]; then svc restart xray; [[ $quiet == 1 ]] || ok "🗺 Гео-данные обновлены, Xray перезапущен."
  else [[ $quiet == 1 ]] || ok "🗺 Гео-данные уже актуальны."; fi
}

# Диагностика: частые причины «не работает».
cmd_doctor() {
  need_state
  local bad=0 d ip dnsip cert_end days port k
  d=$(st .domain)
  pass_() { printf '  %b✔%b %s\n' "$GRN" "$NC" "$1"; }
  warn_() { printf '  %b⚠%b %s %b— %s%b\n' "$YEL" "$NC" "$1" "$DIM" "$2" "$NC"; }
  fail_() { printf '  %b✘%b %s %b— %s%b\n' "$RED" "$NC" "$1" "$DIM" "$2" "$NC"; bad=$((bad + 1)); }
  section "🩺 Диагностика"

  echo -e "\n ${BOLD}Службы${NC}"
  for k in xray nginx; do
    systemctl is-active --quiet "$k" 2>/dev/null && pass_ "$k запущен" || fail_ "$k не запущен" "systemctl status $k; journalctl -u $k -e"
  done
  echo -e "\n ${BOLD}Порты${NC}"
  for port in 80/tcp 443/tcp 443/udp; do
    k=${port#*/}; [[ $k == tcp ]] && k=ltn || k=lun
    ss -$k 2>/dev/null | grep -q ":${port%/*} " && pass_ "$port слушается" || fail_ "$port не слушается" "проверьте конфиг и файрвол"
  done
  echo -e "\n ${BOLD}Конфигурация${NC}"
  if command -v xray >/dev/null 2>&1; then
    xray run -test -c "$XRAY_CFG" >/dev/null 2>&1 && pass_ "xray: конфиг корректен" || fail_ "xray: конфиг не проходит проверку" "autoxray render; xray run -test -c $XRAY_CFG"
  fi
  if command -v nginx >/dev/null 2>&1; then
    nginx -t >/dev/null 2>&1 && pass_ "nginx: конфиг корректен" || fail_ "nginx: конфиг не проходит проверку" "nginx -t"
  fi
  echo -e "\n ${BOLD}Сеть и домен${NC}"
  dnsip=$(getent ahostsv4 "$d" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ')
  ip=$(hostname -I 2>/dev/null)
  if [[ -z $dnsip ]]; then fail_ "домен $d не резолвится" "создайте A-запись на IP сервера"
  else
    local hit=0 a; for a in $dnsip; do [[ " $ip" == *" $a "* ]] && hit=1; done
    if [[ $hit == 0 ]]; then
      local ext; ext=$("$CURL" -fsS --max-time 4 https://api.ipify.org 2>/dev/null)
      for a in $dnsip; do [[ -n $ext && $a == "$ext" ]] && hit=1; done
    fi
    [[ $hit == 1 ]] && pass_ "A-запись $d указывает на этот сервер" || warn_ "A-запись $d ($dnsip) не совпадает с адресами сервера" "проверьте DNS"
    [[ $(wc -w <<<"$dnsip") -gt 1 ]] && warn_ "у домена несколько A-записей" "оставьте одну"
  fi
  if [[ $(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null) == bbr ]]; then pass_ "BBR включён"; else warn_ "BBR не включён" "ядро или контейнер не поддерживают"; fi
  if command -v timedatectl >/dev/null 2>&1 && [[ $(timedatectl show -p NTPSynchronized --value 2>/dev/null) == no ]]; then
    warn_ "время не синхронизировано" "TLS и сертификаты чувствительны ко времени: timedatectl set-ntp true"
  fi
  echo -e "\n ${BOLD}Сертификат${NC}"
  if [[ -r /var/lib/xray/cert/fullchain.pem ]] && command -v openssl >/dev/null; then
    cert_end=$(openssl x509 -enddate -noout -in /var/lib/xray/cert/fullchain.pem | cut -d= -f2)
    days=$(days_left "$(date -d "$cert_end" +%s)")
    if [[ $days -le 3 ]]; then fail_ "сертификат истекает через $days дн." "\$HOME/.acme.sh/acme.sh --renew -d $d --ecc --force"
    elif [[ $days -le 14 ]]; then warn_ "сертификат истекает через $days дн." "проверьте автообновление acme.sh (crontab -l)"
    else pass_ "сертификат действителен ещё $days дн."; fi
  else warn_ "сертификат не найден" "/var/lib/xray/cert/fullchain.pem"; fi
  crontab -l 2>/dev/null | grep -q acme.sh && pass_ "автообновление сертификата (cron acme.sh)" || warn_ "в crontab нет задачи acme.sh" "сертификат не будет обновляться сам"
  echo -e "\n ${BOLD}Система${NC}"
  local use; use=$(df -P / | awk 'NR == 2 {gsub("%", "", $5); print $5}')
  [[ ${use:-0} -ge 90 ]] && warn_ "диск заполнен на ${use}%" "очистите журналы и старые бэкапы" || pass_ "диск: занято ${use:-?}%"
  local geo=${XRAY_LOCATION_ASSET:-/usr/local/share/xray}/geosite.dat
  if [[ -f $geo ]]; then
    days=$(( ($(date +%s) - $(stat -c %Y "$geo")) / 86400 ))
    [[ $days -gt 45 ]] && warn_ "гео-данные старше $days дн." "autoxray geo-update" || pass_ "гео-данные свежие ($days дн.)"
  fi
  if command -v ufw >/dev/null 2>&1; then
    ufw status 2>/dev/null | grep -q 'Status: active' && pass_ "файрвол ufw активен" || warn_ "ufw установлен, но выключен" "autoxray firewall"
  else warn_ "файрвол не настроен" "autoxray firewall"; fi
  if [[ $(mode) == direct && $(st '.warp.enabled // false') == true ]]; then
    echo -e "\n ${BOLD}WARP${NC}"
    (cmd_warp check >/dev/null 2>&1) && pass_ "WARP отвечает (warp=on)" || fail_ "WARP не отвечает" "autoxray warp check; autoxray warp register"
  fi
  echo; rule
  if [[ $bad -eq 0 ]]; then echo -e " 🎉 ${GRN}Критичных проблем не найдено${NC}"; else echo -e " 🚨 ${RED}Критичных проблем: $bad${NC}"; return 1; fi
}

# ufw: SSH (порт определяется автоматически), 80/tcp, 443/tcp и 443/udp; остальное входящее закрыто.
cmd_firewall() {
  need_root
  local dry=0 ssh_port
  [[ ${1:-} == --dry-run ]] && dry=1
  ssh_port=$(sshd -T 2>/dev/null | awk '$1 == "port" {print $2; exit}'); ssh_port=${ssh_port:-22}
  section "🔥 Файрвол (ufw)"
  echo -e " Будут разрешены:  ${BOLD}SSH $ssh_port/tcp${NC}, ${BOLD}80/tcp${NC}, ${BOLD}443/tcp${NC}, ${BOLD}443/udp${NC}; остальной входящий трафик закрыт."
  echo -e " ${YEL}Убедитесь, что порт SSH определён верно — иначе вы потеряете доступ к серверу.${NC}"
  if [[ $dry == 1 ]]; then
    echo -e " ${DIM}(dry-run) ufw allow $ssh_port/tcp; ufw allow 80/tcp; ufw allow 443/tcp; ufw allow 443/udp; ufw default deny incoming; ufw enable${NC}"
    return 0
  fi
  read -rp "Для подтверждения введите yes: " a; [[ $a == yes ]] || die "Отменено."
  command -v ufw >/dev/null 2>&1 || apt-get install -y ufw >/dev/null || die "Не удалось установить ufw"
  ufw allow "$ssh_port/tcp" >/dev/null && ufw allow 80/tcp >/dev/null && ufw allow 443/tcp >/dev/null && ufw allow 443/udp >/dev/null \
    && ufw default deny incoming >/dev/null && ufw default allow outgoing >/dev/null && ufw --force enable >/dev/null \
    || die "ufw не настроен"
  ok "✅ Файрвол включён."; ufw status | sed 's/^/   /'
}

# Полное удаление: Telegram Web Proxy, Xray, nginx, acme.sh, данные и сам autoxray.
cmd_uninstall() {
  need_root; need_state
  local web; web=$(st .web)
  warn "Будут удалены: Xray, nginx, acme.sh, сайт-маскировка ($web), Telegram Web Proxy, ключи и данные пользователей."
  warn "Сначала сделайте бэкап, если он может понадобиться: autoxray backup"
  read -rp "Для подтверждения введите yes: " a; [[ $a == yes ]] || die "Отменено."
  [[ -f $TPL_DIR/telegram/uninstall.sh ]] && bash "$TPL_DIR/telegram/uninstall.sh" || true
  bash -c "$("$CURL" -fsSL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ remove --purge
  svc disable --now nginx 2>/dev/null; apt-get remove -y nginx >/dev/null 2>&1
  [[ -x $HOME/.acme.sh/acme.sh ]] && "$HOME/.acme.sh/acme.sh" --uninstall >/dev/null 2>&1
  rm -rf "$web" /var/lib/xray /usr/local/share/autoxray "$AX_ETC" "$NGX_MAP" /etc/cron.d/autoxray \
         /etc/sysctl.d/999-autoXRAY.conf /etc/security/limits.d/99-autoXRAY.conf /usr/local/bin/autoxray
  ok "✅ autoXRAY удалён."
}

cmd_render() { need_root; need_state; locked render_all; }

cmd_init() {
  need_root
  local domain="" fp=firefox xp="" ap=/api/v1/authenticate web="" user=main xv="" mode=direct nodes='[]' nj
  while (($#)); do
    case $1 in
      --mode) [[ ${2:-} =~ ^(direct|bridge)$ ]] || die "--mode direct|bridge"; mode=$2; shift 2 ;;
      --node) nj=$(parse_vless "${2:-}") || die "Неверная vless-ссылка узла: ${2:-}"
              nodes=$(jq -c --argjson n "$nj" '. + [$n + {id: (length + 1)}]' <<<"$nodes"); shift 2 ;;
      --domain) domain=$2; shift 2 ;; --fp) fp=$2; shift 2 ;; --xhttp-path) xp=$2; shift 2 ;;
      --auth-path) ap=$2; shift 2 ;; --web) web=$2; shift 2 ;; --user) user=$2; shift 2 ;;
      --xray-version) xv=$2; shift 2 ;;
      *) die "init: неизвестный параметр $1" ;;
    esac
  done
  [[ -n $domain ]] || die "init --domain <домен>"
  [[ $mode == direct || $(jq length <<<"$nodes") -gt 0 ]] || die "Для режима моста нужен хотя бы один --node vless://..."
  valid_name "$user" || die "Недопустимое имя пользователя"
  [[ -f $STATE ]] && die "Уже инициализировано: $STATE (для повторной установки удалите его или сделайте backup)"
  mkdir -p "$AX_ETC"; chmod 700 "$AX_ETC"
  [[ -n $xp ]] || xp=$(rand 'a-z0-9' 6)
  [[ -n $web ]] || web="${AX_WEB:-/var/www/$domain}"
  echo '{}' >"$TRAFFIC"; chmod 600 "$TRAFFIC"
  local variants=(
    "ERR_INVALID_CREDENTIALS|The username or password you entered is incorrect."
    "ERR_INVALID_CREDENTIALS|The identity or security key you provided is invalid."
    "ERR_BAD_PASSWORD|Incorrect password. Please verify your credentials and retry."
    "ERR_KEY_MISMATCH|The security key provided does not match the account identity."
    "ERR_CREDENTIAL_REJECTED|Credential verification rejected by the authentication authority."
    "ERR_PASSWORD_MISMATCH|The password provided does not match the registered key."
    "ERR_INCORRECT_KEY|Incorrect security credentials provided for this principal."
    "ERR_USER_NOT_FOUND|Principal identity not found in directory services."
    "ERR_IDENTITY_NOT_FOUND|No account found matching the provided identity."
    "ERR_PRINCIPAL_MISSING|User principal does not exist in this organizational realm."
    "ERR_ACCOUNT_NOT_FOUND|Account identifier not recognized by the identity provider."
    "ERR_UNKNOWN_USER|Unrecognized user identity. Please verify your login."
    "ERR_LOOKUP_FAILED|User lookup failed: Specified identity does not exist."
    "ERR_AUTH_FAILED|Authentication failed: The provided credentials do not match."
    "ERR_DIRECTORY_MISMATCH|Credentials could not be verified against the corporate directory."
    "ERR_RECORDS_MISMATCH|The security credentials entered do not match our records."
  )
  local pick=${variants[$((RANDOM % ${#variants[@]}))]}
  jq -n --arg ac "${pick%%|*}" --arg am "${pick#*|}" --arg d "$domain" --arg f "$fp" --arg xp "$xp" --arg ap "$ap" --arg w "$web" --arg xv "$xv" \
        --arg su "$(rand 'A-Za-z0-9' 6)" --arg sp "$(rand 'A-Za-z0-9' 16)" \
        --arg n "$user" --arg id "$(user_uuid "$mode")" --arg h "$(rand 'a-f0-9' 16)" --arg t "$(rand 'A-Za-z0-9' 24)" --argjson c "$(now)" \
        --arg mode "$mode" --argjson nodes "$nodes" '
    {version: 3, mode: $mode, nodes: $nodes, auth: {code: $ac, msg: $am}, domain: $d, fingerprint: $f, web: $w, xray_version: $xv,
     paths: {xhttp: $xp, auth: $ap}, socks: {user: $su, pass: $sp},
     telegram: {enabled: false, link: ""},
     warp: {registered: false, enabled: false, ru: false, domains: []},
     users: [{name: $n, uuid: $id, hy2: $h, token: $t, created: $c, expire: 0, limit: 0, enabled: true, reset: "never", next_reset: 0}]}' >"$STATE"
  chmod 600 "$STATE"
  ok "✅ state.json создан: $STATE"
}

# ----------------------------------------------------------------- меню

pause() { echo; read -rp "$(echo -e "${DIM}Enter, чтобы продолжить...${NC}")" _; }
ask()   { local v; read -rp "$(echo -e " ${BOLD}${CYAN}›${NC} $1: ")" v; printf '%s' "$v"; }
confirm() { local v; read -rp "$(echo -e " ${BOLD}${YEL}?${NC} $1 (y/N): ")" v; [[ $v =~ ^[YyДд]$ ]]; }

# choose <заголовок> <пункт>... — выбор стрелками (↑ ↓, j k), цифрой или Enter; q / Esc — отмена.
# Результат: CHOICE (индекс с нуля). Без терминала (пайп, тесты) работает как нумерованный список.
# Пункты передавайте без цветовых кодов: выбранная строка подсвечивается инверсией.
CHOICE=-1
choose() {
  local title=$1; shift
  local items=("$@") n=$# cur=0 key rest i
  CHOICE=-1
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "$title"
    for ((i = 0; i < n; i++)); do printf '  %d) %s\n' $((i + 1)) "${items[i]}"; done
    read -r key
    [[ $key =~ ^[0-9]+$ && $key -ge 1 && $key -le $n ]] || return 1
    CHOICE=$((key - 1)); return 0
  fi
  draw() {
    for ((i = 0; i < n; i++)); do
      if [[ $i -eq $cur ]]; then printf '\033[2K\r  \033[7m %2d  %s \033[0m\n' $((i + 1)) "${items[i]}"
      else printf '\033[2K\r  %b%2d%b  %s\n' "$DIM" $((i + 1)) "$NC" "${items[i]}"; fi
    done
  }
  echo -e " ${BOLD}$title${NC}  ${DIM}↑↓ выбрать · Enter · цифра · q отмена${NC}"
  printf '\033[?25l'
  draw
  while true; do
    IFS= read -rsn1 key || { printf '\033[?25h'; return 1; }
    case $key in
      $'\033') IFS= read -rsn2 -t 0.05 rest
               case $rest in '[A') ((cur > 0)) && cur=$((cur - 1)) || cur=$((n - 1)) ;;
                             '[B') ((cur < n - 1)) && cur=$((cur + 1)) || cur=0 ;;
                             '') printf '\033[?25h'; return 1 ;; esac ;;
      k) ((cur > 0)) && cur=$((cur - 1)) || cur=$((n - 1)) ;;
      j) ((cur < n - 1)) && cur=$((cur + 1)) || cur=0 ;;
      q|Q) printf '\033[?25h'; return 1 ;;
      [1-9]) if [[ $key -le $n ]]; then cur=$((key - 1)); [[ $n -le 9 ]] && break; fi ;;
      '') break ;;
    esac
    printf '\033[%dA' "$n"; draw
  done
  printf '\033[?25h'
  CHOICE=$cur
}

# pick_user — выбор пользователя; имя в PICKED
PICKED=""
pick_user() {
  local labels=() names=() name status used limit expire ic
  while IFS=$'\t' read -r name status used limit expire; do
    case $status in active) ic="🟢" ;; disabled) ic="⚫" ;; expired) ic="⌛" ;; limit) ic="🚫" ;; *) ic="❔" ;; esac
    names+=("$name")
    if [[ $limit -gt 0 ]]; then labels+=("$ic $(pad "$name" 16) $(hbytes "$used") / $(hbytes "$limit")"); else labels+=("$ic $(pad "$name" 16) $(hbytes "$used")"); fi
  done < <(user_summary)
  [[ ${#names[@]} -gt 0 ]] || { warn "Пользователей нет."; return 1; }
  choose "${1:-Выберите пользователя}" "${labels[@]}" || return 1
  PICKED=${names[$CHOICE]}
}

user_menu_actions() { # имя
  local name=$1 act lim days
  while true; do
    clear; cmd_user_list; echo
    choose "Пользователь «$name»" "🔗 Ссылки и ключи" "📷 QR подписки" "📝 Лимит и срок" "🔌 Отключить / включить" "🔁 Новые ключи и ссылка" "❌ Удалить" "🔙 Назад" || return 0
    act=$CHOICE
    case $act in
      0) show_user "$name"; pause ;;
      1) cmd_user_qr "$name" sub; pause ;;
      2) echo -e " ${DIM}Пустой ответ оставляет текущее значение. 0 снимает лимит или срок.${NC}"
         lim=$(ask "Лимит трафика, ГБ"); days=$(ask "Срок, дней от сегодня")
         [[ -n $lim ]] && (locked cmd_user_set "$name" --limit "$lim")
         [[ -n $days ]] && (locked cmd_user_set "$name" --days "$days"); pause ;;
      3) if [[ $(jq -r --arg n "$name" '.users[] | select(.name == $n) | .enabled' "$STATE") == true ]]
         then (locked cmd_user_set "$name" --disable); else (locked cmd_user_set "$name" --enable); fi; pause ;;
      4) confirm "Выпустить новые ключи? Старая ссылка перестанет работать" && (locked cmd_user_rotate "$name"); pause ;;
      5) if confirm "Удалить «$name» без возможности восстановления"; then (locked cmd_user_del "$name"); pause; return 0; fi ;;
      6) return 0 ;;
    esac
  done
}

menu_users() {
  local name lim days args rs
  while true; do
    clear; cmd_user_list; echo
    choose "Пользователи" "➕ Новый пользователь" "👤 Выбрать пользователя" "🔙 Назад" || return 0
    case $CHOICE in
      0) name=$(ask "Имя (латиница, цифры, _ -)"); [[ -n $name ]] || continue
         lim=$(ask "Лимит трафика, ГБ (Enter: без лимита)"); days=$(ask "Срок, дней (Enter: бессрочно)")
         rs=$(ask "Сбрасывать трафик раз в месяц? (y/N)")
         args=(); [[ -n $lim ]] && args+=(--limit "$lim"); [[ -n $days ]] && args+=(--days "$days"); [[ $rs =~ ^[Yy]$ ]] && args+=(--reset monthly)
         (locked cmd_user_add "$name" "${args[@]}"); pause ;;
      1) pick_user && user_menu_actions "$PICKED" ;;
      2) return 0 ;;
    esac
  done
}

menu_warp() {
  local dom doms
  while true; do
    clear; cmd_warp status; echo
    choose "WARP" "🟢 Включить WARP" "🔴 Выключить WARP" "🇷🇺 Российские сайты ЧЕРЕЗ WARP" "🏠 Российские сайты напрямую" \
      "➕ Добавить домен в WARP" "➖ Убрать домен из WARP" "🔎 Проверить работу" "🧪 Отладка (отчёт для разбора проблем)" "🔙 Назад" || return 0
    case $CHOICE in
      0) (cmd_warp on); pause ;;
      1) (cmd_warp off); pause ;;
      2) (cmd_warp ru on); pause ;;
      3) (cmd_warp ru off); pause ;;
      4) dom=$(ask "Домен, например chatgpt.com"); [[ -n $dom ]] && (cmd_warp add "$dom"); pause ;;
      5) mapfile -t doms < <(jq -r '(.warp.domains // [])[]' "$STATE")
         if [[ ${#doms[@]} -eq 0 ]]; then warn "Список доменов пуст."; else choose "Какой домен убрать" "${doms[@]}" && (cmd_warp del "${doms[$CHOICE]}"); fi; pause ;;
      6) (cmd_warp check); pause ;;
      7) (cmd_warp debug); pause ;;
      8) return 0 ;;
    esac
  done
}

menu_update() {
  local latest newer
  while true; do
    clear; section "📦 Обновления"; echo
    latest=$(latest_ax)
    kv "🔐" "autoxray" "${BOLD}$AX_VERSION${NC} $(ver_gt "$latest" "$AX_VERSION" && echo -e "${GRN}→ доступна $latest${NC}" || echo -e "${DIM}последняя версия${NC}")"
    kv "⚙️ " "Xray" "${BOLD}$(xray_version)${NC} ${DIM}(проверено с релизом: $XRAY_TESTED)${NC}"
    echo
    choose "Что обновить" "📦 autoxray (скрипты и шаблоны)" "⚙️  Ядро Xray: версии и обновление" "🗺 Гео-данные (geoip, geosite)" "🔙 Назад" || return 0
    case $CHOICE in
      0) (cmd_self_update); pause ;;
      1) newer=$(core_newer)
         clear; cmd_core list; echo
         if [[ -n $newer ]]; then
           local vers=(); mapfile -t vers <<<"$newer"
           if choose "Установить версию (после подтверждения)" "${vers[@]}" "🔙 Не обновлять"; then
             [[ $CHOICE -lt ${#vers[@]} ]] && (cmd_core update "${vers[$CHOICE]}")
           fi
         fi; pause ;;
      2) (cmd_geo_update); pause ;;
      3) return 0 ;;
    esac
  done
}

menu() {
  need_state
  while true; do
    clear
    cmd_status
    echo
    choose "Главное меню" "👥 Пользователи" "📊 Статистика" "🌍 WARP" "🩺 Диагностика" "💾 Бэкап" "🔄 Применить конфиг заново" \
      "📦 Обновления" "🔥 Файрвол" "🚪 Выход" || exit 0
    case $CHOICE in
      0) menu_users ;;
      1) cmd_stats; pause ;;
      2) if [[ $(mode) == direct ]]; then menu_warp; else warn "WARP недоступен в режиме моста."; pause; fi ;;
      3) (cmd_doctor); pause ;;
      4) (cmd_backup); pause ;;
      5) (cmd_render); pause ;;
      6) menu_update ;;
      7) (cmd_firewall); pause ;;
      8) exit 0 ;;
    esac
  done
}

usage() {
  local H="${BOLD}${MAG}" C="${CYAN}" D="${DIM}" N="${NC}"
  echo -e "${BOLD}🔐 autoxray $AX_VERSION${N} ${D}— управление autoXRAY${N}\n"
  echo -e "${H}Общее${N}"
  echo -e "  ${C}autoxray${N}                       меню"
  echo -e "  ${C}autoxray status${N}                состояние служб, сертификата, WARP"
  echo -e "  ${C}autoxray doctor${N}                🩺 диагностика сервера"
  echo -e "  ${C}autoxray stats${N}                 📊 трафик по пользователям"
  echo -e "${H}Пользователи${N}"
  echo -e "  ${C}autoxray user list${N} ${D}[--plain]${N}"
  echo -e "  ${C}autoxray user add${N} <имя> ${D}[--limit ГБ] [--days N] [--reset monthly]${N}"
  echo -e "  ${C}autoxray user set${N} <имя> ${D}[--limit ГБ] [--days N] [--reset monthly|never] [--enable|--disable] [--reset-traffic]${N}"
  echo -e "  ${C}autoxray user del${N} <имя>        ${C}user rotate${N} <имя>  ${D}новые ключи и ссылка${N}"
  echo -e "  ${C}autoxray user link${N} <имя> ${D}[--plain]${N}  ${C}user qr${N} <имя> ${D}[sub|xhttp|vision|hy2]${N}"
  echo -e "${H}Сеть${N}"
  echo -e "  ${C}autoxray warp${N} register|on|off|status|check|add|del  ${C}warp debug${N} ${D}[--quick]${N} ${D}разбор проблем${N}"
  echo -e "  ${C}autoxray warp ru${N} on|off        ${D}российские сайты через WARP${N}"
  echo -e "  ${C}autoxray node${N} add <vless://…>|del <имя|id>|list   ${D}(режим моста)${N}"
  echo -e "  ${C}autoxray fingerprint${N} <браузер> ${C}telegram${N} set <ссылка>|off|update|remove"
  echo -e "  ${C}autoxray firewall${N} [--dry-run]  ${D}🔥 настроить ufw (SSH, 80, 443)${N}"
  echo -e "${H}Обслуживание${N}"
  echo -e "  ${C}autoxray backup${N} [файл]  ${C}restore${N} <файл>  ${C}render${N}  ${D}пересобрать конфиги${N}"
  echo -e "  ${C}autoxray self-update${N} [vX.Y.Z]  ${C}geo-update${N}"
  echo -e "  ${C}autoxray core${N} list|update [версия]  ${D}ядро Xray: что установлено и что новее${N}"
  echo -e "  ${C}autoxray migrate${N} [имя]         ${D}перенос с autoXRAY 2${N}"
  echo -e "  ${C}autoxray uninstall${N}             ${D}удалить всё (с подтверждением)${N}"
  echo -e "  ${C}autoxray version${N}  ${C}collect${N} ${D}(cron: учёт трафика)${N}"
}

main() {
  local cmd=${1:-menu}; shift || true
  case $cmd in
    menu)         menu ;;
    status)       cmd_status ;;
    user|users)   cmd_users "$@" ;;
    stats)        cmd_stats ;;
    collect)      need_root; locked cmd_collect ;;
    warp)         cmd_warp "$@" ;;
    fingerprint)  cmd_fingerprint "$@" ;;
    telegram)     cmd_telegram "$@" ;;
    backup)       cmd_backup "$@" ;;
    restore)      cmd_restore "$@" ;;
    update-core)  cmd_core update "$@" ;;
    core)         cmd_core "$@" ;;
    render)       cmd_render ;;
    init)         cmd_init "$@" ;;
    migrate)      cmd_migrate "$@" ;;
    node|nodes)   cmd_node "$@" ;;
    self-update)  cmd_self_update "$@" ;;
    uninstall)    cmd_uninstall ;;
    doctor)       cmd_doctor ;;
    geo-update)   need_root; cmd_geo_update "$@" ;;
    firewall)     cmd_firewall "$@" ;;
    -v|--version|version) echo "autoxray $AX_VERSION" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
